Функция ПолучитьНастройку(ИмяПараметра) Экспорт
	
	Отбор = Новый Структура("Параметр", ИмяПараметра);
	Запись = РегистрыСведений.АЛСАВ_WB_НастройкиОбмена.Получить(Отбор);
	
	Если Запись.Выбрать() Тогда
		Возврат Запись.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьНастройку(ИмяПараметра, Значение) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.АЛСАВ_WB_НастройкиОбмена.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Параметр = ИмяПараметра;
	МенеджерЗаписи.Значение = Строка(Значение);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция ПолучитьСопоставлениеНоменклатуры(Номенклатура, Характеристика = Неопределено) Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", Номенклатура);
	Отбор.Вставить("Характеристика", Характеристика);
	
	Запись = РегистрыСведений.АЛСАВ_WB_СопоставлениеНоменклатуры.Получить(Отбор);
	
	Если Запись.Выбрать() Тогда
		Результат = Новый Структура;
		Результат.Вставить("АртикулWB", Запись.АртикулWB);
		Результат.Вставить("БаркодWB", Запись.БаркодWB);
		Возврат Результат;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаписатьСопоставлениеНоменклатуры(Номенклатура, АртикулWB, БаркодWB = "", Характеристика = Неопределено) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.АЛСАВ_WB_СопоставлениеНоменклатуры.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Характеристика = Характеристика;
	МенеджерЗаписи.АртикулWB = АртикулWB;
	МенеджерЗаписи.БаркодWB = БаркодWB;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура ВыгрузитьОстаткиFBO() Экспорт
	
	АЛСАВ_WB_ВыгрузкаОстатков.ВыполнитьВыгрузку(Перечисления.АЛСАВ_WB_ТипыОстатков.FBO);
	
КонецПроцедуры

Процедура ВыгрузитьОстаткиFBS() Экспорт
	
	АЛСАВ_WB_ВыгрузкаОстатков.ВыполнитьВыгрузку(Перечисления.АЛСАВ_WB_ТипыОстатков.FBS);
	
КонецПроцедуры

Процедура ЗагрузитьЗаказы() Экспорт
	
	АЛСАВ_WB_ЗагрузкаЗаказов.ВыполнитьЗагрузку();
	
КонецПроцедуры
