Функция ВызватьМетодAPI(Метод, Параметры = Неопределено, ТипЗапроса = "GET") Экспорт
	
	Токен = ПолучитьТокен();
	Сервер = ПолучитьСервер();
	
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не задан токен API Wildberries";
	КонецЕсли;
	
	Адрес = Сервер + Метод;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	HTTPСоединение = ПолучитьHTTPСоединение(Сервер);
	
	HTTPЗапрос = Новый HTTPЗапрос(Адрес, Заголовки);
	
	Если ТипЗапроса = "POST" И Параметры <> Неопределено Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(Параметры);
	КонецЕсли;
	
	Попытка
		Если ТипЗапроса = "GET" Тогда
			HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		ИначеЕсли ТипЗапроса = "POST" Тогда
			HTTPОтвет = HTTPСоединение.Отправить(HTTPЗапрос);
		ИначеЕсли ТипЗапроса = "PUT" Тогда
			HTTPОтвет = HTTPСоединение.Записать(HTTPЗапрос);
		ИначеЕсли ТипЗапроса = "DELETE" Тогда
			HTTPОтвет = HTTPСоединение.Удалить(HTTPЗапрос);
		КонецЕсли;
	Исключение
		ВызватьИсключение "Ошибка HTTP-запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", HTTPОтвет.КодСостояния);
	
	ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	Результат.Вставить("ТелоОтвета", ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьHTTPСоединение(Сервер)
	
	Адрес = Новый Структура;
	Адрес.Вставить("Хост", Сервер);
	Адрес.Вставить("Порт", 443);
	Адрес.Вставить("Протокол", "https");
	
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows, Новый СертификатУдостоверяющегоЦентраWindows);
	
	HTTPСоединение = Новый HTTPСоединение(Адрес.Хост, , , , , SSL);
	
	Возврат HTTPСоединение;
	
КонецФункции

Функция ПолучитьТокен()
	
	Возврат АЛСАВ_WB_ОбменДанными.ПолучитьНастройку("Токен");
	
КонецФункции

Функция ПолучитьСервер()
	
	Сервер = АЛСАВ_WB_ОбменДанными.ПолучитьНастройку("СерверAPI");
	Если ПустаяСтрока(Сервер) Тогда
		Сервер = "https://suppliers-api.wildberries.ru";
	КонецЕсли;
	
	Возврат Сервер;
	
КонецФункции
