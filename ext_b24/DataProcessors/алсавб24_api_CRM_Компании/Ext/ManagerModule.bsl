///
// Создает новую компанию
// Параметры:
//  Поля - Структура - поля компании (TITLE, COMPANY_TYPE, INDUSTRY и др.)
// Возвращаемое значение:
//  Структура - результат выполнения с ID созданной компании
//
Функция crm_company_add(Поля) Экспорт
	
	Тело = алсавб24_Json.СтруктураВjson(Поля);
	Ответ = алсавб24_Http.ОтправитьPOSTЗапрос("crm.company.add", Тело);
	
	Результат = алсавб24_Json.JSONВЗначение(Ответ);
	
	Возврат Результат;
	
КонецФункции

///
// Обновляет существующую компанию
// Параметры:
//  ID - Строка/Число - идентификатор компании
//  Поля - Структура - поля для обновления
// Возвращаемое значение:
//  Структура - результат выполнения
//
Функция crm_company_update(ID, Поля) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ID", ID);
	Параметры.Вставить("FIELDS", Поля);
	
	Тело = алсавб24_Json.СтруктураВjson(Параметры);
	Ответ = алсавб24_Http.ОтправитьPOSTЗапрос("crm.company.update", Тело);
	
	Результат = алсавб24_Json.JSONВЗначение(Ответ);
	
	Возврат Результат;
	
КонецФункции

