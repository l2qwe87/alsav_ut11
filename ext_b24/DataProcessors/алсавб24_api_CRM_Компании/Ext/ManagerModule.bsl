///
 // Создает новую компанию
 // Параметры:
 //  Поля - Структура - поля компании (TITLE, COMPANY_TYPE, INDUSTRY и др.)
 // Возвращаемое значение:
 //  Структура - результат выполнения с ID созданной компании
 //
 Функция crm_company_add(Поля) Экспорт

 	Параметры = Новый Структура;
 	Параметры.Вставить("fields", Поля);
 	Параметры.Вставить("params", Новый Структура("REGISTER_SONET_EVENT", "N"));

 	Возврат Обработки.алсавб24_api_CRM_Common.ВызватьAPIМетод("crm.company.add", Параметры);

 КонецФункции

///
 // Обновляет существующую компанию
 // Параметры:
 //  ID - Строка/Число - идентификатор компании
 //  Поля - Структура - поля для обновления
 // Возвращаемое значение:
 //  Структура - результат выполнения
 //
 Функция crm_company_update(ID, Поля) Экспорт

 	Параметры = Новый Структура;
 	Параметры.Вставить("id", ID);
 	Параметры.Вставить("fields", Поля);
 	Параметры.Вставить("params", Новый Структура("REGISTER_SONET_EVENT", "N"));

 	Возврат Обработки.алсавб24_api_CRM_Common.ВызватьAPIМетод("crm.company.update", Параметры);

 КонецФункции

///
// Возвращает компанию по идентификатору
// Параметры:
//  ID - Строка/Число - идентификатор компании
// Возвращаемое значение:
//  Структура - данные компании
//
Функция crm_company_get(ID) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ID", ID);
	
	Возврат Обработки.алсавб24_api_CRM_Common.ВызватьAPIМетод("crm.company.get", Параметры);
	
КонецФункции

///
// Возвращает список компаний по фильтру
// Параметры:
//  Фильтр - Структура - условия фильтрации (необязательно)
//  Выборка - Массив - поля для выборки (необязательно)
//  Порядок - Структура - сортировка (необязательно)
// Возвращаемое значение:
//  Структура - список компаний
//
Функция crm_company_list(Фильтр = Неопределено, Выборка = Неопределено, Порядок = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	
	Если Фильтр <> Неопределено Тогда
		Параметры.Вставить("FILTER", Фильтр);
	КонецЕсли;
	
	Если Выборка <> Неопределено Тогда
		Параметры.Вставить("SELECT", Выборка);
	КонецЕсли;
	
	Если Порядок <> Неопределено Тогда
		Параметры.Вставить("ORDER", Порядок);
	КонецЕсли;
	
	Возврат Обработки.алсавб24_api_CRM_Common.ВызватьAPIМетод("crm.company.list", Параметры);
	
КонецФункции

///
// Удаляет компанию и все связанные с ней объекты
// Параметры:
//  ID - Строка/Число - идентификатор компании
// Возвращаемое значение:
//  Структура - результат выполнения
//
Функция crm_company_delete(ID) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ID", ID);
	
	Тело = алсавб24_Json.СтруктураВjson(Параметры);
	Ответ = алсавб24_Http.ОтправитьPOSTЗапрос("crm.company.delete", Тело);
	
	Результат = алсавб24_Json.JSONВЗначение(Ответ);
	
	Возврат Результат;
	
КонецФункции

