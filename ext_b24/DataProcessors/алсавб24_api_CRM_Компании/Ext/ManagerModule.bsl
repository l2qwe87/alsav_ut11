///
// Возвращает список компаний по фильтру
// Параметры:
//  Фильтр - Структура - условия фильтрации (необязательно)
//  Выборка - Массив - поля для выборки (необязательно)
//  Порядок - Структура - сортировка (необязательно)
// Возвращаемое значение:
//  Структура - список компаний
//
Функция crm_company_list(Фильтр = Неопределено, Выборка = Неопределено, Порядок = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	
	Если Фильтр <> Неопределено Тогда
		Параметры.Вставить("FILTER", Фильтр);
	КонецЕсли;
	
	Если Выборка <> Неопределено Тогда
		Параметры.Вставить("SELECT", Выборка);
	КонецЕсли;
	
	Если Порядок <> Неопределено Тогда
		Параметры.Вставить("ORDER", Порядок);
	КонецЕсли;
	
	Тело = алсавб24_Json.СтруктураВjson(Параметры);
	Ответ = алсавб24_Http.ОтправитьPOSTЗапрос("crm.company.list", Тело);
	
	Результат = алсавб24_Json.JSONВЗначение(Ответ);
	
	Возврат Результат;
	
КонецФункции

