Функция crm_address_fields() Экспорт

	Возврат ВызватьAPIМетод("crm.address.fields", Новый Структура);

КонецФункции

/// Получить список адресов по сущности
/// Параметры:
///  ENTITY_ID - Число - ID сущности в Б24
///  ENTITY_TYPE_ID - Число - тип сущности (по умолчанию ENTITY_TYPE_ID_Компания)
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция crm_address_list_by_entity(ENTITY_ID, ENTITY_TYPE_ID = Неопределено) Экспорт

	Если ENTITY_TYPE_ID = Неопределено Тогда
		ENTITY_TYPE_ID = ENTITY_TYPE_ID_Компания();
	КонецЕсли;

	Фильтр = Новый Структура;
	Фильтр.Вставить("ENTITY_ID", ENTITY_ID);
	Фильтр.Вставить("ENTITY_TYPE_ID", ENTITY_TYPE_ID);

	Возврат crm_address_list(Фильтр);

КонецФункции

