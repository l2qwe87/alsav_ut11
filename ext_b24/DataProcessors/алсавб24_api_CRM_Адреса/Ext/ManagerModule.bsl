/// Получить список адресов
/// Параметры:
///  Фильтр - Структура - условия фильтрации (необязательно)
///  Выборка - Массив - поля для выборки (необязательно)
///  Порядок - Структура - сортировка (необязательно)
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция crm_address_list(Фильтр = Неопределено, Выборка = Неопределено, Порядок = Неопределено) Экспорт

	Параметры = Новый Структура;

	Если Фильтр <> Неопределено Тогда
		Параметры.Вставить("filter", Фильтр);
	КонецЕсли;

	Если Выборка <> Неопределено Тогда
		Параметры.Вставить("select", Выборка);
	КонецЕсли;

	Если Порядок <> Неопределено Тогда
		Параметры.Вставить("order", Порядок);
	КонецЕсли;

	Возврат ВызватьAPIМетод("crm.address.list", Параметры);

КонецФункции

/// Получить адрес по ID
