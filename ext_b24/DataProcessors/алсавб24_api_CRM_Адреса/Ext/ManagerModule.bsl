// ENTITY_TYPE_ID для различных типов сущностей Битрикс24
Функция ENTITY_TYPE_ID_Компания() Экспорт
	Возврат 4;
КонецФункции

/// Добавить адрес к сущности
/// Параметры:
///  Поля - Структура - поля адреса
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция crm_address_add(Поля) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("fields", Поля);

	Возврат ВызватьAPIМетод("crm.address.add", Параметры);

КонецФункции

/// Обновить адрес
