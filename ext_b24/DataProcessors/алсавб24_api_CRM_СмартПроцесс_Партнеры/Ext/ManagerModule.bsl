// Константы
Перем EntityTypeIdПартнеры Экспорт;

// Создать Смарт-процесс "Партнер"
//
// Параметры:
//  Параметры - Структура - параметры для создания партнера:
//    * Наименование - Строка - наименование партнера (обязательно)
//    * Описание - Строка - описание партнера (необязательно)
//    * Ответственный - Число - ID ответственного пользователя (необязательно)
//
// Возвращаемое значение:
//  Структура - результат создания, содержит ID созданного партнера
EntityTypeIdПартнеры = 1050;

Функция СоздатьПартнера(Знач Параметры) Экспорт
	
	// Формируем тело запроса для создания смарт-процесса
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("entityTypeId", EntityTypeIdПартнеры);
	
	Поля = Новый Структура;
	
	// Обязательные поля
	Если Параметры.Свойство("Наименование") И ПустаяСтрока(Параметры.Наименование) = Ложь Тогда
		Поля.Вставить("title", Параметры.Наименование);
	Иначе
		ВызватьИсключение "Не указано наименование партнера";
	КонецЕсли;
	
	// Опциональные поля
	Если Параметры.Свойство("Описание") И ПустаяСтрока(Параметры.Описание) = Ложь Тогда
		Поля.Вставить("description", Параметры.Описание);
	КонецЕсли;
	
	Если Параметры.Свойство("Ответственный") И Параметры.Ответственный <> Неопределено Тогда
		Поля.Вставить("assignedById", Параметры.Ответственный);
	КонецЕсли;
	
	ТелоЗапроса.Вставить("fields", Поля);
	
	// Преобразуем в JSON
	JSONСтрока = алсавб24_Json.СтруктураВjson(ТелоЗапроса);
	
	// Отправляем запрос
	РезультатОтвета = алсавб24_Http.ОтправитьPOSTЗапрос("crm.item.add", JSONСтрока);
	
	// Парсим ответ
	Результат = алсавб24_Json.JSONВЗначение(РезультатОтвета);
	
	// Проверяем результат
	Если Результат.Свойство("error") Тогда
		ВызватьИсключение "Ошибка при создании партнера: " + Результат.error_description;
	КонецЕсли;
	
	Возврат Результат.result;
	
КонецФункции



// Обновить Смарт-Процесс "Партнер"
//
// Параметры:
//  ID - Число - ID партнера в Б24
//  Параметры - Структура - параметры для обновления партнера:
//    * Наименование - Строка - наименование партнера (необязательно)
//    * Описание - Строка - описание партнера (необязательно)
//    * Ответственный - Число - ID ответственного пользователя (необязательно)
//
// Возвращаемое значение:
//  Структура - результат обновления
Функция ОбновитьПартнера(Знач ID, Знач Параметры) Экспорт
	
	// Формируем тело запроса для обновления смарт-процесса
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("entityTypeId", EntityTypeIdПартнеры);
	ТелоЗапроса.Вставить("id", ID);
	
	Поля = Новый Структура;
	
	// Опциональные поля
	Если Параметры.Свойство("Наименование") И ПустаяСтрока(Параметры.Наименование) = Ложь Тогда
		Поля.Вставить("title", Параметры.Наименование);
	КонецЕсли;
	
	Если Параметры.Свойство("Описание") И ПустаяСтрока(Параметры.Описание) = Ложь Тогда
		Поля.Вставить("description", Параметры.Описание);
	КонецЕсли;
	
	Если Параметры.Свойство("Ответственный") И Параметры.Ответственный <> Неопределено Тогда
		Поля.Вставить("assignedById", Параметры.Ответственный);
	КонецЕсли;
	
	ТелоЗапроса.Вставить("fields", Поля);
	
	// Преобразуем в JSON
	JSONСтрока = алсавб24_Json.СтруктураВjson(ТелоЗапроса);
	
	// Отправляем запрос
	РезультатОтвета = алсавб24_Http.ОтправитьPOSTЗапрос("crm.item.update", JSONСтрока);
	
	// Парсим ответ
	Результат = алсавб24_Json.JSONВЗначение(РезультатОтвета);
	
	// Проверяем результат
	Если Результат.Свойство("error") Тогда
		ВызватьИсключение "Ошибка при обновлении партнера: " + Результат.error_description;
	КонецЕсли;
	
	Возврат Результат.result;
	
КонецФункции



// Связать Смарт-Процесс "Партнер" с "Компаниями"(Контрагенты)
//
// Параметры:
//  IDПартнера - Число - ID партнера в Б24
//  IDКомпании - Число - ID компании в Б24
//
// Возвращаемое значение:
//  Структура - результат создания связи
Функция СвязатьПартнераСКонтрагентом(Знач IDПартнера, Знач IDКомпании) Экспорт
	
	// Формируем тело запроса для создания связи
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("entityTypeId", EntityTypeIdПартнеры);
	ТелоЗапроса.Вставить("id", IDПартнера);
	
	Связи = Новый Массив;
	Связь = Новый Структура;
	Связь.Вставить("entityTypeId", 4); // entityTypeId=4 для Компаний
	Связь.Вставить("id", IDКомпании);
	Связи.Добавить(Связь);
	
	ТелоЗапроса.Вставить("parents", Связи);
	
	// Преобразуем в JSON
	JSONСтрока = алсавб24_Json.СтруктураВjson(ТелоЗапроса);
	
	// Отправляем запрос
	РезультатОтвета = алсавб24_Http.ОтправитьPOSTЗапрос("crm.item.update", JSONСтрока);
	
	// Парсим ответ
	Результат = алсавб24_Json.JSONВЗначение(РезультатОтвета);
	
	// Проверяем результат
	Если Результат.Свойство("error") Тогда
		ВызватьИсключение "Ошибка при создании связи: " + Результат.error_description;
	КонецЕсли;
	
	Возврат Результат.result;
	
КонецФункции 



// Получить Связанные со Смарт-Процессом "Партнер" "Компании"(Контрагенты)
//
// Параметры:
//  IDПартнера - Число - ID партнера в Б24
//
// Возвращаемое значение:
//  Массив - массив структур с информацией о связанных компаниях
Функция ПолучитьСвязанныеКонтрагентыПартнера(Знач IDПартнера) Экспорт
	
	// Формируем параметры запроса
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("entityTypeId", EntityTypeIdПартнеры);
	ПараметрыЗапроса.Вставить("id", IDПартнера);
	
	// Преобразуем в JSON
	JSONСтрока = алсавб24_Json.СтруктураВjson(ПараметрыЗапроса);
	
	// Отправляем запрос для получения деталей партнера
	РезультатОтвета = алсавб24_Http.ОтправитьPOSTЗапрос("crm.item.get", JSONСтрока);
	
	// Парсим ответ
	Результат = алсавб24_Json.JSONВЗначение(РезультатОтвета);
	
	// Проверяем результат
	Если Результат.Свойство("error") Тогда
		ВызватьИсключение "Ошибка при получении партнера: " + Результат.error_description;
	КонецЕсли;
	
	// Получаем связанные компании
	СвязанныеКомпании = Новый Массив;
	ДеталиПартнера = Результат.result.item;
	
	Если ДеталиПартнера.Свойство("parents") Тогда
		Для Каждого Родитель Из ДеталиПартнера.parents Цикл
			Если Родитель.entityTypeId = 4 Тогда // entityTypeId=4 для Компаний
				СвязанныеКомпании.Добавить(Родитель);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СвязанныеКомпании;
	
КонецФункции
