///************
// Выгрузка универсальных реквизитов (crm.requisite)
//
///************

///
/// // Создать универсальные реквизиты для контрагента
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - ссылка на контрагента
//  IDКомпанииБ24 - Число - ID компании в Б24
//
Процедура СоздатьУниверсальныеРеквизиты(Контрагент, IDКомпанииБ24) Экспорт

	// Подготавливаем реквизиты в зависимости от типа лица
	Если Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		ПоляРеквизитов = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ПодготовитьРеквизитыЮрЛица(Контрагент, IDКомпанииБ24);
	Иначе
		ПоляРеквизитов = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ПодготовитьРеквизитыФизЛица(Контрагент, IDКомпанииБ24);
	КонецЕсли;

	// Создаем универсальные реквизиты
	APIРезультат = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.crm_requisite_add(ПоляРеквизитов);

	Если APIРезультат.Свойство("result") Тогда
		IDРеквизитов = APIРезультат.result;

		// Регистрируем сопоставление для универсальных реквизитов
		Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ЗарегистрироватьСопоставлениеУниверсальныхРеквизитов(
			IDРеквизитов, Контрагент, "Универсальные реквизиты: " + Контрагент.Наименование);
	КонецЕсли;

КонецПроцедуры

///
/// // Обновить универсальные реквизиты для контрагента
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - ссылка на контрагента
//  IDКомпанииБ24 - Число - ID компании в Б24
//
Процедура ОбновитьУниверсальныеРеквизиты(Контрагент, IDКомпанииБ24) Экспорт

	// Ищем существующие реквизиты
	APIРезультат = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.crm_requisite_list_by_company(
		IDКомпанииБ24, Обработки.алсавб24_api_CRM_Common.ENTITY_TYPE_ID_Компания());

	Если APIРезультат.Свойство("result") И APIРезультат.result.Количество() > 0 Тогда
		// Обновляем первые найденные реквизиты
		СуществующиеРеквизиты = APIРезультат.result[0];
		IDРеквизитов = СуществующиеРеквизиты.Получить("ID");

		// Подготавливаем поля для обновления
		Если Контрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
			ПоляРеквизитов = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ПодготовитьРеквизитыЮрЛица(Контрагент, IDКомпанииБ24);
		Иначе
			ПоляРеквизитов = Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ПодготовитьРеквизитыФизЛица(Контрагент, IDКомпанииБ24);
		КонецЕсли;

		// Обновляем реквизиты
		Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.crm_requisite_update(IDРеквизитов, ПоляРеквизитов);

		// Обновляем сопоставление
		Обработки.алсавб24_api_CRM_УниверсальныеРеквизиты.ЗарегистрироватьСопоставлениеУниверсальныхРеквизитов(
			IDРеквизитов, Контрагент, "Универсальные реквизиты: " + Контрагент.Наименование);
	Иначе
		// Если реквизиты не найдены, создаем новые
		СоздатьУниверсальныеРеквизиты(Контрагент, IDКомпанииБ24);
	КонецЕсли;

КонецПроцедуры