//
// ОБЩИЕ ФУНКЦИИ РАБОТЫ С API
//

/// Вызвать метод API Битрикс24
/// Параметры:
///  Метод - Строка - имя метода API
///  Параметры - Структура - параметры вызова
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция ВызватьAPIМетод(Метод, Параметры) Экспорт
	
	// Преобразуем параметры в JSON
	ТелоЗапроса = Обработки.алсавб24_Json.ЗначениеВJSON(Параметры);
	
	// Отправляем POST запрос
	Ответ = Обработки.алсавб24_Http.ОтправитьPOSTЗапрос(Метод, ТелоЗапроса);
	
	// Преобразуем ответ из JSON в структуру
	Результат = Обработки.алсавб24_Json.JSONВЗначение(Ответ);
	
	Возврат Результат;
	
КонецФункции

//

/// Получить навигационную ссылку на объект 1С
/// Параметры:
///  Объект - ЛюбаяСсылка - ссылка на объект 1С
/// Возвращаемое значение:
///  Строка - навигационная ссылка
///


/// Подготовить стандартные поля для идентификации источника
/// Параметры:
///  Объект1С - ЛюбаяСсылка - ссылка на объект 1С
/// Возвращаемое значение:
///  Структура - поля ORIGIN_ID, ORIGINATOR_ID, ORIGIN_VERSION
///
Функция ПодготовитьПоляИсточника(Объект1С) Экспорт
	
	Поля = Новый Структура;
	Поля.Вставить("ORIGIN_ID", Строка(Объект1С.УникальныйИдентификатор()));
	Поля.Вставить("ORIGINATOR_ID", "1С8 УТ11");
	Поля.Вставить("ORIGIN_VERSION", ПолучитьНавигационнуюСсылку(Объект1С));
	
	Возврат Поля;
	
КонецФункции

/// Определить ENTITY_TYPE_ID по типу объекта 1С
/// Параметры:
///  Объект1С - ЛюбаяСсылка - ссылка на объект 1С
/// Возвращаемое значение:
///  Число - ENTITY_TYPE_ID для Б24 или 0 если не определено
///
Функция ОпределитьEntityTypeID(Объект1С) Экспорт
	
	ТипОбъекта = ТипЗнч(Объект1С);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат ENTITY_TYPE_ID_Компания();
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Партнеры") Тогда
		// Партнеры выгружаются в смарт-процессы, у них свой ENTITY_TYPE_ID
		Возврат 0; // Будет определяться отдельно для смарт-процессов
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.КонтактныеЛица") Тогда
		Возврат ENTITY_TYPE_ID_Контакт();
	Иначе
		Возврат 0;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции