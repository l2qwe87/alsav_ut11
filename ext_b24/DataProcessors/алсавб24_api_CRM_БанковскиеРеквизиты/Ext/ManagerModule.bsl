/// Получить список банковских реквизитов по сущности
/// Параметры:
///  ENTITY_ID - Число - ID сущности в Б24
///  ENTITY_TYPE_ID - Число - тип сущности (по умолчанию ENTITY_TYPE_ID_УниверсальныеРеквизиты)
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция crm_requisite_bankdetail_list_by_entity(ENTITY_ID, ENTITY_TYPE_ID = Неопределено) Экспорт

	Если ENTITY_TYPE_ID = Неопределено Тогда
		ENTITY_TYPE_ID = Обработки.алсавб24_api_CRM_Common.ENTITY_TYPE_ID_УниверсальныеРеквизиты();
	КонецЕсли;

	Фильтр = Новый Структура;
	Фильтр.Вставить("ENTITY_ID", ENTITY_ID);
	Фильтр.Вставить("ENTITY_TYPE_ID", ENTITY_TYPE_ID);

	Возврат crm_requisite_bankdetail_list(Фильтр);

КонецФункции

