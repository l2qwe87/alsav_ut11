/// Получить список универсальных реквизитов
/// Параметры:
///  Фильтр - Структура - параметры фильтрации (необязательно)
///  Выборка - Массив - поля для выборки (необязательно)
/// Возвращаемое значение:
///  Структура - результат API вызова
///
Функция crm_requisite_universal_list(Фильтр = Неопределено, Выборка = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	
	Если Фильтр <> Неопределено Тогда
		Параметры.Вставить("filter", Фильтр);
	КонецЕсли;
	
	Если Выборка <> Неопределено Тогда
		Параметры.Вставить("select", Выборка);
	КонецЕсли;
	
	Возврат ВызватьAPIМетод("crm.requisite.universal.list", Параметры);
	
КонецФункции

