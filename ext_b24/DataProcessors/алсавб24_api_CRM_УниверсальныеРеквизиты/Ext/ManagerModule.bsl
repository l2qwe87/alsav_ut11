КонецФункции

/// Подготовить реквизиты для юридического лица
/// Параметры:
///  Контрагент - СправочникСсылка.Контрагенты - контрагент
///  ENTITY_ID - Число - ID сущности в Б24
/// Возвращаемое значение:
///  Структура - поля для создания универсального реквизита
///
Функция ПодготовитьРеквизитыЮрЛица(Контрагент, ENTITY_ID) Экспорт
	
	Поля = Новый Структура;
	
	// Основные поля
	Поля.Вставить("ENTITY_ID", ENTITY_ID);
	Поля.Вставить("ENTITY_TYPE_ID", Обработки.алсавб24_api_CRM_Common.ENTITY_TYPE_ID_Компания());
	Поля.Вставить("NAME", Контрагент.Наименование);
	
	// Юридические реквизиты
	Если ЗначениеЗаполнено(Контрагент.ИНН) Тогда
		Поля.Вставить("RQ_INN", Контрагент.ИНН);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент.КПП) Тогда
		Поля.Вставить("RQ_KPP", Контрагент.КПП);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент.НаименованиеПолное) Тогда
		Поля.Вставить("RQ_COMPANY_NAME", Контрагент.НаименованиеПолное);
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

/// Подготовить реквизиты для физического лица
/// Параметры:
///  Контрагент - СправочникСсылка.Контрагенты - контрагент
///  ENTITY_ID - Число - ID сущности в Б24
/// Возвращаемое значение:
///  Структура - поля для создания универсального реквизита
///
Функция ПодготовитьРеквизитыФизЛица(Контрагент, ENTITY_ID) Экспорт
	
	Поля = Новый Структура;
	
	// Основные поля
	Поля.Вставить("ENTITY_ID", ENTITY_ID);
	Поля.Вставить("ENTITY_TYPE_ID", Обработки.алсавб24_api_CRM_Common.ENTITY_TYPE_ID_Компания());
	Поля.Вставить("NAME", Контрагент.Наименование);
	
	// Реквизиты физического лица
	Если ЗначениеЗаполнено(Контрагент.ИНН) Тогда
		Поля.Вставить("RQ_INN", Контрагент.ИНН);
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции