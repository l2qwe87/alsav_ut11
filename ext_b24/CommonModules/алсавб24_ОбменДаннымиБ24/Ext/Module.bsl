
Функция ПолучитьУзелОбменаБ24()
	Возврат ПланыОбмена.алсавб24_ПланОбменаБ24CRM.НайтиПоКоду("Б24_01");
КонецФункции

Процедура ВыполнитьОбменДанными() Экспорт 
	
	УзелОбмена = ПолучитьУзелОбменаБ24();
	Если УзелОбмена.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// Контроль выгруженных контрагентов для исключения повторных попыток
	ВыгруженныеКонтрагенты = Новый Соответствие;
	
	// Получить все изменения для выгрузки
	Изменения = ПланыОбмена.ВыбратьИзменения(УзелОбмена, УзелОбмена.НомерОтправленного);
	
	Пока Изменения.Следующий() Цикл
		
		ОбъектИзменения = Изменения.Получить();
		СсылкиНаКонтрагентов = НайтиКонтрагентовПоИзменению(ОбъектИзменения);
		ИзменениеОбработано = Ложь;
		ИзменениеПропущено = Ложь;
		
		// Если нет контрагентов для обработки, считаем изменение обработанным
		Если СсылкиНаКонтрагентов.Количество() = 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ОбъектИзменения);
			Продолжить;
		КонецЕсли;
		
		Для Каждого СсылкаНаКонтрагента Из СсылкиНаКонтрагентов Цикл
			
			// Проверяем, что контрагент еще не был выгружен в текущей сессии
			Если ВыгруженныеКонтрагенты.Получить(СсылкаНаКонтрагента) <> Неопределено Тогда
				ИзменениеПропущено = Истина;
				Продолжить; // Пропускаем, если уже была попытка выгрузки
			КонецЕсли;
			
			// Отмечаем контрагента как обработанного (даже если выгрузка не удалась)
			ВыгруженныеКонтрагенты.Вставить(СсылкаНаКонтрагента, Истина);
			
			// Проверяем наличие действующих соглашений у контрагента
			Если ЕстьДействующиеСоглашения(СсылкаНаКонтрагента.Партнер) Тогда
				
				// Выгружаем контрагента в Б24
				РезультатВыгрузки = Обработки.алсавб24_ВыгрузкаКонтрагентов.ВыгрузитьВБ24(СсылкаНаКонтрагента);
				
				Если РезультатВыгрузки.Успех Тогда
					ИзменениеОбработано = Истина;
				КонецЕсли;
				
			Иначе
				// Нет действующих соглашений - считаем изменение успешно обработанным
				ИзменениеОбработано = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		// Удаляем изменение из регистрации, если оно успешно обработано или пропущено
		Если ИзменениеОбработано Или ИзменениеПропущено Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ОбъектИзменения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

///
// Найти контрагентов по изменению в плане обмена
// Параметры:
//  Изменение - ВыборкаИзмененийПланаОбмена - изменение из плана обмена
// Возвращаемое значение:
//  Массив - массив ссылок на контрагентов
//
Функция НайтиКонтрагентовПоИзменению(Изменение) Экспорт
	
	СсылкиНаКонтрагентов = Новый Массив;
	
	// Если изменен сам контрагент
	Если ТипЗнч(Изменение) = Тип("СправочникОбъект.Контрагенты") Тогда
		Объект = Изменение;
		СсылкиНаКонтрагентов.Добавить(Объект.Ссылка);
		
	ИначеЕсли ТипЗнч(Изменение) = Тип("СправочникОбъект.Партнеры") Тогда
		// Если изменен партнер, ищем связанных контрагентов
		Объект = Изменение;
		СсылкиНаКонтрагентов = НайтиКонтрагентовПартнера(Объект.Ссылка);
		
	ИначеЕсли ТипЗнч(Изменение) = Тип("СправочникОбъект.СоглашенияСКлиентами") Тогда
		// Если изменено соглашение, берем контрагента из соглашения
		Объект = Изменение;
		// Типовые соглашения не обрабатываем
		Если Объект.Типовое Тогда
			Возврат Новый Массив; // Возвращаем пустой массив
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
			СсылкиНаКонтрагентов.Добавить(Объект.Контрагент);
		ИначеЕсли ЗначениеЗаполнено(Объект.Партнер) Тогда
			// Если контрагент не указан, ищем всех контрагентов партнера
			СсылкиНаКонтрагентов = НайтиКонтрагентовПартнера(Объект.Партнер);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Изменение) = Тип("СправочникОбъект.БанковскиеСчетаКонтрагентов") Тогда
		// Если изменен банковский счет, ищем владельца-контрагента
		Объект = Изменение;
		Если ЗначениеЗаполнено(Объект.Владелец) Тогда
			СсылкиНаКонтрагентов.Добавить(Объект.Владелец);
		КонецЕсли;
	Иначе
		// Другие типы изменений не обрабатываем
	КонецЕсли;
	
	Возврат СсылкиНаКонтрагентов;
	
КонецФункции

///
// Найти контрагентов связанных с партнером
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - ссылка на партнера
// Возвращаемое значение:
//  Массив - массив ссылок на контрагентов партнера
//
Функция НайтиКонтрагентовПартнера(Партнер) Экспорт
	
	СсылкиНаКонтрагентов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Партнер = &Партнер
		|	И Контрагенты.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СсылкиНаКонтрагентов.Добавить(Выборка.Контрагент);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СсылкиНаКонтрагентов;
	
КонецФункции

///
// Проверить наличие действующих соглашений у контрагента
// Параметры:
//  Партнер - СправочникСсылка.Партнеры - ссылка на партнера
// Возвращаемое значение:
//  Булево - Истина если есть действующие соглашения
//
Функция ЕстьДействующиеСоглашения(Партнер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоглашенияСКлиентами.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
		|ГДЕ
		|	СоглашенияСКлиентами.Партнер = &Партнер
		|	И СоглашенияСКлиентами.Статус = &Статус
		|	И СоглашенияСКлиентами.ПометкаУдаления = ЛОЖЬ
		|	И СоглашенияСКлиентами.Типовое = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыСоглашенийСКлиентами.Действует);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции