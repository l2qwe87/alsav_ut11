&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрыВыполненияКоманды.Источник.Количество() = 0 Тогда
		Сообщить("Не выбран партнер для выгрузки");
		Возврат;
	КонецЕсли;
	
	Партнер = ПараметрыВыполненияКоманды.Источник[0];
	
	// Выполняем выгрузку на сервере
	РезультатВыгрузки = ВыгрузитьПартнераВБ24НаСервере(Партнер);
	
	// Показываем результат в текстовом документе
	ПоказатьРезультатВыгрузки(РезультатВыгрузки, Партнер);
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьПартнераВБ24НаСервере(Партнер)
	
	// Вызываем функцию выгрузки напрямую из модуля менеджера обработки
	Результат = Обработки.алсавб24_ВыгрузкаПартнеров.ВыгрузитьВБ24(Партнер);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатВыгрузки(Результат, Партнер)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	
	// Формируем заголовок
	ТекстовыйДокумент.ДобавитьСтроку("Результат выгрузки партнера в Битрикс24");
	ТекстовыйДокумент.ДобавитьСтроку("");
	ТекстовыйДокумент.ДобавитьСтроку("Партнер: " + Партнер.Наименование);
	ТекстовыйДокумент.ДобавитьСтроку("Ссылка: " + Строка(Партнер));
	ТекстовыйДокумент.ДобавитьСтроку("");
	
	// Формируем результат
	Если Результат.Успех Тогда
		ТекстовыйДокумент.ДобавитьСтроку("Статус: Успешно");
		ТекстовыйДокумент.ДобавитьСтроку("ID компании в Б24: " + Результат.ID);
		ТекстовыйДокумент.ДобавитьСтроку("Сообщение: " + Результат.Сообщение);
	Иначе
		ТекстовыйДокумент.ДобавитьСтроку("Статус: Ошибка");
		ТекстовыйДокумент.ДобавитьСтроку("Сообщение: " + Результат.Сообщение);
	КонецЕсли;
	
	ТекстовыйДокумент.ДобавитьСтроку("");
	ТекстовыйДокумент.ДобавитьСтроку("Дата и время: " + ТекущаяДата());
	
	// Показываем текстовый документ
	ИмяФайла = "РезультатВыгрузкиПартнераВБ24_" + СтрЗаменить(Строка(ТекущаяДата()), ":", "_") + ".txt";
	
	ПараметрыОткрытия = Новый Структура("ИмяФайла", ИмяФайла);
	ОткрытьЗначение(ТекстовыйДокумент);
	
КонецПроцедуры
