&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрыВыполненияКоманды.Источник.Количество() = 0 Тогда
		Сообщить("Не выбран контрагент для выгрузки");
		Возврат;
	КонецЕсли;
	
	Контрагент = ПараметрыВыполненияКоманды.Источник[0];
	
	// Выполняем выгрузку на сервере
	РезультатВыгрузки = ВыгрузитьКонтрагентаВБ24НаСервере(Контрагент);
	
	// Показываем результат в текстовом документе
	ПоказатьРезультатВыгрузки(РезультатВыгрузки, Контрагент);
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьКонтрагентаВБ24НаСервере(Контрагент)
	
	// Вызываем функцию выгрузки напрямую из модуля менеджера обработки
	Результат = Обработки.алсавб24_ВыгрузкаКонтрагентов.ВыгрузитьВБ24(Контрагент);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатВыгрузки(Результат, Контрагент)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	
	// Формируем заголовок
	ТекстовыйДокумент.ДобавитьСтроку("Результат выгрузки контрагента в Битрикс24");
	ТекстовыйДокумент.ДобавитьСтроку("");
	ТекстовыйДокумент.ДобавитьСтроку("Контрагент: " + Контрагент.Наименование);
	ТекстовыйДокумент.ДобавитьСтроку("Ссылка: " + Строка(Контрагент));
	ТекстовыйДокумент.ДобавитьСтроку("");
	
	// Формируем результат
	Если Результат.Успех Тогда
		ТекстовыйДокумент.ДобавитьСтроку("Статус: Успешно");
		ТекстовыйДокумент.ДобавитьСтроку("ID компании в Б24: " + Результат.ID);
		ТекстовыйДокумент.ДобавитьСтроку("Сообщение: " + Результат.Сообщение);
	Иначе
		ТекстовыйДокумент.ДобавитьСтроку("Статус: Ошибка");
		ТекстовыйДокумент.ДобавитьСтроку("Сообщение: " + Результат.Сообщение);
	КонецЕсли;
	
	ТекстовыйДокумент.ДобавитьСтроку("");
	ТекстовыйДокумент.ДобавитьСтроку("Дата и время: " + ТекущаяДата());
	
	// Показываем текстовый документ
	ИмяФайла = "РезультатВыгрузкиКонтрагентаВБ24_" + СтрЗаменить(Строка(ТекущаяДата()), ":", "_") + ".txt";
	
	ПараметрыОткрытия = Новый Структура("ИмяФайла", ИмяФайла); 
	ОткрытьЗначение(ТекстовыйДокумент);
	
КонецПроцедуры
