pipeline {
    agent any

    environment {
        IMAGE_NAME = 'nginx-proxy-alsav'
        CONTAINER_NAME = 'nginx-proxy'
        PORT = '80'
    }

    stages {
        stage('1. Prepare Files & Build Image') {
            steps {
                script {
                    // 1. Генерируем файл конфигурации Nginx
                    writeFile file: 'default.conf', text: '''
server {
    listen 80 default_server;
    server_name 93.123.178.106;

    location ^~ /clientApi/ {
        proxy_pass http://192.168.0.2:5080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
'''
                    // 2. Генерируем Dockerfile (если его нет в репозитории)
                    writeFile file: 'Dockerfile', text: '''
FROM nginx:alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY default.conf /etc/nginx/conf.d/default.conf
RUN nginx -t
EXPOSE 80
'''

                    // 3. Собираем Docker-образ
                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('2. Run Docker Container') {
            steps {
                script {
                    sh "docker stop ${CONTAINER_NAME} || true"
                    sh "docker rm ${CONTAINER_NAME} || true"

                    sh """
                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p ${PORT}:80 \
                        ${IMAGE_NAME}:latest
                    """
                }
            }
        }
    }

    post {
        always {
            // Встроенная команда Jenkins для очистки рабочей директории (не требует плагинов)
            deleteDir()
            sh 'docker image prune -f'
        }
    }
}
