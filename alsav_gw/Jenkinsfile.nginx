pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'REISSUE_SSL',
            defaultValue: false,
            description: 'Принудительно перевыпустить SSL-сертификат (перезапишет существующий)'
        )
    }

    environment {
        IMAGE_NAME     = 'nginx-proxy-alsav'
        CONTAINER_NAME = 'nginx-proxy'
        SERVER_IP      = '93.123.178.106'
        SSL_VOLUME     = 'nginx_ssl_data'
        CERT_ORG       = 'ALSAV'
        CERT_OU        = 'IT Infrastructure'
    }

    stages {
        stage('1. Ensure Volume & SSL Certificate') {
            steps {
                script {
                    sh """
                        # 1. Проверяем существование Docker Volume и создаем при необходимости
                        if ! docker volume inspect ${SSL_VOLUME} >/dev/null 2>&1; then
                            echo "Том ${SSL_VOLUME} не найден. Создаем новый..."
                            docker volume create ${SSL_VOLUME}
                        else
                            echo "Том ${SSL_VOLUME} уже существует."
                        fi

                        # 2. Генерируем сертификат (при необходимости) и выводим его отпечаток
                        docker run --rm \
                            -e REISSUE="${params.REISSUE_SSL}" \
                            -e IP="${SERVER_IP}" \
                            -e ORG="${CERT_ORG}" \
                            -e OU="${CERT_OU}" \
                            -v ${SSL_VOLUME}:/ssl --entrypoint sh alpine/openssl -c '
                            if [ "\$REISSUE" = "true" ] || [ ! -f /ssl/nginx.crt ] || [ ! -f /ssl/nginx.key ]; then
                                echo "Выпускаем новый SSL-сертификат на 10 лет для IP \$IP (REISSUE=\$REISSUE)..."
                                openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
                                    -keyout /ssl/nginx.key \
                                    -out /ssl/nginx.crt \
                                    -subj "/O=\$ORG/OU=\$OU/CN=\$IP" \
                                    -addext "subjectAltName=IP:\$IP"
                            else
                                echo "Используем ранее созданный SSL-сертификат из тома."
                            fi

                            echo "================ ИНФОРМАЦИЯ О СЕРТИФИКАТЕ ================"
                            openssl x509 -in /ssl/nginx.crt -noout -subject -dates -fingerprint -sha256
                            echo "=========================================================="
                        '
                    """
                }
            }
        }

        stage('2. Prepare Config & Build Image') {
            steps {
                script {
                    writeFile file: 'default.conf', text: """
server {
    listen 80 default_server;
    server_name ${SERVER_IP};
    return 301 https://${SERVER_IP}\$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name ${SERVER_IP};

    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    location ^~ /clientApi/ {
        proxy_pass http://192.168.0.2:5080;

        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
"""
                    writeFile file: 'Dockerfile', text: '''
FROM nginx:alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
'''

                    sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('3. Recreate Nginx Container') {
            steps {
                script {
                    sh "docker stop ${CONTAINER_NAME} || true"
                    sh "docker rm ${CONTAINER_NAME} || true"

                    sh """
                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p 80:80 \
                        -p 443:443 \
                        -v ${SSL_VOLUME}:/etc/nginx/ssl:ro \
                        ${IMAGE_NAME}:latest

                        sleep 2
                        docker ps --filter name=${CONTAINER_NAME}
                        docker logs --tail 15 ${CONTAINER_NAME}
                    """
                }
            }
        }
    }

    post {
        always {
            deleteDir()
            sh """
                docker image prune -f
                docker images ${IMAGE_NAME} --format '{{.Tag}}' | grep -E '^[0-9]+' | sort -rn | tail -n +4 | xargs -r -I {} docker rmi ${IMAGE_NAME}:{} || true
            """
        }
    }
}
