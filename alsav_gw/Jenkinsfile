pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REPO_URL       = 'https://github.com/l2qwe87/alsav_ut11.git'
        BRANCH         = 'main'
        APP_DIR        = 'alsav_gw'
        IMAGE_NAME     = 'alsav-gw'
        CONTAINER_NAME = 'alsav-api-gateway'
        HOST_PORT      = '5000'
        DOCKER_NETWORK = 'alsav_net'
        ONEC_URL       = 'http://1c-server:8000/ut11'   // ← ut11 = имя публикации вашей базы
    }

    stages {

        stage('Clone') {
            steps {
                git branch: "${BRANCH}", url: "${REPO_URL}"
            }
        }

        stage('Build image') {
            steps {
                dir("${APP_DIR}") {
                    sh 'docker build -f src/Alsav.ApiGateway/Dockerfile -t ${IMAGE_NAME}:${BUILD_NUMBER} -t ${IMAGE_NAME}:latest .'
                }
            }
        }

        stage('Recreate container') {
            steps {
                withCredentials([
                    string(credentialsId: 'alsav-internal-api-secret', variable: 'INTERNAL_SECRET'),
                    string(credentialsId: 'alsav-onec-internal-secret',  variable: 'ONEC_SECRET')
                ]) {
                    sh '''
                        docker rm -f ${CONTAINER_NAME} 2>/dev/null || true

                        docker run -d \
                            --name ${CONTAINER_NAME} \
                            --network ${DOCKER_NETWORK} \
                            --restart unless-stopped \
                            -p 0.0.0.0:${HOST_PORT}:80 \
                            -e ASPNETCORE_ENVIRONMENT=Production \
                            -e InternalApi__SecretKey="${INTERNAL_SECRET}" \
                            -e OneCSettings__InternalSecret="${ONEC_SECRET}" \
                            -e OneCSettings__BaseUrl="${ONEC_URL}" \
                            -e OneCSettings__SyncIntervalMinutes=10 \
                            -e ReverseProxy__Clusters__onecCluster__Destinations__onec__Address="${ONEC_URL}" \
                            ${IMAGE_NAME}:latest

                        sleep 3
                        docker ps --filter name=${CONTAINER_NAME}
                        docker logs --tail 20 ${CONTAINER_NAME}
                    '''
                }
            }
        }
    }
}
