def DEPLOYED = false

pipeline {
    agent any

    parameters {
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Прогонять dotnet test перед сборкой')
    }

    options {
        skipDefaultCheckout()
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        APP_DIR        = 'alsav_gw'
        IMAGE_NAME     = 'alsav-gw'
        CONTAINER_NAME = 'alsav-api-gateway'
        HOST_PORT      = '5000'
        DOCKER_NETWORK = 'alsav_net'            // ← ЗАМЕНИТЬ: сеть, в которой живёт контейнер 1С
        ONEC_URL       = 'http://onec-http:80'  // ← ЗАМЕНИТЬ: имя реального контейнера 1С
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Tests') {
            when { expression { params.RUN_TESTS } }
            steps {
                dir("${APP_DIR}") {
                    // Передаём исходники в SDK-контейнер через stdin (tar),
                    // т.к. workspace Jenkins-контейнера недоступен демону хоста как путь
                    sh '''
                        tar -cz --exclude=.git --exclude=bin --exclude=obj . | \
                        docker run --rm -i -w /src mcr.microsoft.com/dotnet/sdk:8.0 \
                            bash -c 'tar -xz && dotnet test Alsav.ApiGateway.sln -c Release'
                    '''
                }
            }
        }

        stage('Build image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        # текущий latest сохраняем как rollback (на первой сборке его нет — не страшно)
                        docker image tag ${IMAGE_NAME}:latest ${IMAGE_NAME}:rollback || true
                        docker build \
                            -f src/Alsav.ApiGateway/Dockerfile \
                            -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                            -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    deployContainer(env.BUILD_NUMBER)
                    DEPLOYED = true
                }
            }
        }

        stage('Health check') {
            steps {
                sh '''
                    ok=0
                    for i in $(seq 1 30); do
                        if docker run --rm --network ${DOCKER_NETWORK} curlimages/curl:latest \
                            -fsS http://${CONTAINER_NAME}/health >/dev/null 2>&1; then
                            ok=1; break
                        fi
                        sleep 2
                    done
                    if [ "$ok" != "1" ]; then
                        echo "=== Health check FAILED, логи контейнера: ==="
                        docker logs --tail 100 ${CONTAINER_NAME}
                        exit 1
                    fi
                    echo "=== Health OK ==="
                '''
            }
        }
    }

    post {
        failure {
            script {
                def hasRollback = sh(script: 'docker image inspect ${IMAGE_NAME}:rollback >/dev/null 2>&1', returnStatus: true) == 0
                if (DEPLOYED && hasRollback) {
                    echo 'Откат на предыдущую версию...'
                    deployContainer('rollback')
                }
            }
        }
        success {
            // чистим dangling-образы и старые номерные теги, оставляем последние 10
            sh '''
                docker image prune -f --filter "until=168h" || true
                docker images ${IMAGE_NAME} --format '{{.Tag}}' | grep -E '^[0-9]+$' | sort -rn | \
                    tail -n +11 | xargs -r -I{} docker rmi ${IMAGE_NAME}:{} || true
            '''
        }
    }
}

def deployContainer(String tag) {
    withCredentials([
        string(credentialsId: 'alsav-internal-api-secret', variable: 'INTERNAL_SECRET'),
        string(credentialsId: 'alsav-onec-internal-secret',  variable: 'ONEC_SECRET')
    ]) {
        withEnv(["DEPLOY_TAG=${tag}"]) {
            sh '''
                docker rm -f ${CONTAINER_NAME} 2>/dev/null || true
                docker run -d \
                    --name ${CONTAINER_NAME} \
                    --network ${DOCKER_NETWORK} \
                    --restart unless-stopped \
                    -p 127.0.0.1:${HOST_PORT}:80 \
                    -e ASPNETCORE_ENVIRONMENT=Production \
                    -e InternalApi__SecretKey="${INTERNAL_SECRET}" \
                    -e OneCSettings__InternalSecret="${ONEC_SECRET}" \
                    -e OneCSettings__BaseUrl="${ONEC_URL}" \
                    -e OneCSettings__SyncIntervalMinutes=10 \
                    -e ReverseProxy__Clusters__onecCluster__Destinations__onec__Address="${ONEC_URL}" \
                    ${IMAGE_NAME}:${DEPLOY_TAG}
            '''
        }
    }
}
