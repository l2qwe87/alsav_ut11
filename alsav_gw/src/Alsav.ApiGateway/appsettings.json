{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "onecRoute": {
        "ClusterId": "onecCluster",
        "Match": { "Path": "/clientApi/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/hs/ClientAPI/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "onecCluster": {
        "Destinations": {
          "onec": { "Address": "http://onec-http:80" }
        }
      }
    }
  },
  "OneCSettings": {
    "BaseUrl": "http://onec-http:80",
    "InternalSecret": "CHANGE_ME_IN_PRODUCTION",
    "SyncIntervalMinutes": 10,
    "KeysEndpointPath": "/hs/ClientAPI/keys"
  },
  "InternalApi": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION"
  }
}
