{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "InternalApi": {
    "SecretKey": "CHANGE_ME_IN_PRODUCTION"
  },
  "ConnectionStrings": {
    "GatewayDb": "Data Source=/app/data/gateway.db"
  },
  "BalanceCalculation": {
    "DefaultWarehouse": "Склад адресного хранения"
  }
}
