{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "onecCluster": {
        "Destinations": {
          "onec": { "Address": "http://localhost:8080" }
        }
      }
    }
  },
  "OneCSettings": {
    "BaseUrl": "http://localhost:8080",
    "InternalSecret": "dev-internal-secret",
    "SyncIntervalMinutes": 10,
    "KeysEndpointPath": "/hs/ClientAPI/keys"
  },
  "InternalApi": {
    "SecretKey": "dev-internal-secret"
  }
}
