&НаКлиенте
Процедура алсав_алсав_ОткрытьPDFФайлыПосле(Команда)
	// Вставить содержимое обработчика.
	
	ффо = Новый Соответствие;
	
	
	
	Для каждого стр из Объект.Товары Цикл
		Если не стр.Выбран Тогда
			Продолжить;
		Конецесли;
		
		номенИнфо = ффо.Получить(стр.Номенклатура);
		Если номенИнфо = неопределено Тогда
			номенИнфо = Новый Структура("Номенклатура, Количество",стр.Номенклатура,0);
			ффо.Вставить(стр.Номенклатура,номенИнфо);
		конецЕсли;
		
		номенИнфо.Количество = номенИнфо.Количество + стр.КоличествоЭтикеток ;
		ффо[стр.Номенклатура] = номенИнфо;
		
	КонецЦикла;
	
	
	Для Каждого ел из ффо Цикл
		номенИнфо = ел.Значение;
		
		мФайлы = ПолучитьФайлы(номенИнфо.Номенклатура);
		файлы = "";
		Для Каждого файлСсылка из мФайлы цикл
			//ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(файлСсылка, Неопределено, УникальныйИдентификатор);
			//ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ПолучитьДанныеФайла(файлСсылка, Неопределено);
			ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляПечати(
				файлСсылка,
				УникальныйИдентификатор
			);

			
			обр = Новый ОписаниеОповещения("НапечататьФайлПослеПолученияВерсииВРабочийКаталог", ЭтотОбъект, номенИнфо);
			РаботаСФайламиСлужебныйКлиент.ПолучитьФайлВерсииВРабочийКаталог(
				обр,
				ДанныеФайла,
				"",
				УникальныйИдентификатор
			);
			//ПолноеИмяФайлаВРабочемКаталоге=РаботаСФайламиСлужебныйКлиент.алсав_ПолучитьПутьФайлаВРабочемКаталогеЭкспорт(ДанныеФайла);
			//
			//ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			//Если ЗначениеЗаполнено(ПолноеИмяФайлаВРабочемКаталоге) Тогда
			//	файлы = файлы + " """+ПолноеИмяФайлаВРабочемКаталоге+"""";
			//Иначе
			//	Сообщить("ПолноеИмяФайлаВРабочемКаталоге = пусто, " + файлСсылка);
			//Конецесли;
		КонецЦикла; 		
	конецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура НапечататьФайлПослеПолученияВерсииВРабочийКаталог(Результат, номенИнфо) Экспорт

	Если Результат.ФайлПолучен Тогда
		
		//НапечататьФайлПриложением(ПараметрыВыполнения.ДанныеФайла, Результат.ПолноеИмяФайла);
		
		файлы = """"+Результат.ПолноеИмяФайла+""""; 
		
		приложение = """C:\Program Files (x86)\SumatraPDF\SumatraPDF""";
		аргументы = " -print-to-default -print-settings """+номенИнфо.Количество+"x"" ";
		
		//аргументы = " -print-dialog ";
		
		кмд = приложение+аргументы+файлы;
		//сообщить(файлы);
		сообщить(кмд);
		
		ЗапуститьПриложение(кмд,,истина);

	КонецЕсли;
	
КонецПроцедуры




Функция ПолучитьФайлы(номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
	               |ГДЕ НЕ ПометкаУдаления И
	               |	НоменклатураПрисоединенныеФайлы.ВладелецФайла В(&номенклатура)";
	
	Запрос.УстановитьПараметр("номенклатура",номенклатура);
	
	рез = Запрос.Выполнить().Выбрать();
	
	мРезульт = новый Массив;
	Пока рез.Следующий() Цикл
		мРезульт.Добавить(рез.Ссылка);
		
	КонецЦикла;
	
	возврат мРезульт;
КонецФункции

&НаКлиенте
Процедура алсав_ПечатьHOFFПосле(Команда)
		
	ОчиститьСообщения();
	
	РезультатПроверки = ВыполнитьПроверку(ЭтаФорма);
	Если Не РезультатПроверки.ТоварыВыбраны Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Не выбрано ни одного товара'"));
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ПроверкаВыполнена Тогда
		
		ПараметрКоманды = Новый Массив;
		ПараметрКоманды.Добавить(ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
		
		ИменаМакетов = "";
		
		Если Режим = "ПечатьЭтикетокИЦенников" Тогда
			ИменаМакетов = "ЭтикеткаТовары,ЦенникТовары";
		ИначеЕсли Режим = "ПечатьЦенников" Тогда
			ИменаМакетов = "ЦенникТовары";
		ИначеЕсли Режим = "ПечатьЭтикеток" Тогда
			ИменаМакетов = "ЭтикеткаТовары";
		КонецЕсли;
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Обработка.ПечатьЭтикетокИЦенников",
			ИменаМакетов,
			ПараметрКоманды,
			ЭтаФорма,
			ПолучитьПараметрыHOFF());
		
	КонецЕсли;

КонецПроцедуры



