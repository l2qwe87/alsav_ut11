Функция ЗаполнитьСписокСборок(массивЗаказов, номерСтроки = -1) ЭКСПОРТ
	
	массивВариантовОбоеспечения = Новый Массив;
	массивВариантовОбоеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);	
	массивВариантовОбоеспечения.Добавить(Перечисления.ВариантыОбеспечения.Требуется);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("массивЗаказов", массивЗаказов);
	Запрос.УстановитьПараметр("номерСтроки", номерСтроки);
	Запрос.УстановитьПараметр("массивВариантовОбоеспечения", массивВариантовОбоеспечения);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	               |	ИСТИНА КАК ОтметитьКЗаказу,
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	               |	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	               |	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоУпаковок,
	               |	ЗаказКлиентаТовары.Ссылка.Организация КАК Организация,
	               |	ЗаказКлиентаТовары.Ссылка.Подразделение КАК Подразделение,
	               |	ЗаказКлиентаТовары.Ссылка.Склад КАК Склад,
	               |	ЗаказКлиентаТовары.Упаковка КАК Упаковка
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка В(&массивЗаказов)
	               |	И ЗаказКлиентаТовары.ВариантОбеспечения В(&массивВариантовОбоеспечения)
	               |	И (&номерСтроки = -1
	               |			ИЛИ ЗаказКлиентаТовары.НомерСтроки = &номерСтроки)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Номенклатура,
	               |	ЗаказКлиентаТовары.Ссылка,
	               |	ЗаказКлиентаТовары.Характеристика,
	               |	ЗаказКлиентаТовары.Упаковка,
	               |	ЗаказКлиентаТовары.Ссылка.Организация,
	               |	ЗаказКлиентаТовары.Ссылка.Подразделение,
	               |	ЗаказКлиентаТовары.Ссылка.Склад";
	
	тчСборки = Запрос.Выполнить().Выгрузить();
	Возврат тчСборки;
	
КонецФункции



Функция НайтиСозданныеЗаказыНаСборку(тчСборки)ЭКСПОРТ
	Если Ложь Тогда тчСборки = Новый ТаблицаЗначений; КонецЕсли;
	
	Если тчСборки.Колонки.Найти("ОтметитьКЗаказу") =  неопределено Тогда
		тчСборки.Колонки.Добавить("ОтметитьКЗаказу");
	КонецЕсли;
	
	Если тчСборки.Колонки.Найти("ЗаказНаСборку") =  неопределено Тогда
		тчСборки.Колонки.Добавить("ЗаказНаСборку");
	КонецЕсли;

	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Заказ.Ссылка КАК Ссылка,
	               |	Заказ.Количество КАК Количество,
	               |	Заказ.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	Сборка.Ссылка КАК СборкаТоваров
	               |ИЗ
	               |	Документ.ЗаказНаСборку КАК Заказ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаТоваров КАК Сборка
	               |		ПО (Сборка.ЗаказНаСборку = Заказ.Ссылка)
	               |			И (Сборка.Проведен = ИСТИНА)
	               |ГДЕ
	               |	Заказ.Проведен = ИСТИНА
	               |	И Заказ.ДокументОснование = &ДокументОснование
	               |	И Заказ.Номенклатура = &Номенклатура
	               |	И Заказ.Характеристика = &Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(Заказ.Количество) КАК Количество
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК Заказ
	               |ГДЕ
	               |	Заказ.Ссылка = &ДокументОснование
	               |	И Заказ.Номенклатура = &Номенклатура
	               |	И Заказ.Характеристика = &Характеристика";
	
	
	мНовыеСтроки = новый Массив;
				   
	Для Каждого стр из тчСборки Цикл
		Запрос.УстановитьПараметр("ДокументОснование",стр.ЗаказКлиента);
		Запрос.УстановитьПараметр("Номенклатура",стр.Номенклатура);
		Запрос.УстановитьПараметр("Характеристика",стр.Характеристика);
		
		результатыВыполнения = Запрос.ВыполнитьПакет();
		
		всегоТребуется =0;
		Рез = результатыВыполнения[1].Выбрать();
		Пока Рез.Следующий() Цикл
			всегоТребуется = всегоТребуется + Рез.Количество; 
		КонецЦикла;
		
		Рез = результатыВыполнения[0].Выбрать();
		количествоВЗаказе = стр.Количество;
		Пока Рез.Следующий() Цикл
			Если всегоТребуется > Рез.Количество Тогда
				всегоТребуется = всегоТребуется - Рез.Количество;
			Иначе
				стр.ЗаказНаСборку = Рез.Ссылка;
			КонецЕсли; 
			//Если стр.Количество > Рез.Количество Тогда
			//	стр.Количество = стр.Количество - Рез.Количество; 
			//	стр.КоличествоУпаковок = стр.Количество;
			//Иначе
			//	стр.ЗаказНаСборку = Рез.Ссылка;
			//КонецЕсли; 
		КонецЦикла;     
		
		Если стр.Количество > количествоВЗаказе Тогда
			стр.Количество = количествоВЗаказе;
			стр.КоличествоУпаковок = стр.Количество;
		Иначе
		КонецЕсли;
		
		стр.ОтметитьКЗаказу = НЕ(ЗначениеЗаполнено(стр.ЗаказНаСборку) ИЛИ стр.Количество <= 0);
	КонецЦикла;
	
	возврат тчСборки;
КонецФункции


Функция ЗаполнитьВариантыКомплектации(тчСборки)ЭКСПОРТ
	Если Ложь Тогда тчСборки = Новый ТаблицаЗначений; КонецЕсли;
	
	Если тчСборки.Колонки.Найти("ВариантКомплектации") =  неопределено Тогда
		тчСборки.Колонки.Добавить("ВариантКомплектации");
	КонецЕсли;
	
	Для Каждого Стр из тчСборки Цикл
		Если НЕ ЗначениеЗаполнено(стр.ВариантКомплектации) Тогда 
			стр.ВариантКомплектации = Справочники.ВариантыКомплектацииНоменклатуры.ПолучитьОсновнуюКомплектацию(
				Стр.Номенклатура, 
				Стр.Характеристика
			);
		КонецЕсли;
	КонецЦикла;
КонецФункции


Функция СоздатьСборку(заказ)ЭКСПОРТ
	результ = Документы.СборкаТоваров.ПустаяСсылка();
	//Попытка
		УстановитьОбеспечениеЗаказа(Заказ);
		нДок = Документы.СборкаТоваров.СоздатьДокумент();
		нДок.ЗаказНаСборку = заказ;
		
		структураЗаполнения = новый Структура("МассивЗаказов,РеквизитыШапки");
		структураЗаполнения.МассивЗаказов = Новый Массив;
		структураЗаполнения.МассивЗаказов.Добавить(заказ);
		структураЗаполнения.РеквизитыШапки = Новый Структура("Склад,ХозяйственнаяОперация,ВариантПриемкиТоваров,Ссылка,Организация,Подразделение,НаправлениеДеятельности");
		ЗаполнитьЗначенияСвойств(структураЗаполнения.РеквизитыШапки,заказ);
		
