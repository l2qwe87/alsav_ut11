			//СоздатьОрдерДляСборки(заказ);
		//	СоздатьОрдерДляСборки(нДок.Ссылка);
			
		//КонецЕсли;
		
	//Исключение
	//Конецпопытки;
	
	возврат результ;
КонецФункции

Функция СоздатьОрдерДляСборки(сборка) ЭКСПОРТ
	Если СкладыСервер.ИспользоватьОрдернуюСхемуПриПоступлении(сборка.Склад, сборка.Дата) Тогда
		ордер = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
		
		данныеДляЗаполнения = новый Структура();
		данныеДляЗаполнения.Вставить("ДатаВходящегоДокумента",сборка.Дата);
		данныеДляЗаполнения.Вставить("ДатаПоступления",ТекущаяДата());
		данныеДляЗаполнения.Вставить("ЗакрыватьГрафикПоступления", ложь);
		данныеДляЗаполнения.Вставить("ЗонаПриемки", Справочники.СкладскиеЯчейки.ПустаяСсылка());
		данныеДляЗаполнения.Вставить("НомерВходящегоДокумента", сборка.Номер);
		данныеДляЗаполнения.Вставить("Отправитель",сборка.Склад);
		данныеДляЗаполнения.Вставить("Помещение",Справочники.СкладскиеПомещения.ПустаяСсылка());
		данныеДляЗаполнения.Вставить("Распоряжение", сборка.Ссылка);
		данныеДляЗаполнения.Вставить("Склад",сборка.Склад);
		данныеДляЗаполнения.Вставить("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.СборкаТоваров);
		
		
		ордер.Заполнить(данныеДляЗаполнения);
		ордер.Дата = ТекущаяДата();
		
		ордер.ЗаполнитьТоварыПоТоварамКПоступлению("НоменклатураКоличество", ордер.Дата);
		
		ордер.Статус =Перечисления.СтатусыПриходныхОрдеров.Принят;
		ордер.ЗакрыватьГрафикПоступления = Истина;
		ордер.Записать(РежимЗаписиДокумента.Запись);
		ордер.Записать(РежимЗаписиДокумента.Проведение);

		Возврат ордер.Ссылка;
	КонецЕсли;
КонецФункции                   

Функция СоздатьОрдерДляСборкиРасходный(сборка) ЭКСПОРТ           
	
	Если ЛОЖЬ Тогда сборка = Документы.СборкаТоваров.ПустаяСсылка(); КонецЕсли;
	
	Если СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(сборка.Склад, сборка.Дата) Тогда
		ордер = Документы.РасходныйОрдерНаТовары.СоздатьДокумент();
		
		данныеДляЗаполнения = новый Структура();
		данныеДляЗаполнения.Вставить("ДатаВходящегоДокумента",сборка.Дата);
		данныеДляЗаполнения.Вставить("ДатаОтгрузки",ТекущаяДата());
		данныеДляЗаполнения.Вставить("ЗакрыватьГрафикОтгрузки", ложь);
		данныеДляЗаполнения.Вставить("ЗонаПриемки", Справочники.СкладскиеЯчейки.ПустаяСсылка());
		данныеДляЗаполнения.Вставить("НомерВходящегоДокумента", сборка.Номер);
		данныеДляЗаполнения.Вставить("Получатель",сборка.Склад);
		данныеДляЗаполнения.Вставить("Помещение",Справочники.СкладскиеПомещения.ПустаяСсылка());
		//данныеДляЗаполнения.Вставить("Распоряжение", сборка.Ссылка);
		данныеДляЗаполнения.Вставить("Распоряжение", сборка.Ссылка.ЗаказНаСборку);
		данныеДляЗаполнения.Вставить("Склад",сборка.Склад);
		данныеДляЗаполнения.Вставить("СкладскаяОперация",Перечисления.СкладскиеОперации.ОтгрузкаКомплектующихДляСборки);
		
		ЗаполнитьЗначенияСвойств(ордер, данныеДляЗаполнения);
		
		ордер.Заполнить(данныеДляЗаполнения);
		ордер.Дата = ТекущаяДата();
		
		Для Каждого стр из сборка.Товары Цикл
			нСтр = ордер.ТоварыПоРаспоряжениям.Добавить(); 
			нСтр.Распоряжение = сборка.Ссылка.ЗаказНаСборку;
			нСтр.Номенклатура = стр.Номенклатура;
			нСтр.Характеристика = стр.Характеристика;
			нСтр.Количество = стр.Количество;
			
		КонецЦикла;
		
		Документы.РасходныйОрдерНаТовары.ЗаполнитьОтгружаемыеТоварыПоТоварамПоРаспоряжениям(ордер);
		Для Каждого стр из ордер.ОтгружаемыеТовары Цикл
			Если ЗначениеЗаполнено(стр.Номенклатура) Тогда
				стр.Упаковка = стр.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЦикла;
		
		ордер.Записать(РежимЗаписиДокумента.Запись);
		ордер.Записать(РежимЗаписиДокумента.Проведение);
		
		ордер.Статус = Перечисления.СтатусыРасходныхОрдеров.КОтбору;
		ордер.Записать(РежимЗаписиДокумента.Проведение);
		
		Для Каждого стр из ордер.ОтгружаемыеТовары Цикл
			стр.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
		КонецЦикла;		
		ордер.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен;
        ордер.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат ордер.Ссылка;

	КонецЕсли;
КонецФункции

Функция УстановитьОбеспечениеЗаказа(заказ)ЭКСПОРТ
	оДок = заказ.ПолучитьОбъект();
	Если Ложь Тогда оДок = Документы.ЗаказНаСборку.СоздатьДокумент(); КонецЕсли;
	Для Каждого стр из оДок.Товары Цикл
		стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
	КонецЦикла;
	оДок.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	
	оДок.Записать(РежимЗаписиДокумента.Проведение);
КонецФункции


Функция СоздатьЗаказыНаСборку(Сборки)  ЭКСПОРТ
	
	СформированныеЗаказы = новый Массив;
	
	ТекстОшибкиЗаписи = НСтр("ru='%1 невозможно записать документ по причине:
								|%2'");
	ТекстОшибкиЗаполнения = НСтр("ru='%1 невозможно провести по причине некорректного заполнения.'");
	
	СпособыОбеспечения = Новый Соответствие;
	
	Для каждого СтрокаДанныеЗаказа Из Сборки Цикл
		Если НЕ СтрокаДанныеЗаказа.ОтметитьКЗаказу ИЛИ 
			СтрокаДанныеЗаказа.КоличествоУпаковок = 0 ИЛИ
			НЕ ЗначениеЗаполнено(СтрокаДанныеЗаказа.ВариантКомплектации)
			Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеЗаполнения = Новый Структура("ХозяйственнаяОперация,Склад,Номенклатура,Характеристика,Назначение,ВариантКомплектации, Количество,
			|КоличествоУпаковок, Упаковка, НачалоСборкиРазборки, ОкончаниеСборкиРазборки, ДлительностьСборкиРазборки");
		
		//ДанныеЗаполнения.Вставить("ДлительностьСборкиРазборки", СтрокаДанныеЗаказа.ДлительностьСборкиРазборки);
		
		ДокументОбъект = Документы.ЗаказНаСборку.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		
		ДокументОбъект.Комментарий = НСтр("ru = 'Сформирован автоматически обработкой ""Формирование заказов на сборку (разборку) по плану"".'");
		
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовНаСборку") Тогда
			ДокументОбъект.Статус = Перечисления.СтатусыВнутреннихЗаказов.Закрыт;
		Иначе
			ДокументОбъект.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, СтрокаДанныеЗаказа);
		
		//ДанныеЗаполнения.НачалоСборкиРазборки = СтрокаДанныеЗаказа.ДатаНачалаСборки;
		//ДанныеЗаполнения.ОкончаниеСборкиРазборки = СтрокаДанныеЗаказа.НачалоПериодаСборки;
		
		ДокументОбъект.Заполнить(ДанныеЗаполнения);
		 
			
		Если ЗначениеЗаполнено(СтрокаДанныеЗаказа.Организация) Тогда
			ДокументОбъект.Организация = СтрокаДанныеЗаказа.Организация;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанныеЗаказа.Подразделение) Тогда
			ДокументОбъект.Подразделение = СтрокаДанныеЗаказа.Подразделение;
		КонецЕсли;
		
		//
		ДокументОбъект.НачалоСборкиРазборки = ДокументОбъект.Дата;
		ДокументОбъект.ОкончаниеСборкиРазборки = ДокументОбъект.Дата;
		
		ДокументОбъект.ДокументОснование = СтрокаДанныеЗаказа.ЗаказКлиента;

		
		//Попытка
			
