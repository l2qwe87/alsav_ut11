
Функция ПодготовитьИОтправитьJSON()ЭКСПОРТ  
	
	данные = ПолучитьДанныеОтправки();
	
	Если ЛОЖЬ Тогда данные = Новый Массив; КонецЕсли;
	
	// Создаём временный каталог для лога HTTP-взаимодействий
	КаталогЛога = КаталогВременныхФайлов() + "inmyroom_http_log_" + Строка(Новый УникальныйИдентификатор()) + "\";
	СоздатьКаталог(КаталогЛога);
	
	лимит = 999;
	колвоПодМассивов = (данные.Количество() / лимит) + 1;
	
	массивМассивов = алсав_ВыгрузкаCsvJson.РазбитьМассивНаМассивы(данные, колвоПодМассивов, Истина);
	
	НомерПакета = 0;
	Для Каждого мДанные Из массивМассивов Цикл
		НомерПакета = НомерПакета + 1;
		данныеДляОтправки = Новый Соответствие();
		данныеДляОтправки.Вставить("stocks", мДанные);
		json = алсав_ВыгрузкаCsvJson.СтруктураВjson(данныеДляОтправки); 
		
		// Отправка и сохранение лога в цикле
		ОтправитьДанныеСЛогом(json, НомерПакета, КаталогЛога);
		
	КонецЦикла;    
	
	данныеДляОтправки = Новый Соответствие();
	данныеДляОтправки.Вставить("stocks", данные); 
	jsonПолный = алсав_ВыгрузкаCsvJson.СтруктураВjson(данныеДляОтправки);
	ЗагрузитьНаFTP(jsonПолный);
	
	// Упаковываем лог в архив и заливаем на FTP с перезаписью
	УпаковатьИВыгрузитьЛогHttpНаFTP(КаталогЛога);
	
	// Очистка временного каталога
	Попытка
		УдалитьФайлы(КаталогЛога);
	Исключение
		// Игнорируем ошибку удаления
	КонецПопытки;
	
КонецФункции

Функция ОтправитьДанные(данные)
	//https://www.inmyroom.ru/supplier_api/v1/stocks/bulk_update 
	
	хост = "www.inmyroom.ru";
	
	Соединение = Новый HTTPСоединение(хост,,,,,,Истина);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("content-type", "application/json"); 
	ЗаголовокHTTP.Вставить("access-token", алсав_ВыгрузкаCsvJson.ПолучитьСекрет("secret_inmyroom_access_token"));
	ЗаголовокHTTP.Вставить("supplier-id", алсав_ВыгрузкаCsvJson.ПолучитьСекрет("secret_inmyroom_supplier_id"));

	
	
	HTTPЗапрос = Новый HTTPЗапрос("/supplier_api/v1/stocks/bulk_update", ЗаголовокHTTP);
	HTTPЗапрос.УстановитьТелоИзСтроки(данные);
	
	Результат = Соединение.Записать(HTTPЗапрос);//PUT
	
	Сообщить("Код ответа:" + Результат.КодСостояния);
	Сообщить("Тело ответа:" + Результат.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьДанныеСЛогом(данные, НомерПакета, КаталогЛога)
	
	Результат = ОтправитьДанные(данные);
	
	ТелоОтвета = Результат.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Префикс = Формат(НомерПакета, "ЧЦ=4; ЧН=0; ЧВН=");
	
	СохранитьТекстВФайл(КаталогЛога + "запрос_" + Префикс + ".json", данные);
	ТекстОтветаДляЛога = "Код состояния: " + Формат(Результат.КодСостояния, "ЧГ=0") + Символы.ПС + Символы.ПС + ТелоОтвета;
	СохранитьТекстВФайл(КаталогЛога + "ответ_" + Префикс + ".json", ТекстОтветаДляЛога);
	
КонецПроцедуры

Процедура СохранитьТекстВФайл(ПутьКФайлу, Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = "";
	КонецЕсли;
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.УстановитьТекст(Текст);
	ТекстовыйДокумент.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	
КонецПроцедуры

Процедура УпаковатьИВыгрузитьЛогHttpНаFTP(КаталогЛога)
	
	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	
	ЗаписьZip = Новый ЗаписьZipФайла(ИмяАрхива);
	
	ФайлыЛога = НайтиФайлы(КаталогЛога, "*.*");
	Для Каждого ФайлЛога Из ФайлыЛога Цикл
		Если ФайлЛога.ЭтоФайл() Тогда
			ЗаписьZip.Добавить(ФайлЛога.ПолноеИмя, РежимСохраненияПутейZIP.СохранятьОтносительныеПути);
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьZip.Записать();
	
	СерверFTP = алсав_ВыгрузкаCsvJson.ПолучитьСекрет("secret_alsav_ftp");
	ЛогинFTP  = алсав_ВыгрузкаCsvJson.ПолучитьСекрет("secret_csv_alsav_login");
	ПарольFTP = алсав_ВыгрузкаCsvJson.ПолучитьСекрет("secret_csv_alsav_password");
	
	ФТПСоединение = Новый FTPСоединение(СерверFTP, 21, ЛогинFTP, ПарольFTP);
	ФТПСоединение.Записать(ИмяАрхива, "inmyroom_http_log.zip");
	
	УдалитьФайлы(ИмяАрхива);
	
КонецПроцедуры

Функция ПолучитьДанныеОтправки()
	
	данные = новый Массив;
	поляШаблон = "sku,price,old_price,stock,available";
	
	////////////////////////////////////////////////////////////////////
	Запрос = ПолучитьЗапрос();	
	////////////////////////////////////////////////////////////////////
	
	дт1 = ТекущаяДата();
	рез = Запрос.Выполнить().Выбрать();
	дт2 = ТекущаяДата();
	
	Пока Рез.Следующий() Цикл
		нСтр = Новый Структура(поляШаблон);
		
		ЗаполнитьЗначенияСвойств(нСтр, Рез);
		нСтр = алсав_ВыгрузкаCsvJson.СтруктураПреобразоватьЗначенияВСериализуеммыеТипы(нСтр);   
		нСтр.available = "false";
		
		данные.Добавить(нСтр);
	КонецЦикла;
	Возврат данные;
КонецФункции 

