	        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДС_Серия
	        |		ПО (ДС_Серия.Ссылка = ВТ_Набор.Номенклатура)
	        |			И (ДС_Серия.Свойство.Заголовок = ""Серия"")
	        |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	        |			ВТ.Номенклатура КАК Номенклатура,
	        |			ВТ.Характеристика КАК Характеристика,
	        |			МАКСИМУМ(ВТ.Штрихкод) КАК Штрихкод
	        |		ИЗ
	        |			РегистрСведений.ШтрихкодыНоменклатуры КАК ВТ
	        |		
	        |		СГРУППИРОВАТЬ ПО
	        |			ВТ.Номенклатура,
	        |			ВТ.Характеристика) КАК Т_Штрихкоды
	        |		ПО ВТ_Набор.Номенклатура = Т_Штрихкоды.Номенклатура
	        |			И (ВТ_Набор.Характеристика ЕСТЬ NULL
	        |				ИЛИ ВТ_Набор.Характеристика = Т_Штрихкоды.Характеристика)
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДР_Активен
	        |		ПО (ДР_Активен.Ссылка = ВТ_Набор.Характеристика)
	        |			И (ДР_Активен.Свойство.Заголовок = ""Активность на сайте"")
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДР_Распродажа
	        |		ПО (ДР_Распродажа.Ссылка = ВТ_Набор.Характеристика)
	        |			И (ДР_Распродажа.Свойство.Заголовок = ""Распродажа"")
	        |ГДЕ
	        |	ВТ_Набор.Номенклатура В ИЕРАРХИИ(&группыНоманклатуры)
	        |	И ЦеныНоменклатуры.Цена > 0";
КонецФункции



Функция ВыгрузитьКОМУС() ЭКСПОРТ            
	
	
	Запрос = новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса_КОМУС(); 
	
	Запрос.УстановитьПараметр("ДатаЗавтра",КонецДня(ТекущаяДата())+1);
	
	данные = новый массив;
	
	рез = Запрос.Выполнить().Выбрать();
	//поляШаблон = "Артикул,Штрихкод,НаименованиеТовара,Цена,Остаток";
	поляШаблон = "Артикул,НаименованиеТовара,Цена,Остаток";
	Пока Рез.Следующий() Цикл
		нСтр = Новый Структура(поляШаблон);
		ЗаполнитьЗначенияСвойств(нСтр, Рез); 
		Если Рез.СерияНаименование = "HORECA" Тогда
			нСтр.Цена = Окр(нСтр.Цена * 0.9,2);
		Иначе
			нСтр.Цена = Окр(нСтр.Цена * 0.75, 2);
		КонецЕсли;
		данные.Добавить(нСтр);
	КонецЦикла;	
	
	контент = СтруктураВjson(данные);	
	
	ФТПСоединение = Новый FTPСоединение("secret_alsav_ftp",21,"secret_alsav_json_login","secret_alsav_json_password");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("txt");
	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент);
	ТекстовыйДок.Записать(ВременныйФайл);
	
	ФТПСоединение.Записать(ВременныйФайл,"ostatki.json"); 
	УдалитьФайлы(ВременныйФайл);	

КонецФункции

Функция ПолучитьТекстЗапроса_КОМУС()
	
	текстЗапроса = "ВЫБРАТЬ //ПЕРВЫЕ 100
	               |	Номен.Ссылка.Артикул КАК Артикул,
	               |	Т_Штрихкоды.Штрихкод КАК Штрихкод,
				   |	ДР_Серия.Значение КАК Серия,
				   |	ДР_Серия.Значение.Наименование КАК СерияНаименование,
	               |	Номен.Ссылка.Наименование КАК НаименованиеТовара,
	               |	ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
	               |	ЕСТЬNULL(Набор.ВНаличии - (Набор.ВРезервеСоСкладаИПодЗаказ + Набор.ВРезервеГрафика) - Набор.КОбеспечению - Набор.КОбеспечениюИзСборок, 0) КАК Остаток
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номен
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Хар
	               |		ПО (Хар.Владелец = Номен.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДР_АртикулКоммус
	               |		ПО (ДР_АртикулКоммус.Ссылка = Хар.Ссылка)
	               |			И (ДР_АртикулКоммус.Свойство.Заголовок = ""Распродажа"")
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДР_Серия
	               |		ПО Номен.Ссылка = ДР_Серия.Ссылка
	               |			И (ДР_Серия.Свойство.Заголовок = ""Серия"")
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Т_Штрихкоды
	               |		ПО Номен.Ссылка = Т_Штрихкоды.Номенклатура
	               |			И (Хар.Ссылка ЕСТЬ NULL
	               |				ИЛИ Хар.Ссылка = Т_Штрихкоды.Характеристика)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЗавтра, ВидЦены.Наименование = ""Отпускная цена (с учетом НДС)"") КАК Цены
	               |		ПО (Цены.Номенклатура = Т_Штрихкоды.Номенклатура)
	               |			И (Цены.Характеристика ЕСТЬ NULL
	               |				ИЛИ Цены.Характеристика = Т_Штрихкоды.Характеристика)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Таблица.Номенклатура КАК Номенклатура,
	               |			Таблица.Характеристика КАК Характеристика,
	               |			Таблица.ВНаличии КАК ВНаличии,
	               |			0 КАК ПриходОсновной,
	               |			Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
	               |			Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
	               |			0 КАК ВРезервеГрафика,
	               |			Таблица.КОтгрузке КАК КОтгрузке,
	               |			Таблица.КОбеспечению КАК КОбеспечению,
	               |			Таблица.КОбеспечениюИзСборок КАК КОбеспечениюИзСборок
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				Набор.Номенклатура КАК Номенклатура,
	               |				Набор.Характеристика КАК Характеристика,
	               |				СУММА(Набор.ВНаличии) КАК ВНаличии,
	               |				СУММА(Набор.ВРезервеСоСклада) КАК ВРезервеСоСклада,
	               |				СУММА(Набор.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
	               |				СУММА(Набор.КОтгрузке) КАК КОтгрузке,
	               |				СУММА(Набор.КОбеспечению) КАК КОбеспечению,
	               |				СУММА(Набор.КОбеспечениюИзСборок) КАК КОбеспечениюИзСборок
	               |			ИЗ
	               |				(ВЫБРАТЬ
	               |					Таблица.Номенклатура КАК Номенклатура,
	               |					Таблица.Характеристика КАК Характеристика,
	               |					Таблица.Склад КАК Склад,
	               |					Таблица.ВНаличииОстаток КАК ВНаличии,
	               |					Таблица.ВРезервеСоСкладаОстаток КАК ВРезервеСоСклада,
	               |					Таблица.ВРезервеПодЗаказОстаток КАК ВРезервеПодЗаказ,
	               |					0 КАК КОтгрузке,
	               |					0 КАК КОбеспечению,
	               |					0 КАК КОбеспечениюИзСборок
	               |				ИЗ
	               |					РегистрНакопления.СвободныеОстатки.Остатки(, {((Номенклатура, Характеристика) В
	               |							    (ВЫБРАТЬ
	               |							        ТаблицаОтбора.Номенклатура КАК Номенклатура,
	               |							        ТаблицаОтбора.Характеристика КАК Характеристика
	               |							    ИЗ
	               |							        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
	               |							    ГДЕ
	               |							        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
	               |				
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |				
	               |				ВЫБРАТЬ
	               |					Таблица.Номенклатура,
	               |					Таблица.Характеристика,
	               |					Таблица.Склад,
	               |					Таблица.КОтгрузкеОстаток,
	               |					0,
	               |					0,
	               |					Таблица.КОтгрузкеОстаток,
	               |					0,
	               |					0
	               |				ИЗ
	               |					РегистрНакопления.ТоварыКОтгрузке.Остатки(, {((Номенклатура, Характеристика) В
	               |							    (ВЫБРАТЬ
	               |							        ТаблицаОтбора.Номенклатура КАК Номенклатура,
	               |							        ТаблицаОтбора.Характеристика КАК Характеристика
	               |							    ИЗ
	               |							        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
	               |							    ГДЕ
	               |							        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
	               |				
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |				
	               |				ВЫБРАТЬ
	               |					Таблица.Номенклатура,
	               |					Таблица.Характеристика,
	               |					Таблица.Склад,
	               |					0,
	               |					0,
	               |					0,
	               |					0,
	               |					СУММА(Таблица.КоличествоНеобеспечено),
	               |					0
	               |				ИЗ
	               |					РегистрНакопления.ГрафикОтгрузкиТоваров КАК Таблица
	               |				{ГДЕ
	               |					((Таблица.Номенклатура, Таблица.Характеристика) В
	               |							(ВЫБРАТЬ
	               |								ТаблицаОтбора.Номенклатура КАК Номенклатура,
	               |								ТаблицаОтбора.Характеристика КАК Характеристика
	               |							ИЗ
	               |								ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
	               |							ГДЕ
	               |								ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2,
	               |					Таблица.Склад.*,
	               |					Таблица.Номенклатура.*,
	               |					Таблица.Характеристика.*}
	               |				
	               |				СГРУППИРОВАТЬ ПО
	               |					Таблица.Номенклатура,
	               |					Таблица.Характеристика,
	               |					Таблица.Склад
	               |				
	               |				ИМЕЮЩИЕ
	               |					СУММА(Таблица.КоличествоНеобеспечено) > 0
	               |				
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |				
	               |				ВЫБРАТЬ
	               |					ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
	               |					ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
	               |					Таблица.Склад,
	               |					0,
	               |					0,
	               |					0,
	               |					0,
	               |					0,
	               |					СУММА(ВТ_ВариантыКомплектацииНоменклатуры.Количество * Таблица.КоличествоНеобеспечено)
	               |				ИЗ
	               |					(ВЫБРАТЬ
	               |						Таблица.Номенклатура КАК Номенклатура,
	               |						Таблица.Характеристика КАК Характеристика,
	               |						Таблица.Склад КАК Склад,
	               |						СУММА(Таблица.КоличествоНеобеспечено) КАК КоличествоНеобеспечено
	               |					ИЗ
	               |						РегистрНакопления.ГрафикОтгрузкиТоваров КАК Таблица
	               |					
	               |					СГРУППИРОВАТЬ ПО
	               |						Таблица.Номенклатура,
	               |						Таблица.Характеристика,
	               |						Таблица.Склад
	               |					
	               |					ИМЕЮЩИЕ
	               |						СУММА(Таблица.КоличествоНеобеспечено) > 0) КАК Таблица
	               |						ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |							ВариантыКомплектацииНоменклатуры.Ссылка КАК Ссылка,
	               |							ВариантыКомплектацииНоменклатуры.Ссылка.Владелец КАК НоменклатураОсновногоКомпонента,
	               |							ВариантыКомплектацииНоменклатуры.Ссылка.Характеристика КАК ХарактеристикаОсновногоКомпонента,
	               |							ЕСТЬNULL(Полуфабрикаты.Номенклатура, ВариантыКомплектацииНоменклатуры.Номенклатура) КАК Номенклатура,
	               |							ЕСТЬNULL(Полуфабрикаты.Характеристика, ВариантыКомплектацииНоменклатуры.Характеристика) КАК Характеристика,
	               |							ЕСТЬNULL(Полуфабрикаты.Количество, 1) * ВариантыКомплектацииНоменклатуры.Количество КАК Количество,
	               |							ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат
	               |						ИЗ
	               |							Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатуры
	               |								ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Полуфабрикаты
	               |								ПО (ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат = ИСТИНА)
	               |									И ВариантыКомплектацииНоменклатуры.ВариантКомлектации = Полуфабрикаты.Ссылка
	               |									И (Полуфабрикаты.Ссылка.ПометкаУдаления = ЛОЖЬ)
	               |									И (Полуфабрикаты.Ссылка.Основной)
	               |						ГДЕ
	               |							ВариантыКомплектацииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |							И ВариантыКомплектацииНоменклатуры.Ссылка.Основной) КАК ВТ_ВариантыКомплектацииНоменклатуры
	               |						ПО (ВТ_ВариантыКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = Таблица.Номенклатура)
	               |							И (ВТ_ВариантыКомплектацииНоменклатуры.Характеристика ЕСТЬ NULL
	               |								ИЛИ ВТ_ВариантыКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента = Таблица.Характеристика)
	               |				
	               |				СГРУППИРОВАТЬ ПО
	               |					ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
	               |					ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
	               |					Таблица.Склад) КАК Набор
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				Набор.Номенклатура,
	               |				Набор.Характеристика) КАК Таблица) КАК Набор
	               |		ПО (Набор.Номенклатура = Т_Штрихкоды.Номенклатура)
	               |			И (Набор.Характеристика ЕСТЬ NULL
	               |				ИЛИ Набор.Характеристика = Т_Штрихкоды.Характеристика)";  
	
	
	Возврат текстЗапроса;
КонецФункции


