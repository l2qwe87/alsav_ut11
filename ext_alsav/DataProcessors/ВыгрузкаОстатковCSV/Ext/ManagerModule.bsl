Функция СтруктураВjson(Значение)  ЭКСПОРТ

	Если Значение = неопределено Тогда
		возврат "";
	КонецЕсли;

	
    ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	СтрJSON = ЗаписьJSON.Закрыть();
	
	возврат СтрJSON;

КонецФункции

Функция МассивСтруктурВCSV(данные)ЭКСПОРТ
	Если ЛОЖЬ Тогда данные = новый Массив; КонецЕсли;
	
	контент = "";
	Для Каждого стр из данные Цикл
		Если ЛОЖЬ Тогда стр = Новый Структура; КонецЕсли;
		
		контент = контент + ?(контент = "","",Символы.ПС);
		этоПерваяКолонка = истина;
		Для Каждого эл из стр цикл              
			знч = "";
			Если ТипЗнч(эл.Значение) = Тип("Число") Тогда 
				знч = НормализоватьЧисло(эл.Значение);
			Иначе
				знч = СокрЛП(Строка(эл.Значение));
			КонецЕсли;
			
			контент	= контент + ?(этоПерваяКолонка,"",";")+ знч;			
			этоПерваяКолонка = ложь;
		КонецЦикла;
	КонецЦикла;
	
	Возврат контент;
КонецФункции

Функция ВыгрузитьОстаток_ХОФФ() ЭКСПОРТ
	
	Запрос = новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса_ХОФФ();
	
	контент = "";
	рез = Запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл
		стрАртикул = СокрЛП(Строка(рез.Артикул));
		стрОстаток = НормализоватьЧисло(рез.Остаток);
		Если ЗначениеЗаполнено(стрАртикул) и ЗначениеЗаполнено(стрОстаток) и (рез.Остаток > 0) Тогда
			контент = контент + ?(контент = "","",Символы.ПС)
				+ стрАртикул
				+";"
				+ стрОстаток
			;
		КонецЕсли;
	КонецЦикла;
	
	ФТПСоединение = Новый FTPСоединение("secret_alsav_ftp",21,"secret_alsav_csv_login","secret_alsav_csv_password");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла( "txt");
	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент);
	ТекстовыйДок.Записать(ВременныйФайл);
	
	ФТПСоединение.Записать(ВременныйФайл,"alsav_hoff.csv"); 
	УдалитьФайлы(ВременныйФайл);	
КонецФункции  

Функция ВыгрузитьОстаток_express_office() ЭКСПОРТ
	
	Запрос = новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса_express_office(); 
	
	группыНоманклатуры = новый Массив();
	группыНоманклатуры.Добавить(Справочники.Номенклатура.НайтиПоКоду("УТ-00020935"));//1.1 Продукция стандартная
	
	имеетВариантКомплектации = новый Массив();
	имеетВариантКомплектации.Добавить(ложь);
	имеетВариантКомплектации.Добавить(неопределено);
	
	Запрос.УстановитьПараметр("группыНоманклатуры",группыНоманклатуры); 
	Запрос.УстановитьПараметр("имеетВариантКомплектации",ложь);
	
	контент = "";
	рез = Запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл
		стрШтрихкод = СокрЛП(Строка(рез.Штрихкод));
		стрАртикул = СокрЛП(Строка(рез.Артикул));
		стрНоменклатура = СокрЛП(Строка(рез.Номенклатура));
		стрХарактеристика = СокрЛП(Строка(рез.Характеристика));
		стрОстаток = НормализоватьЧисло(рез.Остаток);
		Если ЗначениеЗаполнено(стрШтрихкод) и ЗначениеЗаполнено(стрОстаток) и (рез.Остаток > 0) Тогда
			контент = контент + ?(контент = "","",Символы.ПС)
				+ стрШтрихкод
				+";"
				+ стрАртикул
				+";"
				+ стрНоменклатура
				+";"
				+ стрХарактеристика
				+";"
				+ стрОстаток
			;
		КонецЕсли;
	КонецЦикла;
	
	ФТПСоединение = Новый FTPСоединение("secret_alsav_ftp",21,"secret_alsav_csv_express_office_login","secret_alsav_csv_express_office_password");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла( "txt");
	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент);
	ТекстовыйДок.Записать(ВременныйФайл);
	
	//ФТПСоединение.УстановитьТекущийКаталог("/www/alsav.ru/csv_express_office");
	
	ФТПСоединение.Записать(ВременныйФайл,"alsav_express_office.csv"); 
	УдалитьФайлы(ВременныйФайл);	
КонецФункции

Функция ВыгрузитьПрайс() ЭКСПОРТ
	ВыгрузитьПрайсИОстатка();
	
	возврат 0;
	
	Запрос = новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса_Прайс_();	 
	
	группыНоманклатуры = новый Массив();
	группыНоманклатуры.Добавить(Справочники.Номенклатура.НайтиПоКоду("УТ-00020935"));//1.1 Продукция стандартная     
	Запрос.УстановитьПараметр("группыНоманклатуры",группыНоманклатуры);
	Запрос.УстановитьПараметр("ДатаЗавтра",КонецДня(ТекущаяДата())+1);
	
	контент = "";
	рез = Запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл    
		Если НЕ(Строка(рез.ДР_Активен)="Да") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Строка(рез.ДР_Распродажа)="Да") Тогда
			Продолжить;
		КонецЕсли;
		
		контент = контент + ?(контент = "","",Символы.ПС)
			+ СокрЛП(Строка(рез.Серия))
			+";"
			+ СокрЛП(Строка(рез.ВидНоменклатуры))
			+";"
			+ СокрЛП(Строка(рез.Артикул))
			+";"
			+ СокрЛП(Строка(рез.Номенклатура))
			+";"
			+ СокрЛП(Строка(рез.Характеристика))
			+";"
			+ СокрЛП(Строка(рез.Штрихкод))
			+";"
			+ НормализоватьЧисло(рез.Цена)
		;      
	КонецЦикла;
	
	ФТПСоединение = Новый FTPСоединение("secret_alsav_ftp",21,"secret_csv_alsav_login","secret_csv_alsav_password");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла( "txt");
	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент);
	ТекстовыйДок.Записать(ВременныйФайл);
	
	//ФТПСоединение.УстановитьТекущийКаталог("/csv_alsav");
	
	ФТПСоединение.Записать(ВременныйФайл,"alsav_price.csv"); 
	УдалитьФайлы(ВременныйФайл);

КонецФункции


Функция ВыгрузитьПрайсИОстатка() ЭКСПОРТ
	
	Возврат 0;
	Запрос = новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса_Прайс();	 
	
	группыНоманклатуры = новый Массив();
	группыНоманклатуры.Добавить(Справочники.Номенклатура.НайтиПоКоду("УТ-00020935"));//1.1 Продукция стандартная     
	Запрос.УстановитьПараметр("группыНоманклатуры",группыНоманклатуры);
	Запрос.УстановитьПараметр("ДатаЗавтра",КонецДня(ТекущаяДата())+1);
	
	контент = "";
	рез = Запрос.Выполнить().Выбрать();
	
	мДанные = новый Массив;
	стрШаблон = "Серия,ВидНоменклатуры,Артикул,Номенклатура,Характеристика,Штрихкод,ЕдиницаИзмерения,Остатки,ОтпускнаяЦена";
	
	Пока рез.Следующий() Цикл    
		Если НЕ(Строка(рез.ДР_Активен)="Да") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Строка(рез.ДР_Распродажа)="Да") Тогда
			Продолжить;
		КонецЕсли;               
		
		остаток = 0;
		остаток =  рез.ВНаличии - рез.ВРезерве - рез.КОбеспечению - рез.КОбеспечениюИзСборок;
		
		нСтр = Новый Структура(стрШаблон,
			Строка(СокрЛП(рез.Серия)),
			Строка(СокрЛП(рез.ВидНоменклатуры)),
			Строка(СокрЛП(рез.Артикул)),
			Строка(СокрЛП(рез.Номенклатура)),
			Строка(СокрЛП(рез.Характеристика)), 
			Строка(СокрЛП(рез.Штрихкод)),
			Строка(СокрЛП(рез.ЕдиницаИзмерения)),
			остаток,
			рез.ОтпускнаяЦена
		);
		
		мДанные.Добавить(нСтр);
		
		
		
		//контент = контент + ?(контент = "","",Символы.ПС)
		//	+ СокрЛП(Строка(рез.Серия))
		//	+";"
		//	+ СокрЛП(Строка(рез.ВидНоменклатуры))
		//	+";"
		//	+ СокрЛП(Строка(рез.Артикул))
		//	+";"
		//	+ СокрЛП(Строка(рез.Номенклатура))
		//	+";"
		//	+ СокрЛП(Строка(рез.Характеристика))
		//	+";"
		//	+ СокрЛП(Строка(рез.Штрихкод))
		//	+";"
		//	+ СокрЛП(Строка(рез.ЕдиницаИзмерения))
		//	+";"
		//	+ НормализоватьЧисло(остаток)			
		//	+";"
		//	+ НормализоватьЧисло(рез.ОтпускнаяЦена)
		//	
		//;      
	КонецЦикла;     
	
	контент = МассивСтруктурВCSV(мДанные);

	ФТПСоединение = Новый FTPСоединение("secret_alsav_ftp",21,"secret_csv_alsav_login","secret_csv_alsav_password");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("txt");	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент);
	ТекстовыйДок.Записать(ВременныйФайл);	
	ФТПСоединение.Записать(ВременныйФайл,"ostatki_alsav_price.csv"); 	
	УдалитьФайлы(ВременныйФайл);
	
	
	контент_json = СтруктураВjson(мДанные);
	ВременныйФайл = ПолучитьИмяВременногоФайла("json");	
	ТекстовыйДок = новый ТекстовыйДокумент();
	ТекстовыйДок.УстановитьТекст(контент_json);
	ТекстовыйДок.Записать(ВременныйФайл);	
	ФТПСоединение.Записать(ВременныйФайл,"ostatki_alsav_price.json"); 	
	УдалитьФайлы(ВременныйФайл);                             
КонецФункции

Функция НормализоватьЧисло(ч)
	 Возврат Формат( ч,"ЧГ=0" );
КонецФункции

Функция ПолучитьТекстЗапроса_ХОФФ()
	возврат "   ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДС_ХОФФ.Значение КАК Артикул,
				|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) КАК Остаток
				|ИЗ
				|	(ВЫБРАТЬ
				|		Таблица.Номенклатура КАК Номенклатура,
				|		Таблица.Характеристика КАК Характеристика,
				|		Таблица.Склад КАК Склад,
				|		Таблица.ВНаличии КАК ВНаличии,
				|		0 КАК ПриходОсновной,
				|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
				|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
				|		0 КАК ВРезервеГрафика,
				|		Таблица.КОтгрузке КАК КОтгрузке,
				|		Таблица.КОбеспечению КАК КОбеспечению,
				|		Таблица.КОбеспечениюИзСборок КАК КОбеспечениюИзСборок
				|	ИЗ
				|		(ВЫБРАТЬ
				|			Набор.Номенклатура КАК Номенклатура,
				|			Набор.Характеристика КАК Характеристика,
				|			Набор.Склад КАК Склад,
				|			СУММА(Набор.ВНаличии) КАК ВНаличии,
				|			СУММА(Набор.ВРезервеСоСклада) КАК ВРезервеСоСклада,
				|			СУММА(Набор.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
				|			СУММА(Набор.КОтгрузке) КАК КОтгрузке,
				|			СУММА(Набор.КОбеспечению) КАК КОбеспечению,
				|			СУММА(Набор.КОбеспечениюИзСборок) КАК КОбеспечениюИзСборок
				|		ИЗ
				|			(ВЫБРАТЬ
				|				Таблица.Номенклатура КАК Номенклатура,
				|				Таблица.Характеристика КАК Характеристика,
				|				Таблица.Склад КАК Склад,
				|				Таблица.ВНаличииОстаток КАК ВНаличии,
				|				Таблица.ВРезервеСоСкладаОстаток КАК ВРезервеСоСклада,
				|				Таблица.ВРезервеПодЗаказОстаток КАК ВРезервеПодЗаказ,
				|				0 КАК КОтгрузке,
				|				0 КАК КОбеспечению,
				|				0 КАК КОбеспечениюИзСборок
				|			ИЗ
				|				РегистрНакопления.СвободныеОстатки.Остатки(, {((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
				|			
				|			ОБЪЕДИНИТЬ ВСЕ
				|			
				|			ВЫБРАТЬ
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад,
				|				Таблица.КОтгрузкеОстаток,
				|				0,
				|				0,
				|				Таблица.КОтгрузкеОстаток,
				|				0 КАК КОбеспечению,
				|				0 КАК КОбеспечениюИзСборок
				|			ИЗ
				|				РегистрНакопления.ТоварыКОтгрузке.Остатки(, {((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
				|						        
				|						        
				|						        
				|						        
				|						        
				|			ОБЪЕДИНИТЬ ВСЕ  
				|			
				|			ВЫБРАТЬ
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад,
				|				0,
				|				0,
				|				0,
				|				0,
				|				SUM(Таблица.КоличествоНеобеспечено) КАК КОбеспечению,
				|				0
				|			ИЗ
				|				РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица
				|			{WHERE ((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)), (Склад).*, (Номенклатура).*, (Характеристика).*} 
				|			GROUP BY 
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад
				|			HAVING 
				|				SUM(Таблица.КоличествоНеобеспечено) > 0 
				|				
				|			
				|			ОБЪЕДИНИТЬ ВСЕ  
				|			                    
				|			                    
				|					                    
				|			ВЫБРАТЬ
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад,
				|				0,
				|				0,
				|				0,
				|				0,
				|				0,
				|				SUM(ВТ_ВариантыКомплектацииНоменклатуры.Количество * Таблица.КоличествоНеобеспечено) КАК КОбеспечениюИзСборок
				|			ИЗ
				|			(
				|				ВЫБРАТЬ
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад,
				|					SUM(Таблица.КоличествоНеобеспечено) КАК КоличествоНеобеспечено
				|					
				|				ИЗ
				|					РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица 
				|				GROUP BY 
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад
				|				HAVING 
				|					SUM(Таблица.КоличествоНеобеспечено) > 0
				|			)Таблица
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
				|				ВЫБРАТЬ
				|					ВариантыКомплектацииНоменклатуры.Ссылка КАК Ссылка,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Владелец КАК НоменклатураОсновногоКомпонента,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Характеристика КАК ХарактеристикаОсновногоКомпонента,
				
				|					ЕСТЬNULL(Полуфабрикаты.Номенклатура, ВариантыКомплектацииНоменклатуры.Номенклатура) КАК Номенклатура,
				|					ЕСТЬNULL(Полуфабрикаты.Характеристика, ВариантыКомплектацииНоменклатуры.Характеристика) КАК Характеристика,
				|					ЕСТЬNULL(Полуфабрикаты.Количество, 1) * ВариантыКомплектацииНоменклатуры.Количество КАК Количество,
				|					ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат
				|				ИЗ
				|					Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатуры
				|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Полуфабрикаты
				|						ПО (ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат = ИСТИНА)
				|							И ВариантыКомплектацииНоменклатуры.ВариантКомлектации = Полуфабрикаты.Ссылка
				|							И Полуфабрикаты.Ссылка.ПометкаУдаления = ЛОЖЬ
				|							И Полуфабрикаты.Ссылка.Основной
				|					ГДЕ ВариантыКомплектацииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ И ВариантыКомплектацииНоменклатуры.Ссылка.Основной
				|			) КАК ВТ_ВариантыКомплектацииНоменклатуры
				|				ПО (ВТ_ВариантыКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = Таблица.Номенклатура)
				|					И (ВТ_ВариантыКомплектацииНоменклатуры.Характеристика IS NULL OR ВТ_ВариантыКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента = Таблица.Характеристика) 
				|					
				|			GROUP BY 
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад
				|				        
				|						        
				|						        
				|		
				|		
				|		
				|		) КАК Набор
				|		
				|		СГРУППИРОВАТЬ ПО
				|			Набор.Номенклатура,
				|			Набор.Характеристика,
				|			Набор.Склад) КАК Таблица) КАК Набор
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДС_Серия
				|		ПО (ДС_Серия.Ссылка = Набор.Номенклатура)
				|			И (ДС_Серия.Свойство.Заголовок = ""Серия"")
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДС_ХОФФ
				|		ПО (ДС_ХОФФ.Ссылка = Набор.Характеристика)
				|			И (ДС_ХОФФ.Свойство.Заголовок = ""Артикул HOFF"")
				|
				|ГДЕ Набор.Склад.Наименование = ""Склад адресного хранения""
				|
				|СГРУППИРОВАТЬ ПО
				|	Набор.Характеристика,
				|	ДС_ХОФФ.Значение
				|HAVING 
				|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) > 0";	
КонецФункции


Функция ПолучитьТекстЗапроса_express_office()
	возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Т_Штрихкоды.Штрихкод КАК Штрихкод,
			|	Набор.Номенклатура.Артикул КАК Артикул,
			|	Набор.Номенклатура КАК Номенклатура,
			|	Набор.Характеристика КАК Характеристика,
			|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) КАК Остаток
			|ИЗ
			|	(ВЫБРАТЬ
			|		Таблица.Номенклатура КАК Номенклатура,
			|		Таблица.Характеристика КАК Характеристика,
			|		Таблица.Склад КАК Склад,
			|		Таблица.ВНаличии КАК ВНаличии,
			|		0 КАК ПриходОсновной,
			|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
			|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
			|		0 КАК ВРезервеГрафика,
			|		Таблица.КОтгрузке КАК КОтгрузке,
			|		Таблица.КОбеспечению КАК КОбеспечению,
			|		Таблица.КОбеспечениюИзСборок КАК КОбеспечениюИзСборок
			|	ИЗ
			|		(ВЫБРАТЬ
			|			Набор.Номенклатура КАК Номенклатура,
			|			Набор.Характеристика КАК Характеристика,
			|			Набор.Склад КАК Склад,
			|			СУММА(Набор.ВНаличии) КАК ВНаличии,
			|			СУММА(Набор.ВРезервеСоСклада) КАК ВРезервеСоСклада,
			|			СУММА(Набор.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
			|			СУММА(Набор.КОтгрузке) КАК КОтгрузке,
			|			СУММА(Набор.КОбеспечению) КАК КОбеспечению,
			|			СУММА(Набор.КОбеспечениюИзСборок) КАК КОбеспечениюИзСборок
			|		ИЗ
			|			(ВЫБРАТЬ
			|				Таблица.Номенклатура КАК Номенклатура,
			|				Таблица.Характеристика КАК Характеристика,
			|				Таблица.Склад КАК Склад,
			|				Таблица.ВНаличииОстаток КАК ВНаличии,
			|				Таблица.ВРезервеСоСкладаОстаток КАК ВРезервеСоСклада,
			|				Таблица.ВРезервеПодЗаказОстаток КАК ВРезервеПодЗаказ,
			|				0 КАК КОтгрузке,
			|				0 КАК КОбеспечению,
			|				0 КАК КОбеспечениюИзСборок
			|			ИЗ
			|				РегистрНакопления.СвободныеОстатки.Остатки(, {((Номенклатура, Характеристика) В
			|						    (ВЫБРАТЬ
			|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
			|						        ТаблицаОтбора.Характеристика КАК Характеристика
			|						    ИЗ
			|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
			|						    ГДЕ
			|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
			|			
			|			ОБЪЕДИНИТЬ ВСЕ
			|			
			|			ВЫБРАТЬ
			|				Таблица.Номенклатура,
			|				Таблица.Характеристика,
			|				Таблица.Склад,
			|				Таблица.КОтгрузкеОстаток,
			|				0,
			|				0,
			|				Таблица.КОтгрузкеОстаток,
			|				0,
			|				0
			|			ИЗ
			|				РегистрНакопления.ТоварыКОтгрузке.Остатки(, {((Номенклатура, Характеристика) В
			|						    (ВЫБРАТЬ
			|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
			|						        ТаблицаОтбора.Характеристика КАК Характеристика
			|						    ИЗ
			|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
			|						    ГДЕ
			|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
			|						        
			|						        
			|						        
			|						        
			|						        
			|			ОБЪЕДИНИТЬ ВСЕ  
			|			
			|			ВЫБРАТЬ
			|				Таблица.Номенклатура,
			|				Таблица.Характеристика,
			|				Таблица.Склад,
			|				0,
			|				0,
			|				0,
			|				0,
			|				SUM(Таблица.КоличествоНеобеспечено) КАК КОбеспечению,
			|				0
			|			ИЗ
			|				РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица
			|			{WHERE ((Номенклатура, Характеристика) В
			|						    (ВЫБРАТЬ
			|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
			|						        ТаблицаОтбора.Характеристика КАК Характеристика
			|						    ИЗ
			|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
			|						    ГДЕ
			|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)), (Склад).*, (Номенклатура).*, (Характеристика).*} 
			|			GROUP BY 
			|				Таблица.Номенклатура,
			|				Таблица.Характеристика,
			|				Таблица.Склад
			|			HAVING 
			|				SUM(Таблица.КоличествоНеобеспечено) > 0
			|				        
			|			ОБЪЕДИНИТЬ ВСЕ  
				|			                    
				|			                    
				|					                    
				|			ВЫБРАТЬ
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад,
				|				0,
				|				0,
				|				0,
				|				0,
				|				0,
				|				SUM(ВТ_ВариантыКомплектацииНоменклатуры.Количество * Таблица.КоличествоНеобеспечено) КАК КОбеспечениюИзСборок
				|			ИЗ
				|			(
				|				ВЫБРАТЬ
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад,
				|					SUM(Таблица.КоличествоНеобеспечено) КАК КоличествоНеобеспечено
				|					
				|				ИЗ
				|					РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица 
				|				GROUP BY 
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад
				|				HAVING 
				|					SUM(Таблица.КоличествоНеобеспечено) > 0
				|			)Таблица
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
				|				ВЫБРАТЬ
				|					ВариантыКомплектацииНоменклатуры.Ссылка КАК Ссылка,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Владелец КАК НоменклатураОсновногоКомпонента,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Характеристика КАК ХарактеристикаОсновногоКомпонента,
				
				|					ЕСТЬNULL(Полуфабрикаты.Номенклатура, ВариантыКомплектацииНоменклатуры.Номенклатура) КАК Номенклатура,
				|					ЕСТЬNULL(Полуфабрикаты.Характеристика, ВариантыКомплектацииНоменклатуры.Характеристика) КАК Характеристика,
				|					ЕСТЬNULL(Полуфабрикаты.Количество, 1) * ВариантыКомплектацииНоменклатуры.Количество КАК Количество,
				|					ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат
				|				ИЗ
				|					Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатуры
				|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Полуфабрикаты
				|						ПО (ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат = ИСТИНА)
				|							И ВариантыКомплектацииНоменклатуры.ВариантКомлектации = Полуфабрикаты.Ссылка
				|							И Полуфабрикаты.Ссылка.ПометкаУдаления = ЛОЖЬ
				|							И Полуфабрикаты.Ссылка.Основной
				|					ГДЕ ВариантыКомплектацииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ И ВариантыКомплектацииНоменклатуры.Ссылка.Основной
				|			) КАК ВТ_ВариантыКомплектацииНоменклатуры
				|				ПО (ВТ_ВариантыКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = Таблица.Номенклатура)
				|					И (ВТ_ВариантыКомплектацииНоменклатуры.Характеристика IS NULL OR ВТ_ВариантыКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента = Таблица.Характеристика) 
				|					
				|			GROUP BY 
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад		        
			|						        
			|		
			|		
			|		
			|		) КАК Набор
			|		
			|		СГРУППИРОВАТЬ ПО
			|			Набор.Номенклатура,
			|			Набор.Характеристика,
			|			Набор.Склад) КАК Таблица) КАК Набор
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДС_Серия
			|		ПО (ДС_Серия.Ссылка = Набор.Номенклатура)
			|			И (ДС_Серия.Свойство.Заголовок = ""Серия"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДС_ИмеетВариантКомплектации
			|		ПО (ДС_ИмеетВариантКомплектации.Ссылка = Набор.Номенклатура)
			|			И (ДС_ИмеетВариантКомплектации.Свойство.Заголовок = ""Имеет вариант комплектации"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК Т_Штрихкоды
			|		ПО Набор.Номенклатура = Т_Штрихкоды.Номенклатура
			|			И (Набор.Характеристика ЕСТЬ NULL
			|				ИЛИ Набор.Характеристика = Т_Штрихкоды.Характеристика)
			|ГДЕ
			//|	Набор.Номенклатура В ИЕРАРХИИ(&группыНоманклатуры) И (ДС_ИмеетВариантКомплектации.Значение IS NULL ИЛИ ДС_ИмеетВариантКомплектации.Значение В (&имеетВариантКомплектации))
			|	Набор.Номенклатура В ИЕРАРХИИ(&группыНоманклатуры)
			|   И Набор.Склад.Наименование = ""Склад адресного хранения""
			|СГРУППИРОВАТЬ ПО
			|	Т_Штрихкоды.Штрихкод,
			|	Набор.Номенклатура,
			|	Набор.Характеристика,
			|	Набор.Номенклатура.Артикул
			|HAVING 
			|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) > 0";	
КонецФункции
		
		
Функция ПолучитьТекстЗапроса_Прайс_()
	Возврат "ВЫБРАТЬ //ПЕРВЫЕ 100
	        |	ДР_Серия.Значение КАК Серия,
	        |	Цены.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
