//Функция раскладывает переданный массив ссылок в соответствие по типам этих ссылок
// с учетом необходимости печатать ТТН и ТН по распоряжениям на доставку из менеджера Задания на перевозку
//
//	Параметры:
//		МассивСсылок - Массив - массив ссылок на объекты информационной базы
//  Возвращаемое значение:
//		Соотвествие:
//			Ключ - полное имя типа ссылки
//			Значение - массив ссылок этого типа
//
Функция СоответствиеМассивовПоТипамОбъектовСУчетомДоставки(МассивСсылок) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ДоКлиента)
	|				Или ДанныеДокумента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.СиламиПеревозчикаПоАдресу)
	|			ТОГДА ""Документ.ЗаданиеНаПеревозку""
	|		ИНАЧЕ ""Документ.ПеремещениеТоваров""
	|	КОНеЦ КАК ВидДокумента
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ДоКлиента)
	|				Или ДанныеДокумента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.СиламиПеревозчикаПоАдресу)
	|			ТОГДА ""Документ.ЗаданиеНаПеревозку""
	|		ИНАЧЕ ""Документ.РеализацияТоваровУслуг""
	|	КОНеЦ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УБ_МаршрутныйЛист.Ссылка,
	|	""Документ.УБ_МаршрутныйЛист""
	|ИЗ
	|	Документ.УБ_МаршрутныйЛист КАК УБ_МаршрутныйЛист
	|ГДЕ
	|	УБ_МаршрутныйЛист.Ссылка В(&МассивСсылок)
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка,
	|	""Документ.КорректировкаРеализации""
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.Ссылка В(&МассивСсылок)");
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	СоответствиеТипов = Новый Соответствие;
	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		
		ТекущийТипОбъекта = СоответствиеТипов.Получить(Стр.ВидДокумента);
		Если ТекущийТипОбъекта = Неопределено Тогда
			СоответствиеТипов.Вставить(Стр.ВидДокумента, Новый Массив);
			ТекущийТипОбъекта = СоответствиеТипов.Получить(Стр.ВидДокумента);
		КонецЕсли;
		ТекущийТипОбъекта.Добавить(Стр.Ссылка);
		
	КонецЦикла;
	
	Возврат СоответствиеТипов;
	
КонецФункции


Функция ПолучитьМаршрутныйЛистПоРеализации(вхРеализация)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Маршрут.Ссылка КАК МА
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК Реализация
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УБ_РаспоряжениеНаОтгрузку.Товары КАК РаспоряжениеНаОтгрузку
	               |		ПО Реализация.ЗаказКлиента = РаспоряжениеНаОтгрузку.ЗаказКлиента
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УБ_МаршрутныйЛист.Маршрут КАК Маршрут
	               |		ПО (РаспоряжениеНаОтгрузку.Ссылка = Маршрут.Распоряжение)
	               |ГДЕ
	               |	Реализация.Ссылка = &вхРеализация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Маршрут.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("вхРеализация",вхРеализация);
	
	Рез = ЗАпрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат Рез.МА;
	КонецЕсли;
	
КонецФункции