
Функция ПодготовитьИОтправитьJSON()ЭКСПОРТ  
	//данные = ПолучитьДанные();
	данные = ПолучитьДанныеОтправки();
	json = алсав_ВыгрузкаCsvJson.СтруктураВjson(данные);
	ОтправитьДанные(json);
КонецФункции

Функция ОтправитьДанные(данные)
	//https://prod-vendremains.hoff.ru/VendInventoryReader/
	
	хост = "prod-vendremains.hoff.ru";
	
	Соединение = Новый HTTPСоединение(хост,,,,,,Истина);
	
	ЗаголовокHTTP = новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	
	HTTPЗапрос = Новый HTTPЗапрос("/VendInventoryReader/", ЗаголовокHTTP);
	HTTPЗапрос.УстановитьТелоИзСтроки(данные);
    Результат = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	Сообщить("Код ответа:" + Результат.КодСостояния);
	Сообщить("Тело ответа:" + Результат.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
КонецФункции	

Функция ПолучитьДанныеОтправки()
	резалт = новый Структура();
	резалт.Вставить("supplierId", "80003299");
	резалт.Вставить("dateTime", ТекущаяДата());  
	
	warehouses = новый Массив();
	резалт.Вставить("warehouses", warehouses);     
	
	
	
	warehous = Новый Структура; 
	
	warehouses.Добавить(warehous);
	
	warehous.Вставить("warehouseId", 80003299);
	
	items = новый Массив();
	warehous.Вставить("items", items);
	
	
	////////////////////////////////////////////////////////////////////
	Запрос = ПолучитьЗапрос();	
	////////////////////////////////////////////////////////////////////
	
	рез = запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл		
		стрАртикул = СокрЛП(Строка(рез.Артикул));
		Если ЗначениеЗаполнено(стрАртикул) и (рез.Остаток > 0) Тогда
			item = новый Структура("itemId, quantity", стрАртикул, рез.Остаток); 
			items.Добавить(item);
		КонецЕсли;
	КонецЦикла;
	
	Возврат резалт;
КонецФункции 

Функция ПолучитьТекстЗапроса_ХОФФ()
	возврат "   ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ДС_ХОФФ.Значение КАК Артикул,
				|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) КАК Остаток
				|ИЗ
				|	(ВЫБРАТЬ
				|		Таблица.Номенклатура КАК Номенклатура,
				|		Таблица.Характеристика КАК Характеристика,
				|		Таблица.Склад КАК Склад,
				|		Таблица.ВНаличии КАК ВНаличии,
				|		0 КАК ПриходОсновной,
				|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
				|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
				|		0 КАК ВРезервеГрафика,
				|		Таблица.КОтгрузке КАК КОтгрузке,
				|		Таблица.КОбеспечению КАК КОбеспечению,
				|		Таблица.КОбеспечениюИзСборок КАК КОбеспечениюИзСборок
				|	ИЗ
				|		(ВЫБРАТЬ
				|			Набор.Номенклатура КАК Номенклатура,
				|			Набор.Характеристика КАК Характеристика,
				|			Набор.Склад КАК Склад,
				|			СУММА(Набор.ВНаличии) КАК ВНаличии,
				|			СУММА(Набор.ВРезервеСоСклада) КАК ВРезервеСоСклада,
				|			СУММА(Набор.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
				|			СУММА(Набор.КОтгрузке) КАК КОтгрузке,
				|			СУММА(Набор.КОбеспечению) КАК КОбеспечению,
				|			СУММА(Набор.КОбеспечениюИзСборок) КАК КОбеспечениюИзСборок
				|		ИЗ
				|			(ВЫБРАТЬ
				|				Таблица.Номенклатура КАК Номенклатура,
				|				Таблица.Характеристика КАК Характеристика,
				|				Таблица.Склад КАК Склад,
				|				Таблица.ВНаличииОстаток КАК ВНаличии,
				|				Таблица.ВРезервеСоСкладаОстаток КАК ВРезервеСоСклада,
				|				Таблица.ВРезервеПодЗаказОстаток КАК ВРезервеПодЗаказ,
				|				0 КАК КОтгрузке,
				|				0 КАК КОбеспечению,
				|				0 КАК КОбеспечениюИзСборок
				|			ИЗ
				|				РегистрНакопления.СвободныеОстатки.Остатки(, {((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
				|			
				|			ОБЪЕДИНИТЬ ВСЕ
				|			
				|			ВЫБРАТЬ
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад,
				|				Таблица.КОтгрузкеОстаток,
				|				0,
				|				0,
				|				Таблица.КОтгрузкеОстаток,
				|				0 КАК КОбеспечению,
				|				0 КАК КОбеспечениюИзСборок
				|			ИЗ
				|				РегистрНакопления.ТоварыКОтгрузке.Остатки(, {((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)) КАК Поле2, (Склад).*, (Номенклатура).*, (Характеристика).*}) КАК Таблица
				|						        
				|						        
				|						        
				|						        
				|						        
				|			ОБЪЕДИНИТЬ ВСЕ  
				|			
				|			ВЫБРАТЬ
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад,
				|				0,
				|				0,
				|				0,
				|				0,
				|				SUM(Таблица.КоличествоНеобеспечено) КАК КОбеспечению,
				|				0
				|			ИЗ
				|				РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица
				|			{WHERE ((Номенклатура, Характеристика) В
				|						    (ВЫБРАТЬ
				|						        ТаблицаОтбора.Номенклатура КАК Номенклатура,
				|						        ТаблицаОтбора.Характеристика КАК Характеристика
				|						    ИЗ
				|						        ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				|						    ГДЕ
				|						        ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &ИспользуетсяОтборПоСегментуНоменклатуры)), (Склад).*, (Номенклатура).*, (Характеристика).*} 
				|			GROUP BY 
				|				Таблица.Номенклатура,
				|				Таблица.Характеристика,
				|				Таблица.Склад
				|			HAVING 
				|				SUM(Таблица.КоличествоНеобеспечено) > 0 
				|				
				|			
				|			ОБЪЕДИНИТЬ ВСЕ  
				|			                    
				|			                    
				|					                    
				|			ВЫБРАТЬ
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад,
				|				0,
				|				0,
				|				0,
				|				0,
				|				0,
				|				SUM(ВТ_ВариантыКомплектацииНоменклатуры.Количество * Таблица.КоличествоНеобеспечено) КАК КОбеспечениюИзСборок
				|			ИЗ
				|			(
				|				ВЫБРАТЬ
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад,
				|					SUM(Таблица.КоличествоНеобеспечено) КАК КоличествоНеобеспечено
				|					
				|				ИЗ
				|					РегистрНакопления.ГрафикОтгрузкиТоваров AS Таблица 
				|				GROUP BY 
				|					Таблица.Номенклатура,
				|					Таблица.Характеристика,
				|					Таблица.Склад
				|				HAVING 
				|					SUM(Таблица.КоличествоНеобеспечено) > 0
				|			)Таблица
				|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
				|				ВЫБРАТЬ
				|					ВариантыКомплектацииНоменклатуры.Ссылка КАК Ссылка,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Владелец КАК НоменклатураОсновногоКомпонента,
				|					ВариантыКомплектацииНоменклатуры.Ссылка.Характеристика КАК ХарактеристикаОсновногоКомпонента,
				
				|					ЕСТЬNULL(Полуфабрикаты.Номенклатура, ВариантыКомплектацииНоменклатуры.Номенклатура) КАК Номенклатура,
				|					ЕСТЬNULL(Полуфабрикаты.Характеристика, ВариантыКомплектацииНоменклатуры.Характеристика) КАК Характеристика,
				|					ЕСТЬNULL(Полуфабрикаты.Количество, 1) * ВариантыКомплектацииНоменклатуры.Количество КАК Количество,
				|					ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат
				|				ИЗ
				|					Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатуры
				|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Полуфабрикаты
				|						ПО (ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат = ИСТИНА)
				|							И ВариантыКомплектацииНоменклатуры.ВариантКомлектации = Полуфабрикаты.Ссылка
				|							И Полуфабрикаты.Ссылка.ПометкаУдаления = ЛОЖЬ
				|							И Полуфабрикаты.Ссылка.Основной
				|					ГДЕ ВариантыКомплектацииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ И ВариантыКомплектацииНоменклатуры.Ссылка.Основной
				|			) КАК ВТ_ВариантыКомплектацииНоменклатуры
				|				ПО (ВТ_ВариантыКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = Таблица.Номенклатура)
				|					И (ВТ_ВариантыКомплектацииНоменклатуры.Характеристика IS NULL OR ВТ_ВариантыКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента = Таблица.Характеристика) 
				|					
				|			GROUP BY 
				|				ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура,
				|				ВТ_ВариантыКомплектацииНоменклатуры.Характеристика,
				|				Таблица.Склад
				|				        
				|						        
				|						        
				|		
				|		
				|		
				|		) КАК Набор
				|		
				|		СГРУППИРОВАТЬ ПО
				|			Набор.Номенклатура,
				|			Набор.Характеристика,
				|			Набор.Склад) КАК Таблица) КАК Набор
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДС_Серия
				|		ПО (ДС_Серия.Ссылка = Набор.Номенклатура)
				|			И (ДС_Серия.Свойство.Заголовок = ""Серия"")
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДС_ХОФФ
				|		ПО (ДС_ХОФФ.Ссылка = Набор.Характеристика)
				|			И (ДС_ХОФФ.Свойство.Заголовок = ""Артикул HOFF"")
				|
				|ГДЕ Набор.Склад.Наименование = ""Склад адресного хранения""
				|
				|СГРУППИРОВАТЬ ПО
				|	Набор.Характеристика,
				|	ДС_ХОФФ.Значение
				|HAVING 
				|	СУММА(Набор.ВНаличии) - (СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика)) - СУММА(Набор.КОбеспечению) - СУММА(Набор.КОбеспечениюИзСборок) > 0";	
КонецФункции

