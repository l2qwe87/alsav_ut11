&НаКлиенте
Процедура ПерейтиКЗакгрузке(Команда)
	ПерейтиКЗакгрузкеСервер();
КонецПроцедуры

&НаСервере
Процедура ПерейтиКЗакгрузкеСервер()
	ЭтаФорма.Элементы.ГруппаНастройкаСвойств.Видимость = Ложь;
	ЭтаФорма.Элементы.ГруппаПродолжить.Видимость = НЕ ЭтаФорма.Элементы.ГруппаНастройкаСвойств.Видимость;
	
	ОбластьУдаления = ЭтаФорма.ДанныеДляЗагрузки.Область(, 3, , 50);
	Смещать = ТипСмещенияТабличногоДокумента.ПоГоризонтали;
	ЭтаФорма.ДанныеДляЗагрузки.УдалитьОбласть(ОбластьУдаления, Смещать);
	
	столбецСвойств = 3;
	Для Каждого стр из Этаформа.ДопРеквизиты Цикл
		
		Если стр.Выбрать Тогда		
			ЭтаФорма.ДанныеДляЗагрузки.Область(1,столбецСвойств).Текст = стр.Свойство;
			столбецСвойств = столбецСвойств + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

