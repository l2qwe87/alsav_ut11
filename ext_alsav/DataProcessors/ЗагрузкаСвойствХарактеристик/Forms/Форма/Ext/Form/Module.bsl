&НаКлиенте
Процедура Сопоставить(Команда)
	
	цветУспеха = Новый Цвет(0, 255, 127);
	инд = 1;
	Пока инд < 62999 Цикл
		инд = инд + 1;
		
		наименованиеНоменклатуры = СокрЛП(ЭтаФорма.ДанныеДляЗагрузки.Область(инд,1).Текст);
		Если НЕ ЗначениеЗаполнено(наименованиеНоменклатуры) Тогда
			Прервать;
		КонецЕсли;
		
		наименованиеХарактеристики = ЭтаФорма.ДанныеДляЗагрузки.Область(инд,2).Текст;
		
		номен = НайтиНоменклатуру(наименованиеНоменклатуры, ЭтаФорма.ПоискПоАртикулу);
		
		Если НЕ ЗначениеЗаполнено(номен) Тогда
			продолжить;
		КонецЕсли;
		ЭтаФорма.ДанныеДляЗагрузки.Область(инд,1).ЦветФона = цветУспеха;
		
		хар = НайтХарактеристику(номен,наименованиеХарактеристики);		
		
		Если НЕ ЗначениеЗаполнено(хар) Тогда
			продолжить;
		КонецЕсли;
		ЭтаФорма.ДанныеДляЗагрузки.Область(инд,2).ЦветФона = цветУспеха;
		
		//Сообщить(Номен);
		//Сообщить(Хар);
		
		
		кол = 3;
		Пока кол <=30 Цикл
			свойство = ЭтаФорма.ДанныеДляЗагрузки.Область(1,кол).Текст;
			значениеТекст = ЭтаФорма.ДанныеДляЗагрузки.Область(инд,кол).Текст;
			значение = ОпределитьЗначениеСвойства(Свойство,значениеТекст);
			
			Если ЗначениеЗаполнено(свойство) Тогда 
				Если ЗначениеЗаполнено(значение) ИЛИ НЕ ЗначениеЗаполнено(значениеТекст) Тогда
					УстановитьЗначениеДопРеквизита(хар,Свойство,Значение);				
					ЭтаФорма.ДанныеДляЗагрузки.Область(инд,кол).ЦветФона = цветУспеха;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
			кол = кол + 1;
		КонецЦикла;		
		
		//ЭтаФорма.ДанныеДляЗагрузки.Область(инд,1).Значение = номен;
		//ЭтаФорма.ДанныеДляЗагрузки.Область(инд,2).Значение = хар;
		
		//Сообщить(номен);
		//Сообщить(хар); 		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьЗначениеСвойства(Свойство,Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		возврат неопределено;
	КонецЕсли;
	
	результ = Значение;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	               |ГДЕ
	               |	ЗначенияСвойствОбъектов.Владелец.Заголовок = &Заголовок
	               |	И ЗначенияСвойствОбъектов.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Заголовок",Свойство);
	Запрос.УстановитьПараметр("Наименование",Значение);
	
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		результ = рез.Ссылка;
	Иначе
		допРеквизит = алсав_ДопРеквизиты.НайтиДопРеквизит(Свойство);
		Если ЗначениеЗаполнено(допРеквизит) Тогда
			Если(допРеквизит.ДополнительныеЗначенияИспользуются) Тогда
				результ = неопределено;
			КонецЕсли;
		Иначе
			результ = неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат результ;
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьЗначениеДопРеквизита(ссылка,Свойство,Значение)
	
	об = ссылка.ПолучитьОбъект();
	алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(об,Свойство,Значение);
	
	об.Записать();
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиНоменклатуру(наименованиеНоменклатуры, поискПоАртикулу)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Наименование = &наименованиеНоменклатуры";
	
	Запрос.УстановитьПараметр("наименованиеНоменклатуры", наименованиеНоменклатуры);
	
	Если поискПоАртикулу Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".Наименование", ".Артикул");
	конецЕсли;
	
	рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат рез.Ссылка;
	КонецЕсли;
КонецФУнкции


&НаСервереБезКонтекста
Функция НайтХарактеристику(НоменклатураВладелец, наименованиеХарактеристики)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Наименование ПОДОБНО &наименованиеХарактеристики
	               |	И ХарактеристикиНоменклатуры.Владелец = &НоменклатураВладелец";
	
	Запрос.УстановитьПараметр("НоменклатураВладелец", НоменклатураВладелец);
	Запрос.УстановитьПараметр("наименованиеХарактеристики", наименованиеХарактеристики);
	
	рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат рез.Ссылка;
	КонецЕсли;
КонецФУнкции

