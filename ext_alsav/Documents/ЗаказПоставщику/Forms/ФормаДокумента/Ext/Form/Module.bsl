&НаСервере
Процедура алсав_ОбъединитьОдинаковыеПозицииПослеНаСервере()
	// Вставить содержимое обработчика.
	тч = ЭтаФорма.Объект.Товары.Выгрузить();
	ЭтаФорма.Объект.Товары.Очистить();
	
	//тч.Свернуть(
	//	"НоменклатураПартнера, Номенклатура, Характеристика, Упаковка, Цена, СтавкаНДС",
	//	"КоличествоУпаковок, Количество, Сумма, СуммаНДС, СуммаСНДС"
	//);
	
	инд = тч.Количество()-1;
	Пока инд>0 Цикл
		стр = тч[инд];
		ф = 0;
		Пока ф < инд цикл
			нСтр = тч[ф];
			
			Если нСтр.Номенклатура = стр.Номенклатура и нСтр.Характеристика = стр.Характеристика Тогда
				нСтр.Количество = нСтр.Количество + стр.Количество;
				нСтр.КоличествоУпаковок = нСтр.КоличествоУпаковок + стр.КоличествоУпаковок;
				нСтр.Сумма = нСтр.Сумма + стр.Сумма;
				нСтр.СуммаНДС = нСтр.СуммаНДС + стр.СуммаНДС;
				нСтр.СуммаСНДС = нСтр.СуммаСНДС + стр.СуммаСНДС;
				тч.Удалить(стр);
				break;
			КонецЕсли;			
			ф = ф + 1
		КонецЦикла;	
		
		инд = инд - 1;
	КонецЦикла;
	
	ЭтаФорма.Объект.Товары.Загрузить(тч); 
КонецПроцедуры


