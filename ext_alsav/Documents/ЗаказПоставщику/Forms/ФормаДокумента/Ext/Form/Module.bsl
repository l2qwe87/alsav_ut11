	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура алсав_СоздатьСписаниеМатериаловПосле(Команда)
	// Вставить содержимое обработчика.
	
	мКСписанию = алсав_ПолучитьМаетиралыДляСписания(Объект.Ссылка);
	
	мФорма = ПолучитьФорму("Документ.СписаниеНедостачТоваров.ФормаОбъекта");
	ДанныеФормы = мФорма.Объект;	
	ДанныеФормы.Дата = ТекущаяДата();
	//ДанныеФормы.Основание = ЭтаФорма.Объект.Ссылка;
	ДанныеФормы.ЗаказПоставщику = ЭтаФорма.Объект.Ссылка;
	
	Для каждого стр из мКСписанию Цикл
		нСтр = ДанныеФормы.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(нСтр, стр);
	КонецЦикла;
	
	мФорма.Открыть();
КонецПроцедуры


&НаСервереБезКонтекста
Функция алсав_ПолучитьМаетиралыДляСписания(ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Т.Номенклатура КАК Номенклатура,
	               |	Т.Характеристика КАК Характеристика,
	               |	СУММА(Т.Всего) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_Заказы.Ссылка КАК ЗаказПоставщику,
	               |		комплектация.Номенклатура.Артикул КАК Артикул,
	               |		комплектация.Номенклатура КАК Номенклатура,
	               |		комплектация.Характеристика КАК Характеристика,
	               |		комплектация.Упаковка КАК Упаковка,
	               |		комплектация.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат,
	               |		ВТ_Заказы.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
	               |		комплектация.Количество КАК Количество,
	               |		ВТ_Заказы.КоличествоУпаковок КАК КоличествоРодитель,
	               |		комплектация.Количество * ВТ_Заказы.КоличествоУпаковок КАК Всего
	               |	ИЗ
	               |		Документ.ЗаказПоставщику.Товары КАК ВТ_Заказы
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК комплектация
	               |			ПО (комплектация.Ссылка = ВТ_Заказы.ВариантКомплектацииНоменклатуры)
	               |	ГДЕ
	               |		ВТ_Заказы.Ссылка = &ЗаказПоставщику) КАК Т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Т.Характеристика,
	               |	Т.Номенклатура";
	
	Запрос.УстановитьПараметр("ЗаказПоставщику",ссылка);
	
	
	прототип = "Номенклатура,Характеристика,Количество";
	результ = новый Массив;
	рез = Запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл
		списатьМатериалы = алсав_ДопРеквизиты.ПолучитьДопРеквизит(рез.Номенклатура,"Списывать материалы");
		Если (списатьМатериалы = Истина)ИЛИ(Строка(списатьМатериалы) = "Да") Тогда
			стр = Новый Структура(прототип);
			ЗаполнитьЗначенияСвойств(стр, рез);
			результ.Добавить(стр);
		КонецЕсли;
	КонецЦикла;
	Возврат результ;
КонецФункции

