	алсав_ПроверитьТовары_ИмеетВарианткомплектации();
КонецПроцедуры


&НаСервере
Процедура алсав_ПроверитьТовары_ИмеетВарианткомплектации()
	// Вставить содержимое обработчика.
	
	естьОшибка = Ложь;
	
	Для каждого стр из Объект.Товары Цикл
		естьВариант = алсав_ДопРеквизиты.ПолучитьДопРеквизит(стр.Номенклатура,"Имеет вариант комплектации");
		Если естьВариант = Истина Тогда
			естьОшибка = истина;
			Сообщить("Номенклатура имеет вариант комплектации - ["+стр.Номенклатура+"]");
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.естьКомплектУпаковка.Видимость = естьОшибка;
	
	
	особКомпл = "";
	особКомпл = ПолучитьОсобКомпл();

	Для каждого стр из Объект.Товары Цикл
		данныеПоВариантукомплектации =  получитьВариантКомплектации(   
				стр.Номенклатура,
			    стр.Характеристика,
				особКомпл
			);
		стр.КоличествоВариантовКомплектацииНоменклатуры = данныеПоВариантукомплектации.КоличествоВариантовКомплектацииНоменклатуры;
	КонецЦикла;
	
КонецПроцедуры

