&НаКлиенте
Функция СформироватьОтчет_ВО_МатериалыПоЗаданию(имяВарианта, СписыватьМатериалы = неопределено)
	ПараметрыОтчета = Новый Структура;
    ПараметрыОтчета.Вставить("ВидРасшифровки"         , 1);
	ПараметрыОтчета.Вставить("СформироватьПриОткрытии", Истина);
	
	ф = ПолучитьФорму("Отчет.ВО_МатериалыПоЗаданию.Форма", ПараметрыОтчета, ЭтаФорма, Истина);
	ф.УстановитьТекущийВариант(имяВарианта);                                              	
	
	КомпоновщикНастроек = ф.Отчет.КомпоновщикНастроек;
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	Для Каждого элемент из ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Если Строка(элемент.Параметр) = "ЗаказПоставщику" Тогда
				элемент.Значение = Объект.Ссылка;
				элемент.Использование = Истина;
			ИначеЕсли (Строка(элемент.Параметр) = "СписыватьМатериалы") и (СписыватьМатериалы <> неопределено) Тогда
					
				св = ПолучитьЗначенияСписыватьМатериалы(СписыватьМатериалы);				
				сп = Новый СписокЗначений;
				сп.ЗагрузитьЗначения(св);
				
				элемент.Значение = сп;
				элемент.Использование = Истина;
			Иначе
				элемент.Использование = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	ф.Открыть();
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьЗначенияСписыватьМатериалы(СписыватьМатериалы)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ  Справочник.ЗначенияСвойствОбъектов ГДЕ Наименование = """+СписыватьМатериалы+""" И Владелец.Заголовок = ""Списывать материалы""";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции


&НаСервере
&После("УстановитьУсловноеОформление")
Процедура алсав_УстановитьУсловноеОформление()
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыВариантКомплектацииНоменклатуры.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.КоличествоВариантовКомплектацииНоменклатуры");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЭлемента.ПравоеЗначение = 1;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.СобытиеОтказ);

КонецПроцедуры


