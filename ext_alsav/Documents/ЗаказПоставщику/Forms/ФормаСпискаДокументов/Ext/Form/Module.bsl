КонецПроцедуры

&НаКлиенте
Процедура алсав_ОчиститьНомерПакетаЗаданийПослеЗавершение(Результат, ДополнительныеПараметры) ЭКСПОРТ
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		алсав_ОчиститьСвойствоСерверПосле("Номер пакета заданий");
		ЭтаФорма.Элементы.Список.Обновить();
	КонецЕсли;
			   
КонецПроцедуры

&НаСервере
Процедура алсав_ОчиститьСвойствоСерверПосле(имяСвойства)
	очереднойНомер = неопределено; 
	заказы = ПолучитьЗаказ();
	НачатьТранзакцию();
	Для Каждого заказПоставщику Из заказы Цикл
		
		Если ЛОЖЬ Тогда заказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка(); КонецЕсли;
		
		об = заказПоставщику.ПолучитьОбъект();
		алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(об, имяСвойства, очереднойНомер);
		об.ОбменДанными.Загрузка = Истина;
		об.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры


&НаКлиенте
Процедура алсав_алсав_ОчиститьНомерПакетаХДФПосле(Команда)
		всегоВыбранно = ЭтаФорма.Элементы.Список.ВыделенныеСтроки.Количество();
	ТекстВопроса = НСтр("ru = 'Вы уверены что хотите очистить Номер пакета заданий у выбранных заказов ("+всегоВыбранно+")?'");
	           Оповещение = Новый ОписаниеОповещения("алсав_ОчиститьНомерПакетаХДФПослеЗавершение", ЭтотОбъект);
	           ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры
&НаКлиенте
Процедура алсав_ОчиститьНомерПакетаХДФПослеЗавершение(Результат, ДополнительныеПараметры) ЭКСПОРТ
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		алсав_ОчиститьСвойствоСерверПосле("Номер пакета ХДФ");
		ЭтаФорма.Элементы.Список.Обновить();
	КонецЕсли;
			   
КонецПроцедуры




