&НаСервере
Процедура алсав_УстановитьОчереднойСвойствоСерверПосле(имяСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ДопРекв.Значение) КАК Последний
	               |ИЗ
	               |	Документ.ЗаказПоставщику.ДополнительныеРеквизиты КАК ДопРекв
	               |ГДЕ
	               |	ДопРекв.Свойство.Заголовок = &имяСвойства";
	
	Запрос.УстановитьПараметр("имяСвойства",имяСвойства);
	
	
	рез = Запрос.Выполнить().Выбрать();
	
	последнийНомер = 0;
	Если рез.Следующий() Тогда 
		Попытка
			последнийНомер = Число(рез.Последний);
		Исключение КонецПопытки;
	КонецЕсли;
	
	очереднойНомер = последнийНомер + 1;
	
	заказы = ПолучитьЗаказ();
	НачатьТранзакцию();
	Для Каждого заказПоставщику Из заказы Цикл
		
		Если ЛОЖЬ Тогда заказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка(); КонецЕсли;
		
		об = заказПоставщику.ПолучитьОбъект();
		алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(об, имяСвойства, очереднойНомер);
		об.ОбменДанными.Загрузка = Истина;
		об.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры




