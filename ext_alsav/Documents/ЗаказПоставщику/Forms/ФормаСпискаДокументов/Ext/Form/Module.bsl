&НаКлиенте
Процедура Обработчик_Выгрузки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт 

	ТипМассив = Тип("Массив");

	Если (ТипЗнч(ВыбранныеФайлы) = ТипМассив)
			И (ВыбранныеФайлы.Количество() > 0) Тогда

		ИмяФайла = ВыбранныеФайлы[0];
		Если НЕ ПустаяСтрока(ИмяФайла) Тогда
			
			мВариантыКомплектации = Новый Массив;
			мТовары = ПолучитьТовары();
			Для Каждого стр из мТовары Цикл
				Если ЗначениеЗаполнено(стр.ВариантКомплектацииНоменклатуры) Тогда
					Если мВариантыКомплектации.Найти(стр.ВариантКомплектацииНоменклатуры) = неопределено Тогда
						мВариантыКомплектации.Добавить(стр.ВариантКомплектацииНоменклатуры);
					конецЕсли;
				Иначе
					Сообщить("Не заполнен вариант комплектации в строке "+стр.НомерСтроки);
				КонецЕсли;
			КонецЦикла;
			соотвествиеФайлов = алсав_ПолучитьИменяФайловБазис(мВариантыКомплектации);
			Если ЛОЖЬ Тогда соотвествиеФайлов = новый Соответствие(); конецЕсли;
			
			файлы = новый Массив;	
			Для Каждого стр из мТовары Цикл
				
				Если ЗначениеЗаполнено(стр.ВариантКомплектацииНоменклатуры) Тогда
					полныйПутьКФайлу = соотвествиеФайлов.Получить(стр.ВариантКомплектацииНоменклатуры);
					Если полныйПутьКФайлу<>неопределено Тогда
						файлИнфо = новый Файл(соотвествиеФайлов.Получить(стр.ВариантКомплектацииНоменклатуры));
						файлы.Добавить(Новый Структура("Type,Name,SubName,Sign,Note,Comment,Count",
							5,
							соотвествиеФайлов.Получить(стр.ВариантКомплектацииНоменклатуры),
							Неопределено,
							файлИнфо.ИмяБезРасширения,
							Неопределено,
							Неопределено,
							Формат(стр.Количество,"ЧГ=0")
						));   
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			ListFiles = новый Структура("File",файлы);
			CuttingInfo = новый  Структура("Parameters,ProductCount",Неопределено,1); ;
			
			DataProject = новый Структура;
			DataProject.Вставить("ListFiles",ListFiles);
			DataProject.Вставить("CuttingInfo",CuttingInfo);
			DataProject.Вставить("EstimateInfo",Неопределено);
			
			
			Document = новый Структура;
			Document.Вставить("DataProject", DataProject);
			
			проект = новый Структура;
			проект.Вставить("Document", Document);
			 	
			
			ЗаписьXML = Новый ЗаписьXML; 
			ЗаписьXML.УстановитьСтроку();
			
			ToXML(ЗаписьXML,проект);
			
			xml = ЗаписьXML.Закрыть();
			
			тд = Новый ТекстовыйДокумент();
			тд.УстановитьТекст(xml);
			//тд.Показать(Объект.Номер);
			
			тд.Записать(ИмяФайла);
			
			Сообщить("Файл сформирован: "+ИмяФайла)
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Функция ToXML(ЗаписьXML, эл)
	Если ТипЗнч(эл) = Тип("Структура") Тогда
		Если ЛОЖЬ Тогда эл = Новый Структура; КонецЕсли;
		Для Каждого ф из эл Цикл
			Если ТипЗнч(ф.Значение)=Тип("Массив") Тогда
				Для каждого б из ф.Значение Цикл
					ЗаписьXML.ЗаписатьНачалоЭлемента(ф.Ключ);	
					ToXML(ЗаписьXML,б);
					ЗаписьXML.ЗаписатьКонецЭлемента();
				КонецЦикла;
			иначе
				
				ЗаписьXML.ЗаписатьНачалоЭлемента(ф.Ключ);	
				ToXML(ЗаписьXML,ф.Значение);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			
			КонецЕсли;
			
		КонецЦикла;		
	//ИначеЕсли ТипЗнач(эл)=Тип("Массив") Тогда
	//	Если ЛОЖЬ Тогда эл = Новый Массив; КонецЕсли;
	Иначе
		ЗаписьXML.ЗаписатьТекст(строка(эл));
	конецЕсли;
КонецФункции


&НаСервере
Функция ПолучитьЗаказ()
	мЗаказы = новый Массив;
	Для Каждого заказПоставщику Из ЭтаФорма.Элементы.Список.ВыделенныеСтроки Цикл
		мЗаказы.Добавить(заказПоставщику);
	КонецЦикла;
	
	Возврат мЗаказы;
КонецФункции

&НаСервере
Функция ПолучитьТовары()
	заказы = ПолучитьЗаказ();
	ЗАпрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказПоставщикуТовары.Характеристика КАК Характеристика,
	               |	ЗаказПоставщикуТовары.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
	               |	СУММА(ЗаказПоставщикуТовары.Количество) КАК Количество
	               |ИЗ
	               |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	               |ГДЕ
	               |	ЗаказПоставщикуТовары.Ссылка В(&заказы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПоставщикуТовары.ВариантКомплектацииНоменклатуры,
	               |	ЗаказПоставщикуТовары.Номенклатура,
	               |	ЗаказПоставщикуТовары.Характеристика";
	Запрос.УстановитьПараметр("Заказы",заказы);
	тз = Запрос.Выполнить().Выгрузить();
	результ = ОбщегоНазначения.ТаблицаЗначенийВМассив(тз);
	Возврат результ;
КонецФункции

