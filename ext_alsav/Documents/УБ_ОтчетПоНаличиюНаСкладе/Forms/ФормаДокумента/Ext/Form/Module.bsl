Функция получитьОтчетПоНаличиюНаСкладе() 
	Возврат ЭтотОбъект.Объект.Ссылка;
КонецФункции


Функция получитьСклад() 
	результ = ""; 
	Для Каждого стрСклад из Объект.Склады Цикл
		результ = результ + " " + стрСклад.Склад;
	КонецЦикла;			
	Возврат результ;	
КонецФункции
Функция получитьДатаОтгрузки()
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОтгрузки) Тогда
		ВызватьИсключение "Не заполнено поле [Дата отгрузки]" ;
	КонецЕсли;
	
	возврат Объект.ДатаОтгрузки;	
КонецФункции

&НаСервере
Функция ПроверкаСкладаУЗаказаов()
	Если Объект.Склады.Количество() <> 1 Тогда
		возврат 0;//ВызватьИсключение "Склад должен быть один";
	КонецЕсли;
	
	основнойСклад = Справочники.Склады.НайтиПоНаименованию("Основной склад");
	основнойСкладЗонаСборки = Справочники.Склады.НайтиПоНаименованию("Зона сборки (Основной слад)");
	
	склад = Объект.Склады[0].Склад;
	Если склад = основнойСкладЗонаСборки Тогда 
		склад = основнойСклад;
	КонецЕсли;
		
		
	инд = 0 ;
	ОшибкаСклад = Ложь;
	
	Для Каждого стр из Объект.Заказы Цикл
		инд = инд + 1;
		
		стр.ОшибкаСклад = Ложь;		
		
		стр.Склад = стр.Заказ.Склад; 		
		
		складВЗаказе = стр.Заказ.Склад;
		Если складВЗаказе = основнойСкладЗонаСборки Тогда 
			складВЗаказе = основнойСклад;
		КонецЕсли;

		Если складВЗаказе <> склад Тогда
			стр.ОшибкаСклад = Истина;
			ОшибкаСклад = Истина;
			Сообщить("Склад в заказе ("+инд+") ["+стр.Заказ+"] не совпадет со складом в документе "+склад);
		КонецЕсли;
	КонецЦикла;
КонецФункции

