&НаКлиенте
Процедура алсав_ЗаполнитьЗаказНеТрожьПосле(Команда)
	// Вставить содержимое обработчика.
	
	ссылкаЗаказФантом = получитьЗаказФантом();
	формаЗаказа = ПолучитьФорму("Документ.ЗаказКлиента.ФормаОбъекта", новый Структура("Ключ",ссылкаЗаказФантом));
	формаЗаказа.Объект.Товары.Очистить();
	
	
	мЗаказы = новый Массив;
	Для Каждого стр из Объект.Заказы Цикл
		мЗаказы.Добавить(стр.Заказ);
	КонецЦикла;
	мНоменклатура = ПолучитьТоварыИзЗаказов(мЗаказы);
	формаЗаказа.ДобавитьПозиции(мНоменклатура);
	
	формаЗаказа.Открыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция получитьЗаказФантом()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	док.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказКлиента КАК док
	               |ГДЕ
	               |	док.Комментарий ПОДОБНО ""%#НЕ ТРОЖЬ!#%""";
	
	рез = Запрос.Выполнить().Выбрать();
	Рез.Следующий();
	Возврат рез.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТоварыИзЗаказов(мЗаказы)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.Характеристика КАК Характеристика,НоменСерия.Свойство,НоменСерия.Значение
	               |ИЗ
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменСерия
	               |		ПО ЗаказКлиентаТовары.Номенклатура = НоменСерия.Ссылка
	               |			И (НоменСерия.Свойство.Заголовок = ""Серия"")
	               |			И (НоменСерия.Значение.Наименование = ""Нестандарт"")
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Ссылка В(&мЗаказы) AND НоменСерия.Значение.Наименование IS NOT NULL";
	
	Запрос.УстановитьПараметр("мЗаказы",мЗаказы);
	
	
	Рез = Запрос.Выполнить().Выбрать();
	
	результ = новый Массив;
	
	Пока рез.Следующий() Цикл
		стр = Новый Структура("Номенклатура,Характеристика");
		ЗаполнитьЗначенияСвойств(стр, рез);
		результ.Добавить(стр);
	конецЦикла;
	
	возврат результ;
	
КонецФУнкции