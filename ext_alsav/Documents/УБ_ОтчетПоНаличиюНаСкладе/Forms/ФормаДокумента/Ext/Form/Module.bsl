
&НаКлиенте
Процедура алсав_алсав_ОтчетУпаковачныйЛистПосле(Команда)
	ПроверкаСкладаУЗаказаов();
	
	ПараметрыОтчета = Новый Структура;
    ПараметрыОтчета.Вставить("ВидРасшифровки"         , 1);
    ПараметрыОтчета.Вставить("СформироватьПриОткрытии", Истина);
    
	
	ф = ПолучитьФорму("Отчет.ВО_УпаковочныеЛисты.Форма", ПараметрыОтчета, ЭтаФорма, Истина);
	ф.УстановитьТекущийВариант("ВО_УпаковочныеЛисты");
	КомпоновщикНастроек = ф.Отчет.КомпоновщикНастроек;
	
	списокЗаказов = получитьСписокЗаказов();	
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	Для Каждого элемент из ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			
			Если Строка(элемент.Параметр) = "ОтчетПоНаличиюНаСкладе" Тогда
				элемент.Значение = получитьОтчетПоНаличиюНаСкладе();
				элемент.Использование = истина;
			КонецЕсли;
			
			Если Строка(элемент.Параметр) = "Склад" Тогда
				элемент.Значение = получитьСклад();
				элемент.Использование = истина;
			КонецЕсли;
			
			Если Строка(элемент.Параметр) = "ДатаОтгрузки" Тогда
				элемент.Значение = получитьДатаОтгрузки();
				элемент.Использование = истина;
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЦикла;  
	ф.Открыть();

КонецПроцедуры

