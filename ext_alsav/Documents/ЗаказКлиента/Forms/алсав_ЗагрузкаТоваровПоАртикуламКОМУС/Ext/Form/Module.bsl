
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Данные.Область(1, 1, 1, 1).Текст = "Артикул Комус";
	Данные.Область(1, 2, 1, 2).Текст = "Количество";
	Данные.Область(1, 3, 1, 3).Текст = "Цена";
	Данные.ФиксацияСверху = 1;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВЗаказ(Команда)

	СтрокиДанных = Новый Массив;

	НомерСтроки = 2;
	Пока СокрЛП(Данные.Область(НомерСтроки, 1, НомерСтроки, 1).Текст) <> "" Цикл

		Артикул = СокрЛП(СтрЗаменить(Данные.Область(НомерСтроки, 1, НомерСтроки, 1).Текст, Символ(160), ""));
		Количество = ТекстВЧисло(Данные.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		Цена = ТекстВЧисло(Данные.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);

		СтрокиДанных.Добавить(Новый Структура("Артикул,Количество,Цена", Артикул, Количество, Цена));

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Если СтрокиДанных.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Таблица не заполнена. Вставьте данные, начиная со второй строки.'"));
		Возврат;
	КонецЕсли;

	АдресДанныхВХранилище = ПоместитьВоВременноеХранилище(СтрокиДанных);
	ОповеститьОВыборе(Новый Структура("АдресДанныхВХранилище", АдресДанныхВХранилище));

КонецПроцедуры

&НаКлиенте
Функция ТекстВЧисло(Знач Текст)

	Текст = СтрЗаменить(СокрЛП(Текст), Символ(160), "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Текст);

КонецФункции
