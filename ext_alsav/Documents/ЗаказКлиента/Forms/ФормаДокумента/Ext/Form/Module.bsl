&НаКлиенте
Процедура ВыборФайлаXML_ZKЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
		
		ф = новый Файл(ПутьКФайлу);
		Если ф.Существует() Тогда
			чт = Новый ЧтениеТекста(ПутьКФайлу);
			СтрокаXML = чт.Прочитать();
			
			ЧтениеXML = Новый ЧтениеXML;
			
			ЧтениеXML.УстановитьСтроку(СтрокаXML);	
			ЧтениеXML.Прочитать();
						
			объектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
			
			данные = новый Массив;
			
			CutResults = объектXDTO.CutResult;
			Если ТипЗнч(объектXDTO.CutResult) = Тип("ОбъектXDTO") Тогда
				CutResults = новый Массив;
				CutResults.Добавить(объектXDTO.CutResult);
			КонецЕсли;
			
			Для Каждого CutResult из CutResults Цикл
				данные.Добавить(
					Новый Структура("Заказ,Артикул,Количество"
						,CutResult.OrderData.Order
						,CutResult.OrderData.MaterialArticle
						,CutResult.Boards.Board.Count
					)
				);
			КонецЦикла;
			//
			//объектXDTO.Проверить();
			//
			//об = СериализаторXDTO.ПрочитатьXDTO(объектXDTO);
			//
			//Значение=СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
			
			алсав_алсав_ЗагрузитьXML_ZKПослеНаКлиенте(данные);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура алсав_алсав_ЗагрузитьXML_ZKПослеНаКлиенте(данные)
	// Вставить содержимое обработчика.
	Для каждого стр из данные Цикл
		номен = НайтиНоменклатуру(стр.Артикул);
		колво = Число(стр.Количество);
		заказ = НайтиЗаказ(стр.Заказ);
		
		нСтр = Объект.Товары.Добавить();
		нСтр.Номенклатура = номен;
		нСтр.Количество = колво;
		нСтр.Цена = 1;
		нСтр.КоличествоУпаковок = колво;
		нСтр.ЗаданиеПакет = заказ;
		
		ЭтаФорма.Элементы.Товары.ТекущаяСтрока = нСтр.ПолучитьИдентификатор();
		
		ТоварыНоменклатураПриИзменении(ЭтаФорма.Элементы.Товары);
	КонецЦикла;
	
	
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ПолучитьОрганизациюПоНаименованию("ООО ""АЛСАВ""");
		ОрганизацияПриИзменении(этаФорма.Элементы.Организация);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Объект.Склад = ПолучитьСкладПоНаименованию("Основной склад");
		СкладПриИзменении(этаФорма.Элементы.Склад);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		Объект.Партнер = ПолучитьПартнераПоНаименованию("+ОП+");
		ПартнерПриИзменении(этаФорма.Элементы.Партнер);
	КонецЕсли;
КонецПроцедуры

