&НаСервере
Функция ПолучитьРаскрытуюПотребность(массивВариантовОбоеспечения = неопределено)
	тчПотребность = неопределено;
	мПроверкаПострочно = Новый Массив;
	Для Каждого Стр из Этаформа.Объект.Товары Цикл
		Если (массивВариантовОбоеспечения = неопределено) 
			ИЛИ (массивВариантовОбоеспечения.Найти(Стр.ВариантОбеспечения) <> Неопределено) 
			Тогда
			
			тчПотребностьПозиции = алсав_НоменклатураОстатки.ПолучитьПотребность(
				стр.Номенклатура,
				стр.Характеристика,
				стр.Количество
			);
			
			мПроверкаПострочно.Добавить(новый Структура("стр,тчПотребность", стр, тчПотребностьПозиции));
			
			тчПотребность = СложитьТаблицы(тчПотребность, тчПотребностьПозиции);
		КонецЕсли;		
	КонецЦикла;
	
	Если тчПотребность = неопределено Тогда
		Возврат неопределено;
	КонецЕсли;
	
	тчПотребность.Свернуть("Номенклатура, Характеристика, ПервичнаяПотребность","Количество");
	
	результ = Новый Массив;
	Для Каждого Стр из тчПотребность Цикл
		нстр = Новый Структура("Номенклатура, Характеристика, ПервичнаяПотребность, Количество");
		ЗаполнитьЗначенияСвойств(нстр,Стр);
		результ.Добавить(нстр);
	КонецЦикла;
	
	Возврат результ;
КонецФункции

&НаСервере
Процедура алсав_алсав_ПроверитьВозможнлстьСборкиПослеНаСервере()
	// Вставить содержимое обработчика.
	ЭтаФорма.алса_Дефицит.Очистить();
	тчПотребность = новый ТаблицаЗначений;
	тчПотребность.Колонки.Добавить("Номенклатура");
	тчПотребность.Колонки.Добавить("Характеристика");
	тчПотребность.Колонки.Добавить("Количество");
	тчПотребность.Колонки.Добавить("ПервичнаяПотребность");
	тчПотребность.Колонки.Добавить("Дефицит");
	тчПотребность.Колонки.Добавить("ОстаткиОбуховоОсновной");
	тчПотребность.Колонки.Добавить("ОстаткиОбуховоПроизводство");
	
	массивВариантовОбоеспечения = ПолучитьСписокВариантовОбоеспеченияДляОбработки();

	мПроверкаПострочно = Новый Массив;
	Для Каждого Стр из Этаформа.Объект.Товары Цикл		
		Если массивВариантовОбоеспечения.Найти(Стр.ВариантОбеспечения) <> Неопределено Тогда
			тчПотребностьПозиции = алсав_НоменклатураОстатки.ПолучитьПотребность(
				стр.Номенклатура,
				стр.Характеристика,
				стр.Количество
			);		
			
			мПроверкаПострочно.Добавить(новый Структура("стр,тчПотребность", стр, тчПотребностьПозиции));
			
			тчПотребностьПозиции.Колонки.Добавить("Дефицит");
			Для Каждого стрПотребность из тчПотребностьПозиции Цикл
				стрПотребность.Дефицит = стрПотребность.Количество;
			КонецЦикла; 
			
			тчПотребность = СложитьТаблицы(тчПотребность, тчПотребностьПозиции);
			
		//иначе
			//тчПотребностьПозиции.ЗаполнитьЗначения(0,"Дефицит")
		КонецЕсли;

		//нСтр = тчПотребность.Добавить();
		//ЗаполнитьЗначенияСвойств(нСтр,Стр);
		//нСтр.ПервичнаяПотребность = Истина;
		//нСтр.Дефицит = нСтр.Количество;
	КонецЦикла;
	
	Если тчПотребность = неопределено Тогда
		Возврат;
	КонецЕсли;

	тчПотребность.Свернуть("Номенклатура, Характеристика, ПервичнаяПотребность","Количество, Дефицит, ОстаткиОбуховоПроизводство, ОстаткиОбуховоОсновной");
	
	тчДоступныеОстатки = алсав_НоменклатураОстатки.ПолучитьДоступныйОстаток(тчПотребность.ВыгрузитьКолонку("Номенклатура"),ЭтаФорма.Объект.Склад);
	//Для Каждого стр из тчПотребность Цикл
	//	Если стр.Дефицит = 0 Тогда
	//		нСтр = тчДоступныеОстатки.Добавить();
	//		ЗаполнитьЗначенияСвойств(нСтр,стр);
	//		нСтр.ВРезерве = стр.Количество;
	//		нСтр.ДоступныйОстаток = (-1)*стр.Количество;
	//	КонецЕсли;
	//КонецЦикла;
	
	тчДоступныеОстатки.Свернуть("Номенклатура, Характеристика","ВНаличииОстаток, ВРезерве, КОтгрузке, ДоступныйОстаток");
	
	складПроизводства = ПолучитьСклад_Производство();
	остаткиПроизводства = алсав_НоменклатураОстатки.ПолучитьДоступныйОстаток(тчПотребность.ВыгрузитьКолонку("Номенклатура"),складПроизводства);
	остаткиПроизводства.Свернуть("Номенклатура, Характеристика","ВНаличииОстаток, ВРезерве, КОтгрузке, ДоступныйОстаток");
	
	
	складОбуховоОсновной = ПолучитьСклад_ОбуховоОсновной();
	остаткиОстаткиОбуховоОсновной =  алсав_НоменклатураОстатки.ПолучитьДоступныйОстаток(тчПотребность.ВыгрузитьКолонку("Номенклатура"),складОбуховоОсновной);
	остаткиОстаткиОбуховоОсновной.Свернуть("Номенклатура, Характеристика","ВНаличииОстаток, ВРезерве, КОтгрузке, ДоступныйОстаток");
	
	Если Ложь Тогда тчПотребность = Новый ТаблицаЗначений; КонецЕсли;
	Если Ложь Тогда тчДоступныеОстатки = Новый ТаблицаЗначений; КонецЕсли;
	
	тчПотребность.Колонки.Добавить("ДоступныйОстаток");
	
	Для Каждого стрПотребность из тчПотребность Цикл
		стрПотребность.ДоступныйОстаток = 0;
		стрПотребность.Дефицит = стрПотребность.Количество;
		стрОстаток = тчДоступныеОстатки.НайтиСтроки(Новый Структура("Номенклатура, Характеристика",стрПотребность.Номенклатура, стрПотребность.Характеристика));
		Если стрОстаток.Количество() = 1 Тогда
			стрПотребность.ДоступныйОстаток = стрОстаток[0].ДоступныйОстаток;
		Иначе
			стрПотребность.ДоступныйОстаток = 0;
		КонецЕсли;	
		
		стрПотребность.Дефицит = ?(
			стрПотребность.ДоступныйОстаток >= стрПотребность.Количество,
			0,
			стрПотребность.Количество - стрПотребность.ДоступныйОстаток
		);
		
		Если стрПотребность.Дефицит > 0 Тогда
			стрОстаток = остаткиПроизводства.НайтиСтроки(Новый Структура("Номенклатура, Характеристика",стрПотребность.Номенклатура, стрПотребность.Характеристика));
			Если стрОстаток.Количество() = 1 Тогда
				стрПотребность.ОстаткиОбуховоПроизводство = стрОстаток[0].ДоступныйОстаток;
			Иначе
				стрПотребность.ОстаткиОбуховоПроизводство = 0;
			КонецЕсли;
			
			стрОстаток = остаткиОстаткиОбуховоОсновной.НайтиСтроки(Новый Структура("Номенклатура, Характеристика",стрПотребность.Номенклатура, стрПотребность.Характеристика));
			Если стрОстаток.Количество() = 1 Тогда
				стрПотребность.ОстаткиОбуховоОсновной = стрОстаток[0].ДоступныйОстаток;
			Иначе
				стрПотребность.ОстаткиОбуховоОсновной = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма.алсав_ВозможностьСборки = ?(тчПотребность.Итог("Дефицит") > 0, -1, 1);
	ЭтаФорма.алсав_ВозможностьПеремещения = ?(тчПотребность.Итог("ОстаткиОбуховоПроизводство")+тчПотребность.Итог("ОстаткиОбуховоОсновной") > 0, -1, 1); 
	ЭтаФорма.алса_Дефицит.Загрузить(тчПотребность);	
	
	алсав_УстановитьВидимость();
	
	Для Каждого потребностьПозиции Из мПроверкаПострочно Цикл
		
		стр = потребностьПозиции.стр;
		тчПотребность = потребностьПозиции.тчПотребность;
		
		покаХватает = Истина;
		Для Каждого стрПотребность из тчПотребность Цикл;
			Если стрПотребность.ПервичнаяПотребность Тогда
				покаХватает = Ложь;
			КонецЕсли;
			
			Если покаХватает Тогда
				стрОстаток = тчДоступныеОстатки.НайтиСтроки(Новый Структура("Номенклатура, Характеристика",стрПотребность.Номенклатура, стрПотребность.Характеристика));
				Если стрОстаток.Количество() = 1 Тогда
					покаХватает = (покаХватает) И (стрПотребность.Количество <= стрОстаток[0].ДоступныйОстаток);
				Иначе
					покаХватает = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		стр.ВозможностьСборки = покаХватает;
	КонецЦикла;
КонецПроцедуры


