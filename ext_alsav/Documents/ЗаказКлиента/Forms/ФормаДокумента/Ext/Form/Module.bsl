&НаСервере
Процедура Проверить_Контрольсборок_ЕстьОшибка()
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Свод.ЗаказКлиента КАК ЗаказКлиента,
	               |	Свод.Номенклатура КАК Номенклатура,
	               |	Свод.Характеристика КАК Характеристика,
	               |	СУММА(Свод.Требуется) КАК Требуется,
	               |	СУММА(Свод.Собрано) КАК Собрано,
	               |	СУММА(Свод.Собрано) > СУММА(Свод.Требуется) КАК ЕстьОшибка
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	               |		ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |		ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	               |		ЗаказКлиентаТовары.Количество КАК Требуется,
	               |		0 КАК Собрано
	               |	ИЗ
	               |		Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |	ГДЕ
	               |		ЗаказКлиентаТовары.Ссылка = &Заказа
	               |		И ЗаказКлиентаТовары.ВариантОбеспечения <> ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
	               |		И ЗаказКлиентаТовары.Ссылка.Проведен = ИСТИНА
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЗаказНаСборку.ДокументОснование,
	               |		ЗаказНаСборку.Номенклатура,
	               |		ЗаказНаСборку.Характеристика,
	               |		0,
	               |		ЗаказНаСборку.Количество
	               |	ИЗ
	               |		Документ.ЗаказНаСборку КАК ЗаказНаСборку
	               |	ГДЕ
	               |		ЗаказНаСборку.ДокументОснование = &Заказа
	               |		И ЗаказНаСборку.Проведен
	               |		И ЗаказНаСборку.ДокументОснование.Проведен = ИСТИНА) КАК Свод
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Свод.ЗаказКлиента,
	               |	Свод.Номенклатура,
	               |	Свод.Характеристика
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(Свод.Собрано) > СУММА(Свод.Требуется)";
	
	Запрос.УстановитьПараметр("Заказа",Объект.Ссылка);
	
	
	естьОшибка = Ложь;
	рез = Запрос.Выполнить().Выбрать();
	Пока рез.Следующий() Цикл
		естьОшибка = истина;
		Сообщить("Собрано больше чем требуется ["+рез.Номенклатура+"], требуется = "+рез.Требуется + ", собрано = "+рез.Собрано);
	КонецЦикла;
	
	Элементы.ОшибкаСобраноБольшеЧемПотребность.Видимость = естьОшибка;
КонецПроцедуры


