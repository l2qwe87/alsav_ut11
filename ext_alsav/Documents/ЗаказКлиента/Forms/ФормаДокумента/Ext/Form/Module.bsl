&НаКлиенте
Функция ОткрытьИЗаписатьДокумент(ссылка, типДокумента)
	
	ПараметрыФормы = Новый Структура("Ключ", ссылка);
    нФорма = ПолучитьФорму("Документ."+типДокумента+".Форма.ФормаДокумента", ПараметрыФормы);
	нФорма.Открыть();
	
	Пауза(1);
	
	нФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	нФорма.Закрыть();

	
КонецФункции

&НаСервереБезКонтекста
Функция Пауза(Секунды)
	ОбщегоНазначенияБТС.Пауза(Секунды);
КонецФункции

