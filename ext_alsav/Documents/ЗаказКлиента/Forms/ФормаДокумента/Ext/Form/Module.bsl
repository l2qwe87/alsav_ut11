&НаСервере
Функция СформироватьЗаказыНаСборкуСервер()
	массивЗаказов = Новый Массив;
	массивЗаказов.Добавить(Объект.Ссылка);
	тчСборки = Обработки.ПомошникСозданияСборок.ЗаполнитьСписокСборок(массивЗаказов);
	тчСборки = Обработки.ПомошникСозданияСборок.НайтиСозданныеЗаказыНаСборку(тчСборки);
	Обработки.ПомошникСозданияСборок.ЗаполнитьВариантыКомплектации(тчСборки);
	Обработки.ПомошникСозданияСборок.НайтиСозданныеЗаказыНаСборку(тчСборки);
	
	сформированныеЗаказы = Обработки.ПомошникСозданияСборок.СоздатьЗаказыНаСборку(тчСборки);
	возврат сформированныеЗаказы; 
	
	//реззульт = Новый Массив;
	//Для Каждого Заказ Из сформированныеЗаказы Цикл
	//	
	//	реззульт.Добавить(докСборка);
	//КонецЦикла;
	
	
КонецФункции


&НаКлиенте
Функция алсав_ФормаСозданияЗаказовНаСборокуОбработкаЗакрытия(парам1 = неопределено, парам2  = неопределено) ЭКСПОРТ
	Пауза(1);
	алсав_ФормаСозданияЗаказовНаСборокуОбработкаЗакрытияСервер();
	Пауза(1);
	ОчиститьСообщения();
	ЭтаФорма.Записать();
КонецФункции

&НаСервере
Функция алсав_ФормаСозданияЗаказовНаСборокуОбработкаЗакрытияСервер()
	
	массивВариантовОбоеспечения = ПолучитьСписокВариантовОбоеспеченияДляОбработки();
	
	//вариантОтгрузить = ПолучитьВариантОбоеспечения_Отгрузить();
	вариантОтгрузить  = ПолучитьВариантОбоеспечения_СоСклада();
	
	Для Каждого Стр из Этаформа.Объект.Товары Цикл
		Если массивВариантовОбоеспечения.Найти(Стр.ВариантОбеспечения) <> Неопределено Тогда
			Стр.ВариантОбеспечения = вариантОтгрузить;
		КонецЕсли;		
	КонецЦикла;
	
КонецФункции



