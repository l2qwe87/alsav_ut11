&НаКлиенте
Процедура ОткрытьВнешнийОтчетВО_АнализДоступностиРаскрытиеСборок(Команда)
	
	
    ПараметрыОтчета = Новый Структура;
    ПараметрыОтчета.Вставить("ВидРасшифровки"         , 1);
    //ПараметрыОтчета.Вставить("АдресНастроек"          , АлресХранилища);
    ПараметрыОтчета.Вставить("СформироватьПриОткрытии", Истина);
    //ПараметрыОтчета.Вставить("ИДРасшифровки"          , ИмяОтчета);
    //ПараметрыОтчета.Вставить("РежимРасшифровки"       , Истина);
    //ПараметрыОтчета.Вставить("ЗаполняемыеНастройки"   , ЗаполнятьТиповыеНастройки);
    
    //Ну и открываем саму форму
	
	//ф = ПолучитьФорму("Отчет.ВО_АнализДоступностиРаскрытиеСборок.Форма", ПараметрыОтчета, ЭтаФорма, Истина);
	//ф.УстановитьТекущийВариант("ВО_АнализДоступностиРаскрытиеСборок_Док");
	
	ф = ПолучитьФорму("Отчет.ВО_АнализДоступностиРаскрытиеСборокХарактеристики.Форма", ПараметрыОтчета, ЭтаФорма, Истина);
	ф.УстановитьТекущийВариант("ВО_АнализДоступностиРаскрытиеСборок_ДокХарактеристики");
	
	КомпоновщикНастроек = ф.Отчет.КомпоновщикНастроек;
	ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
	Для Каждого элемент из ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(элемент) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Если Строка(элемент.Параметр) = "ВидЦены" Тогда
				элемент.Значение = получитьВидЦены();
			ИначеЕсли Строка(элемент.Параметр) = "ОтборСклады" Тогда
				элемент.Использование = Истина;
				элемент.Значение = получитьСписокСкладов();
			ИначеЕсли Строка(элемент.Параметр) = "ОтборЗаказКлиента" Тогда
				элемент.Использование = Истина;
				элемент.Значение = получитьСписокЗаказов();
			ИначеЕсли Строка(элемент.Параметр) = "ПроцентОплаты" Тогда
				элемент.Использование = Истина;
				элемент.Значение = 0;
			Иначе
				элемент.Использование = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	ф.Открыть();
    //ОткрытьФорму("Отчет." + ИмяОтчета + ".Форма.ФормаОтчета", ПараметрыОтчета,ЭтаФорма);
	
КонецПроцедуры


