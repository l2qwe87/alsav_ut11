&НаСервере
Функция алсав_УстановитьВидимость()
	
	
	Если Этаформа.алсав_ВозможностьПеремещения = -1 Тогда
		ЭтаФорма.Элементы.алса_Дефициталсав_СоздатьПеремещениеСПроизводства.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.алса_Дефициталсав_СоздатьПеремещениеСПроизводства.Видимость = ЛОЖЬ;		
	КонецЕсли;
	ЭтаФорма.Элементы.алса_Дефициталсав_СоздатьПеремещениеСОбуховоОсновной.Видимость = ЭтаФорма.Элементы.алса_Дефициталсав_СоздатьПеремещениеСПроизводства.Видимость;
	
	Если Этаформа.алсав_ВозможностьСборки = -1 Тогда
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Заголовок = "Дефицит";
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Картинка = БиблиотекаКартинок.Предупреждение;
	ИначеЕсли Этаформа.алсав_ВозможностьСборки = 0 Тогда
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Заголовок = "...";
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Картинка = БиблиотекаКартинок.ДлительнаяОперация16;
	ИначеЕсли Этаформа.алсав_ВозможностьСборки = 1 Тогда
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Заголовок = "Готов к сборке (сформировать)";
		ЭтаФорма.Элементы.алсав_СформироватьСборки.Картинка = БиблиотекаКартинок.ВыполненоУспешно;
	КонецЕсли;
	
	//ЭтаФорма.Элементы.алсав_СформироватьСборки.Доступность = Этаформа.алсав_ВозможностьСборки = 1;
	ЭтаФорма.Элементы.ГруппаДефицит.Видимость = Истина;//Этаформа.алсав_ВозможностьСборки = -1; 
	
	Этаформа.Элементы.ВниманиеЕстьПроведеннаяСборка.Видимость = Проверить_ЕстьПроведеннаяСборка();
КонецФункции

&НаСервере
Функция Проверить_ЕстьПроведеннаяСборка()
	результ = ложь;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат результ;
	Конецесли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказНаСборку.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказНаСборку КАК ЗаказНаСборку
	               |ГДЕ
	               |	ЗаказНаСборку.Проведен
	               |	И ЗаказНаСборку.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		результ = Истина;
	КонецЕсли;
	Возврат результ;
КонецФункции

