Функция СформироватьЗаказНаСборкуДляСтрокиСервер(ТекущаяСтрока)
	стр = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	//ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	массивВариантовОбоеспечения = Новый Массив;
	массивВариантовОбоеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);	
	массивВариантовОбоеспечения.Добавить(Перечисления.ВариантыОбеспечения.Требуется);
	
	Если стр.ВариантКомплектацииОтсуствует или массивВариантовОбоеспечения.Найти(стр.ВариантОбеспечения) = неопределено Тогда
		Сообщить("Текущая позиция не требует сборки");
		Возврат неопределено;
	КонецЕсли;
	
	Если НЕ стр.ВозможностьСборки Тогда
		Сообщить("Для сборки не хватает остатков");
		Возврат неопределено;
	КонецЕсли;
                                                                               
	массивЗаказов = Новый Массив;
	массивЗаказов.Добавить(Объект.Ссылка);

	тчСборки = Обработки.ПомошникСозданияСборок.ЗаполнитьСписокСборок(массивЗаказов, стр.НомерСтроки);
	Обработки.ПомошникСозданияСборок.ЗаполнитьВариантыКомплектации(тчСборки);
	Обработки.ПомошникСозданияСборок.НайтиСозданныеЗаказыНаСборку(тчСборки);
	
	сформированныеЗаказы = Обработки.ПомошникСозданияСборок.СоздатьЗаказыНаСборку(тчСборки);
	
	докСборка = неопределено;
	Для Каждого заказНаСборку Из сформированныеЗаказы Цикл
		//докСборка = Обработки.ПомошникСозданияСборок.СоздатьСборку(Заказ);
		сборка = СоздатьСборку(заказНаСборку);
		ордер = СоздатьОрдерДляСборки(сборка);
		ордерРасходный = СоздатьОрдерДляСборкиРасходный(сборка);

		Если ЗначениеЗаполнено(сборка) тогда
			//вариантОтгрузить = ПолучитьВариантОбоеспечения_Отгрузить();
			вариантОтгрузить = ПолучитьВариантОбоеспечения_СоСклада();
			
			Пауза(1);
			Стр.ВариантОбеспечения = вариантОтгрузить;
			ЭтаФорма.Модифицированность = Истина;
			Пауза(1);
			ЭтаФорма.Записать();
		КонецЕсли;
	КонецЦикла;
КонецФункции

