&НаСервереБезКонтекста
Функция НайтиНоменклатуру(артикул)
	ЗАпрос = Новый Запрос;
	Запрос.УстановитьПараметр("артикул", артикул);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	н.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура.ДополнительныеРеквизиты КАК н
	               |ГДЕ
	               |	н.Значение = &артикул
	               |	И н.Свойство.Заголовок = ""ЛДСП Базис""";
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	н.Ссылка КАК Ссылка
	//               |ИЗ
	//               |	Справочник.Номенклатура КАК н
	//               |ГДЕ
	//               |	н.Артикул = &артикул";
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		Возврат рез.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
КонецФункции

&НаСервереБезКонтекста
Функция НайтиЗаказ(заказ)
	док = Документы.ЗаказКлиента.НайтиПоНомеру(Прав(заказ,11),ТекущаяДата());
	Если ЗначениеЗаполнено(док) Тогда
		Возврат док;
	КонецЕсли;
КонецФункции


