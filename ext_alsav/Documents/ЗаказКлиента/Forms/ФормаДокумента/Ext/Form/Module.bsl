Процедура алсав_алсав_ПолучитьДанныеПоСметамПосле(Команда)
	// Вставить содержимое обработчика.
	//тч = алсав_алсав_ПолучитьДанныеПоСметамПослеСервер();
	
	тч = Новый ТабличныйДокумент;
	массивФайлов = ПолучитьМассивФайлов();
