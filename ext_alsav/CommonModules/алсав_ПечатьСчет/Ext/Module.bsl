			ОбластьКодов  = Макет.ПолучитьОбласть("СтрокаТаблицыСНДС|КолонкаКодов");
			ОбластьТовар  = Макет.ПолучитьОбласть("СтрокаТаблицыСНДС|ТоварСНДСИлиСоСкидкой");
			
			Попытка
				ОбластьТоварШтрихкод  = Макет.ПолучитьОбласть("СтрокаТаблицыСНДСШтрихкод|ТоварСНДСИлиСоСкидкой");
			Исключение
				ОбластьТоварШтрихкод  = Макет.ПолучитьОбласть("СтрокаТаблицыСНДС|ТоварСНДСИлиСоСкидкой");
			КонецПопытки;
			
			ОбластьДанных = Макет.ПолучитьОбласть("СтрокаТаблицыСНДС|ДанныеСНДСИлиСоСкидкой");
			
			ОбластьНомераК = Макет.ПолучитьОбласть("КомплектацияСНДС|НомерСтроки");
			ОбластьКодовК  = Макет.ПолучитьОбласть("КомплектацияСНДС|КолонкаКодов");
			ОбластьТоварК  = Макет.ПолучитьОбласть("КомплектацияСНДС|ТоварСНДСИлиСоСкидкой");
			
			Попытка
				ОбластьТоварК2  = Макет.ПолучитьОбласть("КомплектацияСНДС2|ТоварСНДСИлиСоСкидкой");
			Исключение
