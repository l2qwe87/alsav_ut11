
Функция ПолучитьОсновнуюКомплектацию(Номенклатура) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры КАК Таблица
	|ГДЕ
	|	Таблица.Владелец = &Номенклатура
	|	И Таблица.Основной
	|	И НЕ Таблица.ПометкаУдаления");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	Иначе
		Результат = Справочники.ВариантыКомплектацииНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Штрихкод(Номенклатура, характеристика)ЭКСПОРТ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	MIN(Штрихкоды.Штрихкод) КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Номенклатура = &Номенклатура";
	
	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Если ЗначениеЗаполнено(характеристика) Тогда
		Запрос.УстановитьПараметр("Характеристика",характеристика);
		ЗАпрос.Текст = ЗАпрос.Текст +" 
		|		И (Штрихкоды.Характеристика = &Характеристика) ";
	КонецЕсли;
	
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		Возврат Рез.Штрихкод;
	Конецесли;
		
КонецФункции

Функция ШтрихкодВнешний(Номенклатура, характеристика)ЭКСПОРТ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	MAX(Штрихкоды.Штрихкод) КАК Штрихкод
	               |ИЗ
	               |	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Номенклатура = &Номенклатура";
	
	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Если ЗначениеЗаполнено(характеристика) Тогда
		Запрос.УстановитьПараметр("Характеристика",характеристика);
		ЗАпрос.Текст = ЗАпрос.Текст +" 
		|		И (Штрихкоды.Характеристика = &Характеристика) ";
	КонецЕсли;
	
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		Возврат Рез.Штрихкод;
	Конецесли;
		
КонецФункции

Функция ПолучитьАртикул(Номенклатура, характеристика, контрагент)ЭКСПОРТ
	
	Если контрагент = неопределено или контрагент.ИНН = "7722753969" Тогда	
		наименованиеДопРеквизита = "ИКТ";
		допАртикул = алсав_ДопРеквизиты.ПолучитьДопРеквизит(характеристика, наименованиеДопРеквизита);
		возврат допАртикул;
	Иначе     
		возврат Номенклатура.Артикул;
	КонецЕсли;
КонецФункции



Функция Вес(Номенклатура, дажеДляСложного = ложь)Экспорт
	Если дажеДляСложного = Ложь Тогда
		компл = ПолучитьОсновнуюКомплектацию(Номенклатура);
		Если ЗначениеЗаполнено(компл) Тогда
			Возврат 0;	
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.Номенклатура.Вес(Номенклатура);
КонецФункции

Функция Объем(Номенклатура, дажеДлясложного = ложь)Экспорт
	Если дажеДляСложного = Ложь Тогда
		компл = ПолучитьОсновнуюКомплектацию(Номенклатура);
		Если ЗначениеЗаполнено(компл) Тогда
			Возврат 0;	
		КонецЕсли;
	КонецЕсли;
	Возврат Справочники.Номенклатура.Объем(Номенклатура);
КонецФункции


Функция ПолучитьТекстЗапросаДляСчета() ЭКСПОРТ
	Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	ЗаказКлиента.Номер КАК Номер,
		|	ЗаказКлиента.Дата КАК Дата,
		|	ЗаказКлиента.Организация КАК Организация,
		|	ЗаказКлиента.Организация.Префикс КАК Префикс,
		|	ЗаказКлиента.Контрагент КАК Контрагент,
		|	ЗаказКлиента.БанковскийСчет КАК БанковскийСчет,
		|	ЗаказКлиента.БанковскийСчет.ТекстКорреспондента КАК БанковскийСчетТекстКорреспондента,
		|	ЗаказКлиента.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
		|	ЗаказКлиента.Валюта КАК Валюта,
		|	ЗаказКлиента.Менеджер.ФизическоеЛицо.Наименование КАК Менеджер,
		|	ЗаказКлиента.ДополнительнаяИнформация КАК ДополнительнаяИнформация,
		|	ЗаказКлиента.ЭтапыГрафикаОплаты.(
		|		НомерСтроки КАК НомерСтроки,
		|		ВариантОплаты КАК ВариантОплаты,
		|		ДатаПлатежа КАК ДатаПлатежа,
		|		ПроцентПлатежа КАК ПроцентПлатежа,
		|		СуммаПлатежа КАК СуммаПлатежа
		|	) КАК ЭтапыГрафикаОплаты,
		|	ЗаказКлиента.Товары.(
		|		НомерСтроки КАК НомерСтроки,
		|		Номенклатура КАК Номенклатура,
		|		Номенклатура.Код КАК Код,
		|		Номенклатура.Артикул КАК Артикул,
		|		ВЫБОР
		|			КОГДА ЗаказКлиента.Товары.Характеристика = """"
		|				ТОГДА ЗаказКлиента.Товары.Номенклатура.НаименованиеПолное
		|			ИНАЧЕ ЗаказКлиента.Товары.Номенклатура.НаименованиеПолное + "", "" + ЗаказКлиента.Товары.Характеристика.НаименованиеПолное
		|		КОНЕЦ КАК НаименованиеПолное,
		|		Цена КАК Цена,
		|		ЗаказКлиента.Товары.СуммаРучнойСкидки + ЗаказКлиента.Товары.СуммаАвтоматическойСкидки КАК СуммаСкидки,
		|		ЗаказКлиента.Товары.Сумма + ЗаказКлиента.Товары.СуммаРучнойСкидки + ЗаказКлиента.Товары.СуммаАвтоматическойСкидки КАК СуммаБезСкидки,
		|		Сумма КАК Сумма,
		|		СтавкаНДС КАК СтавкаНДС,
		|		СуммаНДС КАК СуммаНДС,
		|		ДатаОтгрузки КАК ДатаОтгрузки,
		|		Характеристика КАК Характеристика,
		|		Отменено КАК Отменено,
		|		ВЫБОР
		|			КОГДА ЗаказКлиента.Товары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|				ТОГДА ПРЕДСТАВЛЕНИЕ(ЗаказКлиента.Товары.Номенклатура.ЕдиницаИзмерения)
		|			ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ЗаказКлиента.Товары.Упаковка.ЕдиницаИзмерения)
		|		КОНЕЦ КАК ЕдиницаИзмерения,
		|		Количество
		|	),
		|	ЗаказКлиента.Руководитель,
		|	ЗаказКлиента.ГлавныйБухгалтер,
		|	ЗаказКлиента.НалогообложениеНДС,
		|	ВЫБОР
		|		КОГДА ЗаказКлиента.НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК УчитыватьНДС
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента 
		|ГДЕ
		|	ЗаказКлиента.Ссылка В(&МассивОбъектов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
		
		
	Возврат Текст;
КонецФункции


