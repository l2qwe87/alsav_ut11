		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
			ОбластьМакета.Параметры.СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(СуммаКПрописи, ДанныеПечати.Валюта);
		КонецЕсли;
		
		ОбластьМакета.Параметры.ИтоговаяСтрока = ИтоговаяСтрока;
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ЗаполнитьРеквизитыПодвалаСчетЗаказ(ДанныеПечати, Макет, ТабличныйДокумент, Тип, ТаблицаЭтапыОплаты, СоответствиеСтавокНДС,этоСчетДоговор);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеПечати.Ссылка);
		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции 


Функция вывестиСтрокуТовары(строкаТовары, ТабличныйДокумент, НомерСтроки, уровень, ДанныеПечати, ВыводитьКоды, выводитьШтрихКоды, ОбластьНомераК, ОбластьТоварК2, ОбластьДанныхК, ОбластьКодовК)
	резалт = новый Структура("Вес, Объем", 0.0, 0.0);
	стрК1 = строкаТовары;  
	
	текНомерСтроки = ?(ЗначениеЗаполнено(номерСтроки),
		номерСтроки+"."+строкаТовары.НомерСтроки,
		Строка(строкаТовары.НомерСтроки)
	);
                           	
	ОбластьНомераК.Параметры.НомерСтроки = текНомерСтроки;
	ТабличныйДокумент.Вывести(ОбластьНомераК);
	
	Если ВыводитьКоды Тогда
		
		//ОбластьКодовК.Параметры.Артикул = СтрК1.Номенклатура.Артикул;;
		ОбластьКодовК.Параметры.Артикул = ПолучитьАртикул(СтрК1.Номенклатура,СтрК1.Характеристика, ДанныеПечати.Контрагент);
		ТабличныйДокумент.Присоединить(ОбластьКодовК);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(стрК1.Характеристика) Тогда
		ОбластьТоварК2.Параметры.Товар = стрК1.Номенклатура.НаименованиеПолное 
		+ ", " + стрК1.Характеристика.НаименованиеПолное; 
	Иначе
		ОбластьТоварК2.Параметры.Товар = стрК1.Номенклатура.НаименованиеПолное; 	
	КонецЕсли;								НоменклатураСсылка = стрК1.Номенклатура;
	Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		//ВесЧисло = (алсав_ПечатьСчет.Вес(НоменклатураСсылка) * (СтрК1.Количество * СтрК.Количество * СтрокаТовары.Количество));
		//ОбъёмЧисло = (алсав_ПечатьСчет.Объем(НоменклатураСсылка) * (СтрК1.Количество * СтрК.Количество * СтрокаТовары.Количество));		
		//ВсегоВес          = ВсегоВес    + ВесЧисло ;
		//ВсегоОбъем        = ВсегоОбъем  + ОбъёмЧисло;
		
		ВесЧисло = (алсав_ПечатьСчет.Вес(НоменклатураСсылка) * (СтрК1.Количество) );
		ОбъёмЧисло = (алсав_ПечатьСчет.Объем(НоменклатураСсылка) * (СтрК1.Количество) );
		
		резалт.Вес = ВесЧисло;
		резалт.Объем = ОбъёмЧисло;
		
		параметрыОбласти = Новый Структура("Вес,Объем,Штрихкод");
		параметрыОбласти.Вес   = ВесЧисло;
		параметрыОбласти.Объем = ОбъёмЧисло;  
		параметрыОбласти.Штрихкод = Штрихкод(стрК1.Номенклатура,стрК1.Характеристика);
		ОбластьТоварК2.Параметры.Заполнить(параметрыОбласти);

		Если выводитьШтрихКоды=истина Тогда
			//ОбластьТоварК2.Параметры.Товар = "" + параметрыОбласти.Штрихкод + "   " +  ОбластьТоварК2.Параметры.Товар;
		Конецесли;
	КонецЕсли;
	
	ТабличныйДокумент.Присоединить(ОбластьТоварК2);
	
	ОбластьДанныхК.Параметры.Количество = СтрК1.Количество;
	ОбластьДанныхК.Параметры.ЕдиницаИзмерения = СтрК1.Номенклатура.ЕдиницаИзмерения;
	ТабличныйДокумент.Присоединить(ОбластьДанныхК); 
	
	////////////////////////////
	вариантКомплектации=Справочники.ВариантыКомплектацииНоменклатуры.ПолучитьОсновнуюКомплектацию(строкаТовары.Номенклатура, строкаТовары.Характеристика);
	
	Если ЗначениеЗаполнено(вариантКомплектации) Тогда
		тчСостав = АЛСАВ_Сборка.ПолучитьКомплектующиеНоменклатуры(
			вариантКомплектации,
			,
			строкаТовары.Количество,
			Ложь
		);
		Для Каждого стр из тчСостав Цикл
			//итогоКоличество = итогоКоличество + вывестиСтрокуТовары(стр,тд, текНомерСтроки, уровень + 1)
			промРезалт = вывестиСтрокуТовары(стр, ТабличныйДокумент, текНомерСтроки, уровень, ДанныеПечати, ВыводитьКоды, выводитьШтрихКоды, ОбластьНомераК, ОбластьТоварК2, ОбластьДанныхК, ОбластьКодовК);
			
			резалт.Вес = резалт.Вес + промРезалт.Вес;
			резалт.Объем = резалт.Объем + промРезалт.Объем;
		КонецЦикла;
	КонецЕсли;
	////////////////////////////
	Возврат резалт;
КонецФункции


