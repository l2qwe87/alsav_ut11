Функция ПолучитьРазвёрнутыйСостав(Номенклатура, Характеристика, колВо)
	резалт = Новый Массив;
	Вар = Справочники.ВариантыКомплектацииНоменклатуры.ПолучитьОсновнуюКомплектацию(Номенклатура,Характеристика);
	Если ЗначениеЗаполнено(Вар) Тогда					
		кк=0;
		Для каждого стрК из Вар.Товары Цикл
			кк = кк + 1;
			структураСтроки = СформироватьСтруктуруСтрокиСостава(стрК, колВо);
			структураСтроки.Вставить("позиция",""+кк);                        
			резалт.Добавить(структураСтроки);
			Вар1=Справочники.ВариантыКомплектацииНоменклатуры.ПолучитьОсновнуюКомплектацию(СтрК.ВариантКомлектации.Владелец,СтрК.ВариантКомлектации.Характеристика);
			кк1 = 0;
			Если ЗначениеЗаполнено(Вар1) Тогда
				Для каждого стрК1 из Вар1.Товары Цикл
					кк1 = кк1 + 1;
					структураСтроки = СформироватьСтруктуруСтрокиСостава(стрК1, колВо);
					структураСтроки.Вставить("позиция",""+кк+"."+кк1);
					резалт.Добавить(структураСтроки);
				КонецЦикла;
			КонецЕсли
		КонецЦикла;
	КонецЕсли;
	
	возврат резалт;
КонецФункции  

Функция СформироватьСтруктуруСтрокиСостава(стрК, колВо)
	резалт = Новый Структура();
	
	
	ПредставлениеНоменклатуры = "" + стрК.Номенклатура.НаименованиеПолное;
	Если ЗначениеЗаполнено(стрК.Характеристика) Тогда 
		ПредставлениеНоменклатуры = ПредставлениеНоменклатуры + " (" + стрК.Характеристика+")"; 
	КонецЕсли;
	Артикул = стрК.Номенклатура.Артикул;
	Количество = СтрК.Количество * колВо;
	ЕдИзм = стрК.Номенклатура.ЕдиницаИзмерения;
	
	резалт.Вставить("ПредставлениеНоменклатуры",ПредставлениеНоменклатуры);
	резалт.Вставить("Артикул",Артикул);
	резалт.Вставить("Номенклатура",стрК.Номенклатура);
	резалт.Вставить("Характеристика",стрК.Характеристика);
	резалт.Вставить("Количество",Количество);
	резалт.Вставить("ЕдИзм",ЕдИзм);
	
	возврат резалт;
КонецФункции 

Функция КопироватьСтруктуруСтруктуры(прототип)
	резалт = новый структура;
	Если ЛОЖЬ Тогда прототип = новый Структура(); КонецЕсли;
	
	Для Каждого эл из прототип Цикл
		резалт.Вставить(эл.Ключ, Неопределено);
		
		Если ТипЗнч(эл.Значение) = Тип("Массив") Тогда
			резалт[эл.Ключ] = Новый Массив();
		КонецЕсли;
		
		Если ТипЗнч(эл.Значение) = Тип("Структура") Тогда
			резалт[эл.Ключ] = КопироватьСтруктуруСтруктуры(эл.Значение);
		КонецЕсли;
	КонецЦикла;
	
	возврат резалт;
КонецФункции