#Область ЗагрузкаДанных

Процедура ЗагрузитьВсеДанные(Склад = "Склад адресного хранения", ДатаСреза = Неопределено, ДатаНачалаДвижений = Неопределено, АдресШлюза = Неопределено, Секрет = Неопределено) Экспорт

	Если ДатаСреза = Неопределено Тогда
		ДатаСреза = ТекущаяДата();
	КонецЕсли;

	Если ДатаНачалаДвижений = Неопределено Тогда
		ДатаНачалаДвижений = ДатаСреза;
	КонецЕсли;

	ЗагрузитьСоставИзделий(Склад, АдресШлюза, Секрет);
	ЗагрузитьСрезОстатков(Склад, ДатаСреза, АдресШлюза, Секрет);
	ЗагрузитьДвиженияОстатков(Склад, ДатаНачалаДвижений, Неопределено, АдресШлюза, Секрет);

КонецПроцедуры

Процедура ЗагрузитьСоставИзделий(Склад, АдресШлюза = Неопределено, Секрет = Неопределено) Экспорт

	Данные = Новый Массив;
	Выборка = ПолучитьВыборкуСоставаИзделий();

	Для Каждого Строка Из Выборка Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("productArticle", ТекстИлиПустаяСтрока(Строка.ProductArticle));
		Элемент.Вставить("productCharacteristic", ТекстИлиПустаяСтрока(Строка.ProductCharacteristic));
		Элемент.Вставить("productSeries", ТекстИлиПустаяСтрока(Строка.Series));
		Элемент.Вставить("componentArticle", ТекстИлиПустаяСтрока(Строка.ComponentArticle));
		Элемент.Вставить("componentCharacteristic", ТекстИлиПустаяСтрока(Строка.ComponentCharacteristic));
		Элемент.Вставить("componentSeries", ТекстИлиПустаяСтрока(Строка.Series));
		Элемент.Вставить("warehouse", Склад);
		Элемент.Вставить("quantityPerUnit", ЧислоИлиНоль(Строка.QuantityPerUnit));
		Элемент.Вставить("isMaterial", БулевоИлиЛожь(Строка.IsMaterial));
		Элемент.Вставить("isSemiFinished", БулевоИлиЛожь(Строка.IsSemiFinished));

		Если ПустаяСтрока(Элемент.productArticle) ИЛИ ПустаяСтрока(Элемент.componentArticle) Тогда
			Продолжить;
		КонецЕсли;

		Если Элемент.quantityPerUnit <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Данные.Добавить(Элемент);
	КонецЦикла;

	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОтправитьВШлюз("/api/internal/v1/sync/product-compositions", Данные, АдресШлюза, Секрет);

КонецПроцедуры

Процедура ЗагрузитьСрезОстатков(Склад, ДатаСреза, АдресШлюза = Неопределено, Секрет = Неопределено) Экспорт

	Данные = Новый Массив;
	Выборка = ПолучитьВыборкуСрезаОстатков(Склад, ДатаСреза);

	Для Каждого Строка Из Выборка Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("snapshotDate", ДатаВISO(ДатаСреза));
		Элемент.Вставить("warehouse", Склад);
		Элемент.Вставить("article", ТекстИлиПустаяСтрока(Строка.Article));
		Элемент.Вставить("characteristic", ТекстИлиПустаяСтрока(Строка.Characteristic));
		Элемент.Вставить("series", ТекстИлиПустаяСтрока(Строка.Series));
		Элемент.Вставить("barcode", ТекстИлиПустаяСтрока(Строка.Barcode));
		Элемент.Вставить("name", ТекстИлиПустаяСтрока(Строка.Name));
		Элемент.Вставить("unit", ТекстИлиПустаяСтрока(Строка.Unit));
		Элемент.Вставить("type", ТекстИлиПустаяСтрока(Строка.Type));
		Элемент.Вставить("price", ЧислоИлиНоль(Строка.Price));
		Элемент.Вставить("inStock", ЧислоИлиНоль(Строка.InStock));

		Резерв = ЧислоИлиНоль(Строка.InStock) - ЧислоИлиНоль(Строка.Available);
		Если Резерв < 0 Тогда
			Резерв = 0;
		КонецЕсли;

		Элемент.Вставить("reservedInWarehouse", Резерв);
		Элемент.Вставить("reservedForOrder", 0);
		Элемент.Вставить("paidUnsecuredDemand", ЧислоИлиНоль(Строка.Demand));

		Если ПустаяСтрока(Элемент.article) Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Элемент.name) Тогда
			Элемент.name = Элемент.article;
		КонецЕсли;

		Данные.Добавить(Элемент);
	КонецЦикла;

	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОтправитьВШлюз("/api/internal/v1/sync/stock-snapshot", Данные, АдресШлюза, Секрет);

КонецПроцедуры

Процедура ЗагрузитьДвиженияОстатков(Склад, ДатаНачала, ДатаОкончания = Неопределено, АдресШлюза = Неопределено, Секрет = Неопределено) Экспорт

	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ТекущаяДата();
	КонецЕсли;

	Данные = Новый Массив;
	Выборка = ПолучитьВыборкуДвиженийОстатков(Склад, ДатаНачала, ДатаОкончания);

	Для Каждого Строка Из Выборка Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("period", ДатаВISO(Строка.Period));
		Элемент.Вставить("warehouse", Склад);
		Элемент.Вставить("article", ТекстИлиПустаяСтрока(Строка.Article));
		Элемент.Вставить("characteristic", ТекстИлиПустаяСтрока(Строка.Characteristic));
		Элемент.Вставить("series", ТекстИлиПустаяСтрока(Строка.Series));
		Элемент.Вставить("inStockDelta", ЧислоИлиНоль(Строка.InStockDelta));
		Элемент.Вставить("reservedInWarehouseDelta", ЧислоИлиНоль(Строка.ReservedInWarehouseDelta));
		Элемент.Вставить("reservedForOrderDelta", ЧислоИлиНоль(Строка.ReservedForOrderDelta));
		Элемент.Вставить("paidUnsecuredDemandDelta", ЧислоИлиНоль(Строка.PaidUnsecuredDemandDelta));

		Если ПустаяСтрока(Элемент.article) Тогда
			Продолжить;
		КонецЕсли;

		Данные.Добавить(Элемент);
	КонецЦикла;

	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОтправитьВШлюз("/api/internal/v1/sync/stock-movements", Данные, АдресШлюза, Секрет);

КонецПроцедуры

#КонецОбласти

#Область Запросы

Функция ПолучитьВыборкуСоставаИзделий()

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Продукт.Артикул КАК ProductArticle,
	|	ПродуктХарактеристика.Наименование КАК ProductCharacteristic,
	|	ДРСерия.Значение.Наименование КАК Series,
	|	Компонент.Артикул КАК ComponentArticle,
	|	КомпонентХарактеристика.Наименование КАК ComponentCharacteristic,
	|	состав.Количество КАК QuantityPerUnit,
	|	состав.ЭтоМатериалы КАК IsMaterial,
	|	состав.ЭтоПолуфабрикат КАК IsSemiFinished
	|ИЗ
	|	РегистрСведений.алсав_СоставИзделий КАК состав
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Продукт
	|			ПО состав.ПродуктНоменклатура = Продукт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ПродуктХарактеристика
	|			ПО состав.ПродуктХарактеристика = ПродуктХарактеристика.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДРСерия
	|			ПО ДРСерия.Ссылка = состав.ПродуктНоменклатура
	|				И ДРСерия.Свойство.Заголовок = ""Серия""
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Компонент
	|			ПО состав.Номенклатура = Компонент.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК КомпонентХарактеристика
	|			ПО состав.Характеристика = КомпонентХарактеристика.Ссылка
	|ГДЕ
	|	состав.ЭтоМатериалы = ЛОЖЬ
	|	И состав.ЭтоПолуфабрикат = ЛОЖЬ
	|	И состав.Количество > 0";

	Запрос = Новый Запрос(ТекстЗапроса);
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПолучитьВыборкуСрезаОстатков(Склад, ДатаСреза)

	СкладСсылка = ПолучитьСсылкуНаСклад(Склад);
	ВнутреннийЗапрос = ПолучитьТекстВнутреннегоЗапроса();

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Т.ПродуктНоменклатура.Артикул КАК ProductArticle,
	|	Т.Номенклатура.Артикул КАК Article,
	|	Т.ПродуктНоменклатура.Наименование КАК Name,
	|	Т.ПродуктНоменклатура.ЕдиницаИзмерения.Наименование КАК Unit,
	|	Т.ПродуктНоменклатура.ВидНоменклатуры.Наименование КАК Type,
	|	Т.ПродуктХарактеристика.Наименование КАК ProductCharacteristic,
	|	Т.Характеристика.Наименование КАК Characteristic,
	|	Т.Серия.Наименование КАК Series,
	|	Т.ПродуктШтрихкод КАК Barcode,
	|	Т.ПродуктЦена КАК Price,
	|	Т.ВНаличииОстаток КАК InStock,
	|	Т.Доступно КАК Available,
	|	Т.ВЗаказеОплаченоНеОбеспечено КАК Demand
	|ИЗ (" + ВнутреннийЗапрос + ") КАК Т
	|ГДЕ Т.Склад = &СкладСсылка";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СкладСсылка", СкладСсылка);
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаСреза);
	Запрос.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.НайтиПоНаименованию("Отпускная цена (с учетом НДС)", Истина));
	Запрос.УстановитьПараметр("ПроцентОплаты", 1);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПолучитьВыборкуДвиженийОстатков(Склад, ДатаНачала, ДатаОкончания)

	СкладСсылка = ПолучитьСсылкуНаСклад(Склад);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Движения.Период КАК Period,
	|	Движения.Номенклатура.Артикул КАК Article,
	|	Движения.Характеристика.Наименование КАК Characteristic,
	|	ДРСерия.Значение.Наименование КАК Series,
	|	Движения.ВНаличииДельта КАК InStockDelta,
	|	Движения.ВРезервеСоСкладаДельта КАК ReservedInWarehouseDelta,
	|	Движения.ВРезервеПодЗаказДельта КАК ReservedForOrderDelta,
	|	Движения.ПотребностьДельта КАК PaidUnsecuredDemandDelta
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Период КАК Период,
	|		Остатки.Номенклатура КАК Номенклатура,
	|		Остатки.Характеристика КАК Характеристика,
	|		Остатки.Склад КАК Склад,
	|		Остатки.ВНаличии КАК ВНаличииДельта,
	|		Остатки.ВРезервеСоСклада КАК ВРезервеСоСкладаДельта,
	|		Остатки.ВРезервеПодЗаказ КАК ВРезервеПодЗаказДельта,
	|		0 КАК ПотребностьДельта
	|	ИЗ
	|		РегистрНакопления.СвободныеОстатки КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Отгрузка.Период,
	|		Отгрузка.Номенклатура,
	|		Отгрузка.Характеристика,
	|		Отгрузка.Склад,
	|		0,
	|		0,
	|		0,
	|		ЕСТЬNULL(Отгрузка.ВРезерве, 0) + ЕСТЬNULL(Отгрузка.КОтгрузке, 0)
	|	ИЗ
	|		РегистрНакопления.ТоварыКОтгрузке КАК Отгрузка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		График.Период,
	|		График.Номенклатура,
	|		График.Характеристика,
	|		График.Склад,
	|		0,
	|		0,
	|		0,
	|		ЕСТЬNULL(График.КоличествоНеобеспечено, 0)
	|	ИЗ
	|		РегистрНакопления.ГрафикОтгрузкиТоваров КАК График) КАК Движения
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДРСерия
	|		ПО ДРСерия.Ссылка = Движения.Номенклатура
	|			И ДРСерия.Свойство.Заголовок = ""Серия""
	|ГДЕ
	|	Движения.Склад = &СкладСсылка
	|	И Движения.Период >= &ДатаНачала
	|	И Движения.Период <= &ДатаОкончания";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СкладСсылка", СкладСсылка);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ПолучитьТекстВнутреннегоЗапроса()

	СхемаКомпоновкиДанных = Обработки.алсав_ВыгрузкаФайла_ПрайсОсновной.ПолучитьМакет("ЗапросДляВыгрузки");
	Возврат СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос;

КонецФункции

Функция ПолучитьСсылкуНаСклад(Склад)

	Ссылка = Справочники.Склады.НайтиПоНаименованию(Склад, Истина);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение("Не найден склад: " + Склад);
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область ОтправкаВШлюз

Процедура ОтправитьВШлюз(Путь, Данные, АдресШлюза, Секрет)

	Адрес = СокрЛП(ПолучитьЗначениеНастройки(АдресШлюза, "secret_alsav_gw_base_url"));
	Секрет = СокрЛП(ПолучитьЗначениеНастройки(Секрет, "secret_alsav_gw_internal_secret"));

	Если ПустаяСтрока(Адрес) ИЛИ ПустаяСтрока(Секрет) Тогда
		ВызватьИсключение("Не заданы параметры подключения к шлюзу");
	КонецЕсли;

	Защищенное = Ложь;
	Порт = 80;

	Если Лев(Адрес, 8) = "https://" Тогда
		Защищенное = Истина;
		Порт = 443;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли Лев(Адрес, 7) = "http://" Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;

	ПозицияСлеша = СтрНайти(Адрес, "/");
	Префикс = "";
	Если ПозицияСлеша > 0 Тогда
		Префикс = Сред(Адрес, ПозицияСлеша);
		Адрес = Лев(Адрес, ПозицияСлеша - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Адрес, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Порт = Число(Сред(Адрес, ПозицияДвоеточия + 1));
		Адрес = Лев(Адрес, ПозицияДвоеточия - 1);
	КонецЕсли;

	Если Защищенное Тогда
		Соединение = Новый HTTPСоединение(Адрес, Порт, "", "", "", 60, Новый ЗащищенноеСоединениеOpenSSL());
	Иначе
		Соединение = Новый HTTPСоединение(Адрес, Порт, "", "", "", 60);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос(Префикс + Путь);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("X-Internal-Secret", Секрет);
	HTTPЗапрос.УстановитьТелоИзСтроки(СериализоватьВJSON(Данные), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение("Ошибка загрузки данных в шлюз (" + Путь + "): " + Строка(Ответ.КодСостояния) + " " + Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьЗначениеНастройки(ЯвноеЗначение, КлючСекрета)

	Если ЗначениеЗаполнено(ЯвноеЗначение) Тогда
		Возврат ЯвноеЗначение;
	КонецЕсли;

	Возврат алсав_ВыгрузкаCsvJson.ПолучитьСекрет(КлючСекрета);

КонецФункции

Функция СериализоватьВJSON(Данные)

	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Истина);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Истина;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные, НастройкиСериализации);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область Преобразования

Функция ДатаВISO(Дата)

	Возврат Формат(Дата, "ДФ=yyyy-MM-dd'T'HH:mm:ss") + "+03:00";

КонецФункции

Функция ТекстИлиПустаяСтрока(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Число(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));

КонецФункции

Функция БулевоИлиЛожь(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

