		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказКлиента</dataPath>
			<field>ЗаказКлиента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ клиента</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВариантКомплектацииНоменклатуры</dataPath>
			<field>ВариантКомплектацииНоменклатуры</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЕСТЬNULL(Состав.Номенклатура, ЗаказКлиентаТовары.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(Состав.Характеристика, ЗаказКлиентаТовары.Характеристика) КАК Характеристика,
	ЕСТЬNULL(Состав.Количество, 1) * ЗаказКлиентаТовары.Количество КАК Количество,
	Состав.ЭтоМатериалы КАК ЭтоМатериалы,
	Состав.ПутьВСборке КАК ПутьВСборке,
	Состав.ПутьВСборкеНоменклатура КАК ПутьВСборкеНоменклатура,
	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	Состав.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.алсав_СоставИзделий КАК Состав
		ПО (Состав.ПродуктНоменклатура = ЗаказКлиентаТовары.Номенклатура)
			И (ЗаказКлиентаТовары.Характеристика IS NULL OR Состав.ПродуктХарактеристика = ЗаказКлиентаТовары.Характеристика)
			И (&amp;РаскрыватьДоМатериалов
				ИЛИ Состав.ЭтоМатериалы = ЛОЖЬ)
ГДЕ
	ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется)
	И ЗаказКлиентаТовары.Ссылка.Проведен</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
