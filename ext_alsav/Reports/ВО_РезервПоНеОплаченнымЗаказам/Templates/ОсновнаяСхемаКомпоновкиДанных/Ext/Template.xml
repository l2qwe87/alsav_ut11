		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Заказы.ЗаказКлиента,
	ЕСТЬNULL(Состав.Номенклатура,Заказы.Номенклатура) Номенклатура,
	ЕСТЬNULL(Состав.Характеристика, Заказы.Характеристика) Характеристика,
	ЕСТЬNULL(Состав.Количество, 1) * ЕСТЬNULL(Заказы.ВРезерве, 0) + ЕСТЬNULL(Состав.Количество, 1) * ЕСТЬNULL(Заказы.КОтгрузке, 0) КАК ВРезерве,
	
	ГрафикОплаты.ПроцентКредита,
	СостоянияЗаказов.ПроцентОплаты,
	СостоянияЗаказов.ОплаченПоУсловиюСоглашения КАК ОплаченПоУсловиюСоглашения,
	СостоянияЗаказов.ЕстьОплата КАК ЕстьОплата 	
ИЗ
	(ВЫБРАТЬ
		ВТ_Заказы.Номенклатура КАК Номенклатура,
		ВТ_Заказы.Характеристика КАК Характеристика,
		ВТ_Заказы.Склад КАК Склад,
		ВТ_Заказы.Заказ КАК Заказ,
		ВТ_Заказы.Заказ КАК ЗаказКлиента,
		ВТ_Заказы.ВРезерве КАК ВРезерве,
		ВТ_Заказы.КОтгрузке КАК КОтгрузке,
		ВТ_Заказы.НеОбеспечено КАК ВЗаказе
	ИЗ
		(ВЫБРАТЬ
			ВТ_Заказы.Номенклатура КАК Номенклатура,
			ВТ_Заказы.Характеристика КАК Характеристика,
			ВТ_Заказы.Склад КАК Склад,
			ВТ_Заказы.Заказ КАК Заказ,
			ВТ_Заказы.ВРезерве КАК ВРезерве,
			ВТ_Заказы.КОтгрузке КАК КОтгрузке,
			ВТ_Заказы.НеОбеспечено КАК НеОбеспечено
		ИЗ
			(ВЫБРАТЬ
				ТоварыКОтгрузке.Номенклатура КАК Номенклатура,
				ТоварыКОтгрузке.Характеристика КАК Характеристика,
				ТоварыКОтгрузке.Склад КАК Склад,
				ТоварыКОтгрузке.ДокументОтгрузки КАК Заказ,
				ТоварыКОтгрузке.ВРезервеОстаток КАК ВРезерве,
				ТоварыКОтгрузке.КОтгрузкеОстаток КАК КОтгрузке,
				0 КАК НеОбеспечено
			ИЗ
				РегистрНакопления.ТоварыКОтгрузке.Остатки(, ) КАК ТоварыКОтгрузке) КАК ВТ_Заказы
				) КАК ВТ_Заказы
	)КАК Заказы
	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СостоянияЗаказов.Заказ КАК ЗаказКлиента,
			ВЫБОР
				КОГДА СостоянияЗаказов.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ОжидаетсяАвансДоОбеспечения), ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ОжидаетсяПредоплатаДоОтгрузки))
					ТОГДА ЛОЖЬ
				ИНАЧЕ ИСТИНА
			КОНЕЦ КАК ОплаченПоУсловиюСоглашения,
			ВЫБОР
				КОГДА ЕСТЬNULL(СостоянияЗаказов.ПроцентОплаты, 0) &gt;= &amp;ПроцентОплаты
					ТОГДА ИСТИНА
				ИНАЧЕ ЛОЖЬ
			КОНЕЦ КАК ЕстьОплата,
			СостоянияЗаказов.ПроцентОплаты КАК ПроцентОплаты
		ИЗ
			РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказов) КАК СостоянияЗаказов
		ПО (СостоянияЗаказов.ЗаказКлиента = Заказы.ЗаказКлиента)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка КАК Ссылка,
			СУММА(ЗаказКлиентаЭтапыГрафикаОплаты.ПроцентПлатежа) КАК ПроцентКредита
		ИЗ
			Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЗаказКлиентаЭтапыГрафикаОплаты
		ГДЕ
			ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Проведен = ИСТИНА
			И ЗаказКлиентаЭтапыГрафикаОплаты.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки)
		
		СГРУППИРОВАТЬ ПО
			ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка) КАК ГрафикОплаты
		ПО (ГрафикОплаты.Ссылка = Заказы.ЗаказКлиента)
		
	
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.алсав_СоставИзделий КАК Состав
		ПО &amp;РаскрыватьСостав И (Состав.ПродуктНоменклатура = Заказы.Номенклатура)
			И (Состав.ПродуктХарактеристика = Заказы.Характеристика)
			И (&amp;РаскрыватьДоМатериалов ИЛИ Состав.ЭтоМатериалы = ЛОЖЬ)

ГДЕ
	ЕСТЬNULL(Заказы.ВРезерве, 0) + ЕСТЬNULL(Заказы.КОтгрузке, 0) &gt; 0
{
	ГДЕ ЕСТЬNULL(Состав.Номенклатура,Заказы.Номенклатура) = &amp;Номенклатура
}
{
	ГДЕ ЕСТЬNULL(Состав.Характеристика,Заказы.Характеристика) = &amp;Характеристика
}</query>
