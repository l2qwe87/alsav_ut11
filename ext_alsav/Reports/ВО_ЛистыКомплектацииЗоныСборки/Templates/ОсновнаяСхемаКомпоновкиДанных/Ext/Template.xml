		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Т.Номенклатура КАК Номенклатура,
	Т.Характеристика КАК Характеристика,
	Т.Количество КАК Количество,
	"Номер счета" КАК ТекстЗаголовокГруппы,
	Т.ЗаказКлиента КАК ЗаказКлиента,
	Т.НомерСчета КАК НомерСчета,
	СостоянияЗаказовКлиентов.ПроцентОтгрузки КАК ПроцентОтгрузки,
	Т.ДатаОтгрузки КАК ДатаОтгрузки,
	Рек_Серия.Значение КАК Серия
ИЗ
	(ВЫБРАТЬ
		ЕСТЬNULL(ВТ_ВариантыКомплектацииНоменклатуры.Номенклатура, ВТ_Заказы.Номенклатура) КАК Номенклатура,
		ЕСТЬNULL(ВТ_ВариантыКомплектацииНоменклатуры.Характеристика, ВТ_Заказы.Характеристика) КАК Характеристика,
		ЕСТЬNULL(ВТ_ВариантыКомплектацииНоменклатуры.Количество, 1) * ВТ_Заказы.Количество КАК Количество,
		ВТ_Заказы.Ссылка.Номер КАК НомерСчета,
		ВТ_Заказы.Ссылка КАК ЗаказКлиента,
		ВТ_Заказы.ДатаОтгрузки КАК ДатаОтгрузки
	ИЗ
		Документ.ЗаказКлиента.Товары КАК ВТ_Заказы
			//ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			//	ВариантыКомплектацииНоменклатуры.Ссылка КАК Ссылка,
			//	ВариантыКомплектацииНоменклатуры.Ссылка.Владелец КАК НоменклатураОсновногоКомпонента,
			//	ВариантыКомплектацииНоменклатуры.Ссылка.Характеристика КАК ХарактеристикаОсновногоКомпонента,
			//	ВариантыКомплектацииНоменклатуры.Номенклатура.Наименование + ЕСТЬNULL(" \ " + Полуфабрикаты.Номенклатура.Наименование, "") КАК НоменклатураПутьСборки,
			//	ЕСТЬNULL(Полуфабрикаты.Номенклатура, ВариантыКомплектацииНоменклатуры.Номенклатура) КАК Номенклатура,
			//	ЕСТЬNULL(Полуфабрикаты.Характеристика, ВариантыКомплектацииНоменклатуры.Характеристика) КАК Характеристика,
			//	ЕСТЬNULL(Полуфабрикаты.Количество, 1) * ВариантыКомплектацииНоменклатуры.Количество КАК Количество,
			//	ВариантыКомплектацииНоменклатуры.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат
			//ИЗ
			//	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатуры
			//		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Полуфабрикаты
			//		ПО ВариантыКомплектацииНоменклатуры.ВариантКомлектации = Полуфабрикаты.Ссылка
			//			И (Полуфабрикаты.Ссылка.ПометкаУдаления = ЛОЖЬ)
			//			И (Полуфабрикаты.Ссылка.Основной = ИСТИНА)
			//ГДЕ
			//	ВариантыКомплектацииНоменклатуры.Ссылка.Основной = ИСТИНА
			//	И ВариантыКомплектацииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ) КАК ВТ_ВариантыКомплектацииНоменклатуры
			ЛЕВОЕ СОЕДИНЕНИЕ ( ВЫБРАТЬ 
				состав.ВариантКомплектацииНоменклатуры КАК Ссылка,
				состав.ПродуктНоменклатура КАК НоменклатураОсновногоКомпонента,
				состав.ПродуктХарактеристика КАК ХарактеристикаОсновногоКомпонента,
				состав.ПутьВСборке КАК НоменклатураПутьСборки,
				состав.Номенклатура КАК Номенклатура,
				состав.Характеристика КАК Характеристика,
				состав.Количество КАК Количество,
				состав.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат			
			ИЗ 
				РегистрСведений.алсав_СоставИзделий КАК состав  
			ГДЕ
				состав.ЭтоПолуфабрикат = ЛОЖЬ
				И состав.ЭтоМатериалы = ЛОЖЬ
			)КАК ВТ_ВариантыКомплектацииНоменклатуры
			ПО (ВТ_ВариантыКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = ВТ_Заказы.Номенклатура)
				И (ВТ_Заказы.Характеристика ЕСТЬ NULL
					ИЛИ ВТ_Заказы.Характеристика = ВТ_ВариантыКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента)
	ГДЕ
		ВТ_Заказы.ВариантОбеспечения В (ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ИзЗаказов), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно))
	{ГДЕ
		(ВТ_Заказы.Ссылка В (&amp;ЗаказыКлиентов)),
		(ВТ_Заказы.Ссылка В
				(ВЫБРАТЬ
					РО.ЗаказКлиента КАК ЗаказКлиента
				ИЗ
					Документ.УБ_РаспоряжениеНаОтгрузку.Товары КАК РО
				ГДЕ
					РО.Ссылка = &amp;РаспоряжениеНаОтгрузку
				СГРУППИРОВАТЬ ПО
					РО.ЗаказКлиента)),
		(ВТ_Заказы.Ссылка В
				(ВЫБРАТЬ
					УБ_ОтчетПоНаличиюНаСкладе.Заказ КАК ЗаказКлиента
				ИЗ
					Документ.УБ_ОтчетПоНаличиюНаСкладе.Заказы КАК УБ_ОтчетПоНаличиюНаСкладе
				ГДЕ
					УБ_ОтчетПоНаличиюНаСкладе.Ссылка = &amp;ОтчетПоНаличиюНаСкладе
				СГРУППИРОВАТЬ ПО
					УБ_ОтчетПоНаличиюНаСкладе.Заказ))}) КАК Т
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО Т.ЗаказКлиента = СостоянияЗаказовКлиентов.Заказ
		
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты Рек_Серия 
		   		ПО Рек_Серия.Ссылка = Т.Номенклатура И 
		   			Рек_Серия.Свойство.Заголовок = "Серия"
ГДЕ
	Т.ЗаказКлиента.Проведен
	И Т.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор))</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
