		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВТ_Заказы.Ссылка.Номер КАК НомерЗаказаПоставщику,
	ВТ_Заказы.Ссылка КАК ЗаказПоставщику,
	комплектация.Номенклатура.Артикул КАК Артикул,
	комплектация.Номенклатура КАК Номенклатура,
	комплектация.Характеристика КАК Характеристика,
	комплектация.Упаковка КАК Упаковка,
	комплектация.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат,
	ВТ_Заказы.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
	комплектация.Количество КАК Количество,
	ВТ_Заказы.КоличествоУпаковок КАК КоличествоРодитель,
	комплектация.Количество * ВТ_Заказы.КоличествоУпаковок КАК Всего,
	ДР_СписыватьМатериалы.Значение КАК СписыватьМатериалы,
	ISNULL(ДР_НомерПакетаЗаданий.Значение,"НЕ ЗАПОЛНЕН") КАК НомерПакетаЗаданий
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ВТ_Заказы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК комплектация
		ПО (комплектация.Ссылка = ВТ_Заказы.ВариантКомплектацииНоменклатуры)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДР_СписыватьМатериалы
		ПО (ДР_СписыватьМатериалы.Свойство.Заголовок = "Списывать материалы")
			И (ДР_СписыватьМатериалы.Ссылка = комплектация.Номенклатура)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.ДополнительныеРеквизиты КАК ДР_НомерПакетаЗаданий
		ПО (ДР_НомерПакетаЗаданий.Свойство.Заголовок = "Номер пакета заданий")
			И (ДР_НомерПакетаЗаданий.Ссылка = ВТ_Заказы.Ссылка)
{ГДЕ
	(ВТ_Заказы.Ссылка = &amp;ЗаказПоставщику),
	(ВТ_Заказы.Ссылка В (&amp;ЗаказыПоставщику)),
	(ДР_СписыватьМатериалы.Значение В (&amp;СписыватьМатериалы))}</query>
