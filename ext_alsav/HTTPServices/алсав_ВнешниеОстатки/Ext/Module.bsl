#Область ОбработчикиHTTPЗапросов

// Обработчик HTTP-метода GET /balances.
// Возвращает остатки номенклатуры в формате JSON.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - входящий HTTP-запрос.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с JSON-массивом остатков или описанием ошибки.
Функция BalancesGET(Запрос)
	
	// ПараметрыЗапроса - Структура - параметры строки запроса.
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	
	// Группы - Массив из Строка - идентификаторы групп номенклатуры.
	Группы = ПолучитьСписокИдентификаторов(ПараметрыЗапроса, "groups");
	Если Группы.Количество() = 0 Тогда
		Возврат СформироватьОтветОшибки(400, "Не передан обязательный параметр groups");
	КонецЕсли;
	
	// СсылкиГрупп - Массив из СправочникСсылка.Номенклатура - группы отбора.
	СсылкиГрупп = НайтиЭлементыСправочника(Группы, Справочники.Номенклатура);
	Если СсылкиГрупп = Неопределено Тогда
		Возврат СформироватьОтветОшибки(400, "Не найдены группы номенклатуры из параметра groups");
	КонецЕсли;
	
	// ИдентификаторыИсключений - Массив из Строка - идентификаторы исключаемых групп.
	ИдентификаторыИсключений = ПолучитьСписокИдентификаторов(ПараметрыЗапроса, "excludeGroups");
	// СсылкиИсключений - Массив из СправочникСсылка.Номенклатура - исключаемые группы.
	СсылкиИсключений = Новый Массив;
	Если ИдентификаторыИсключений.Количество() > 0 Тогда
		СсылкиИсключений = НайтиЭлементыСправочника(ИдентификаторыИсключений, Справочники.Номенклатура);
		Если СсылкиИсключений = Неопределено Тогда
			Возврат СформироватьОтветОшибки(400, "Не найдены группы номенклатуры из параметра excludeGroups");
		КонецЕсли;
	КонецЕсли;
	
	// ИдентификаторВидаЦены - Строка - наименование или UUID вида цены.
	ИдентификаторВидаЦены = ПолучитьЗначениеПараметра(ПараметрыЗапроса, "priceType");
	Если Не ЗначениеЗаполнено(ИдентификаторВидаЦены) Тогда
		Возврат СформироватьОтветОшибки(400, "Не передан обязательный параметр priceType");
	КонецЕсли;
	
	// ВидЦены - СправочникСсылка.ВидыЦен - вид цены для запроса.
	ВидЦены = НайтиЭлементСправочника(ИдентификаторВидаЦены, Справочники.ВидыЦен);
	Если ВидЦены = Неопределено Тогда
		Возврат СформироватьОтветОшибки(400, "Не найден вид цены: " + Строка(ИдентификаторВидаЦены));
	КонецЕсли;
	
	// ПроцентОплаты - Число - минимальный процент оплаты заказа.
	ПроцентОплаты = 0;
	// ЗначениеПроцента - Произвольный - значение параметра paymentPercent.
	ЗначениеПроцента = ПолучитьЗначениеПараметра(ПараметрыЗапроса, "paymentPercent");
	Если ЗначениеЗаполнено(ЗначениеПроцента) Тогда
		Если Не ЭтоКорректноеЧисло(ЗначениеПроцента) Тогда
			Возврат СформироватьОтветОшибки(400, "Параметр paymentPercent должен быть числом");
		КонецЕсли;
		ПроцентОплаты = СтрокаВЧисло(ЗначениеПроцента);
	КонецЕсли;
	
	// ТаблицаОстатков - ТаблицаЗначений - результат выполнения запроса.
	ТаблицаОстатков = ПолучитьОстатки(СсылкиГрупп, СсылкиИсключений, ВидЦены, ПроцентОплаты);
	
	Возврат СформироватьОтветJSON(200, ПреобразоватьТаблицуВМассив(ТаблицаОстатков));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает список идентификаторов из параметра запроса.
//
// Параметры:
//   ПараметрыЗапроса - ФиксированноеСоответствие, Неопределено - параметры входящего запроса.
//   ИмяПараметра - Строка - имя параметра.
//
// Возвращаемое значение:
//   Массив из Строка - идентификаторы из параметра.
Функция ПолучитьСписокИдентификаторов(ПараметрыЗапроса, ИмяПараметра)
	
	// Результат - Массив из Строка - найденные идентификаторы.
	Результат = Новый Массив;
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Значение - Произвольный - значение параметра.
	Значение = ПараметрыЗапроса.Получить(ИмяПараметра);
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ДобавитьИдентификаторы(Результат, Элемент);
		КонецЦикла;
	Иначе
		ДобавитьИдентификаторы(Результат, Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет идентификаторы из значения параметра в результирующий массив.
//
// Параметры:
//   Результат - Массив из Строка - массив для добавления.
//   Значение - Произвольный - значение параметра.
Процедура ДобавитьИдентификаторы(Результат, Значение)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Текст - Строка - строковое представление значения.
	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	// Части - Массив из Строка - идентификаторы, разделенные запятой или точкой с запятой.
	Части = СтрРазделить(Текст, ",;", Ложь);
	Для Каждого Часть Из Части Цикл
		Часть = СокрЛП(Часть);
		Если Не ПустаяСтрока(Часть) Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Извлекает одиночное значение параметра запроса.
//
// Параметры:
//   ПараметрыЗапроса - ФиксированноеСоответствие, Неопределено - параметры входящего запроса.
//   ИмяПараметра - Строка - имя параметра.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - значение параметра.
Функция ПолучитьЗначениеПараметра(ПараметрыЗапроса, ИмяПараметра)
	
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Значение - Произвольный - значение параметра.
	Значение = ПараметрыЗапроса.Получить(ИмяПараметра);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значение[0];
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Ищет элементы справочника по наименованию или уникальному идентификатору.
//
// Параметры:
//   Идентификаторы - Массив из Строка - наименования или UUID элементов.
//   МенеджерСправочника - СправочникМенеджер - менеджер справочника.
//
// Возвращаемое значение:
//   Массив, Неопределено - найденные ссылки или Неопределено, если хотя бы один элемент не найден.
Функция НайтиЭлементыСправочника(Идентификаторы, МенеджерСправочника)
	
	// Результат - Массив - найденные ссылки.
	Результат = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		// Ссылка - СправочникСсылка, Неопределено - найденная ссылка.
		Ссылка = НайтиЭлементСправочника(Идентификатор, МенеджерСправочника);
		Если Ссылка = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ищет элемент справочника по наименованию или уникальному идентификатору.
//
// Параметры:
//   Идентификатор - Строка - наименование или UUID элемента.
//   МенеджерСправочника - СправочникМенеджер - менеджер справочника.
//
// Возвращаемое значение:
//   СправочникСсылка, Неопределено - найденная ссылка или Неопределено.
Функция НайтиЭлементСправочника(Идентификатор, МенеджерСправочника)
	
	// ТекстИдентификатора - Строка - строковое представление идентификатора.
	ТекстИдентификатора = СокрЛП(Строка(Идентификатор));
	Если ПустаяСтрока(ТекстИдентификатора) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Ссылка - СправочникСсылка - найденная ссылка.
	Ссылка = МенеджерСправочника.НайтиПоНаименованию(ТекстИдентификатора, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Если ЭтоУникальныйИдентификатор(ТекстИдентификатора) Тогда
		// ИдентификаторUUID - Строка - UUID без фигурных скобок.
		ИдентификаторUUID = ТекстИдентификатора;
		Если Лев(ИдентификаторUUID, 1) = "{" И Прав(ИдентификаторUUID, 1) = "}" Тогда
			ИдентификаторUUID = Сред(ИдентификаторUUID, 2, СтрДлина(ИдентификаторUUID) - 2);
		КонецЕсли;
		Ссылка = МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторUUID));
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Проверяет, является ли значение строкой уникального идентификатора.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение является строкой UUID.
Функция ЭтоУникальныйИдентификатор(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Текст - Строка - проверяемая строка.
	Текст = СокрЛП(Значение);
	Если Лев(Текст, 1) = "{" И Прав(Текст, 1) = "}" Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;
	
	Если СтрДлина(Текст) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Позиция = 1 По 36 Цикл
		// Символ - Строка - текущий символ проверяемой строки.
		Символ = Сред(Текст, Позиция, 1);
		Если Позиция = 9 ИЛИ Позиция = 14 ИЛИ Позиция = 19 ИЛИ Позиция = 24 Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Если СтрНайти("0123456789abcdefABCDEF", Символ) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, что значение можно преобразовать в число.
//
// Параметры:
//   Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значение является числом или числовой строкой.
Функция ЭтоКорректноеЧисло(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Текст - Строка - нормализованное строковое представление числа.
	Текст = СокрЛП(СтрЗаменить(Значение, ",", "."));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Лев(Текст, 1) = "-" Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 1);
	КонецЕсли;
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Части - Массив из Строка - целая и дробная части числа.
	Части = СтрРазделить(Текст, ".", Истина);
	Если Части.Количество() > 2 ИЛИ ПустаяСтрока(Части[0]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Часть Из Части Цикл
		Если Не ЭтоТолькоЦифры(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, что строка состоит только из цифр.
//
// Параметры:
//   Текст - Строка - проверяемая строка.
//
// Возвращаемое значение:
//   Булево - Истина, если строка непустая и состоит только из цифр.
Функция ЭтоТолькоЦифры(Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Преобразует значение в число.
//
// Параметры:
//   Значение - Произвольный - число или числовая строка.
//
// Возвращаемое значение:
//   Число - преобразованное значение.
Функция СтрокаВЧисло(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Число(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));
	
КонецФункции

// Возвращает текст внутреннего запроса из макета обработки.
//
// Возвращаемое значение:
//   Строка - текст запроса из СКД.
Функция ПолучитьТекстВнутреннегоЗапроса()
	
	// СхемаКомпоновкиДанных - СхемаКомпоновкиДанных - макет с запросом остатков.
	СхемаКомпоновкиДанных = Обработки.алсав_ВыгрузкаФайла_ПрайсОсновной.ПолучитьМакет("ЗапросДляВыгрузки");
	
	Возврат СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос;
	
КонецФункции

// Выполняет запрос остатков.
//
// Параметры:
//   ГруппыНоменклатуры - Массив из СправочникСсылка.Номенклатура - группы отбора.
//   ГруппыИсключения - Массив из СправочникСсылка.Номенклатура - исключаемые группы.
//   ВидЦены - СправочникСсылка.ВидыЦен - вид цены.
//   ПроцентОплаты - Число - минимальный процент оплаты заказа.
//
// Возвращаемое значение:
//   ТаблицаЗначений - остатки номенклатуры.
Функция ПолучитьОстатки(ГруппыНоменклатуры, ГруппыИсключения, ВидЦены, ПроцентОплаты)
	
	// ТекстВнутреннегоЗапросаИзСКД - Строка - запрос из СКД.
	ТекстВнутреннегоЗапросаИзСКД = ПолучитьТекстВнутреннегоЗапроса();
	
	// ТекстЗапроса - Строка - итоговый текст запроса.
	ТекстЗапроса =
	"ВЫБРАТЬ
	| Т.Серия.Наименование КАК Серия,
	| Т.ПродуктШтрихкод КАК Штрихкод,
	| Т.ПродуктНоменклатура.Артикул КАК Артикул,
	| Т.ПродуктНоменклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения,
	| Т.ПродуктНоменклатура.Наименование КАК Номенклатура,
	| Т.ПродуктХарактеристика.Наименование КАК Характеристика,
	| Т.ПродуктЦена КАК ОтпускнаяЦена,
	| Т.ПродуктНоменклатура.ВидНоменклатуры.Наименование КАК ВидНоменклатуры,
	| MIN(Т.ВозможностьСобрать) КАК Остатки
	|ИЗ (" + ТекстВнутреннегоЗапросаИзСКД + "
	| ) КАК Т
	|ГДЕ Т.ПродуктНоменклатура В ИЕРАРХИИ (&группыНоманклатуры)
	|  И Т.ПродуктНоменклатура НЕ В ИЕРАРХИИ (&группыНоманклатурыИсключения)
	|СГРУППИРОВАТЬ ПО
	| Т.Серия, Т.ПродуктШтрихкод, Т.ПродуктНоменклатура.Артикул, Т.ПродуктНоменклатура, Т.ПродуктХарактеристика, Т.ПродуктЦена, Т.ПродуктНоменклатура.ВидНоменклатуры
	|//| ИМЕЮЩИЕ MIN(Т.ВозможностьСобрать) >= 1
	|УПОРЯДОЧИТЬ ПО Т.Серия";
	
	// Запрос - Запрос - выполняемый запрос.
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("группыНоманклатуры", ГруппыНоменклатуры);
	Запрос.УстановитьПараметр("группыНоманклатурыИсключения", ГруппыИсключения);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("ПроцентОплаты", ПроцентОплаты);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	// Результат - ТаблицаЗначений - результат запроса.
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Преобразует таблицу остатков в массив структур для JSON.
//
// Параметры:
//   ТаблицаОстатков - ТаблицаЗначений - остатки номенклатуры.
//
// Возвращаемое значение:
//   Массив из Структура - данные для сериализации.
Функция ПреобразоватьТаблицуВМассив(ТаблицаОстатков)
	
	// Данные - Массив из Структура - массив строк ответа.
	Данные = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаОстатков Цикл
		// Элемент - Структура - одна строка ответа.
		Элемент = Новый Структура;
		Элемент.Вставить("series", ТекстИлиПустаяСтрока(СтрокаТаблицы.Серия));
		Элемент.Вставить("barcode", ТекстИлиПустаяСтрока(СтрокаТаблицы.Штрихкод));
		Элемент.Вставить("article", ТекстИлиПустаяСтрока(СтрокаТаблицы.Артикул));
		Элемент.Вставить("unit", ТекстИлиПустаяСтрока(СтрокаТаблицы.ЕдиницаИзмерения));
		Элемент.Вставить("name", ТекстИлиПустаяСтрока(СтрокаТаблицы.Номенклатура));
		Элемент.Вставить("characteristic", ТекстИлиПустаяСтрока(СтрокаТаблицы.Характеристика));
		Элемент.Вставить("price", ЧислоИлиНоль(СтрокаТаблицы.ОтпускнаяЦена));
		Элемент.Вставить("type", ТекстИлиПустаяСтрока(СтрокаТаблицы.ВидНоменклатуры));
		Элемент.Вставить("balance", ЧислоИлиНоль(СтрокаТаблицы.Остатки));
		Данные.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// Возвращает строку или пустую строку для пустого значения.
//
// Параметры:
//   Значение - Произвольный - исходное значение.
//
// Возвращаемое значение:
//   Строка - строковое представление значения.
Функция ТекстИлиПустаяСтрока(Значение)
	
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

// Возвращает число или 0 для пустого значения.
//
// Параметры:
//   Значение - Произвольный - исходное значение.
//
// Возвращаемое значение:
//   Число - числовое представление значения.
Функция ЧислоИлиНоль(Значение)
	
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат СтрокаВЧисло(Значение);
	
КонецФункции

// Формирует JSON-ответ.
//
// Параметры:
//   КодСостояния - Число - HTTP-код состояния.
//   Данные - Произвольный - данные для сериализации.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - сформированный ответ.
Функция СформироватьОтветJSON(КодСостояния, Данные)
	
	// Ответ - HTTPСервисОтвет - ответ HTTP-сервиса.
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СериализоватьВJSON(Данные), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

// Формирует JSON-ответ с описанием ошибки.
//
// Параметры:
//   КодСостояния - Число - HTTP-код состояния.
//   Описание - Строка - описание ошибки.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - сформированный ответ.
Функция СформироватьОтветОшибки(КодСостояния, Описание)
	
	// Результат - Структура - описание ошибки.
	Результат = Новый Структура;
	Результат.Вставить("error", Описание);
	
	Возврат СформироватьОтветJSON(КодСостояния, Результат);
	
КонецФункции

// Сериализует данные в JSON.
//
// Параметры:
//   Данные - Произвольный - данные для сериализации.
//
// Возвращаемое значение:
//   Строка - JSON-представление данных.
Функция СериализоватьВJSON(Данные)
	
	// НастройкиСериализации - НастройкиСериализацииJSON - настройки сериализации.
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	
	// ПараметрыЗаписи - ПараметрыЗаписиJSON - параметры записи JSON.
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "", Истина);
	
	// ЗаписьJSON - ЗаписьJSON - объект записи JSON.
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Истина;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные, НастройкиСериализации);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти
