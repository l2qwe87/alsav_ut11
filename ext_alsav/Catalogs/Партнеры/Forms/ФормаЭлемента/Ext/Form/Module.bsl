
&НаСервере
Процедура алсав_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	Если УправлениеДоступом.ЕстьРоль(Метаданные.Роли.АЛСАВ_ЗапретРедактированияПартнёровКромеКонтактнойИнформации.Имя)
		И НЕ УправлениеДоступом.ЕстьРоль(Метаданные.Роли.ПолныеПрава.Имя) Тогда

		Элементы.ГруппаОбщаяИнформация.ТолькоПросмотр = Истина;
		Элементы.ГруппаДополнительнаяИнформация.ТолькоПросмотр = Истина;

	КонецЕсли;

	алсав_ОбновитьДоступностьAPIКлючей();
	алсав_ПрочитатьAPIКлюч();
КонецПроцедуры

&НаСервере
Процедура алсав_ОбновитьДоступностьAPIКлючей()

	ЕстьПраво = УправлениеДоступом.ЕстьРоль(Метаданные.Роли.АЛСАВ_УправлениеAPIключамиКлиентов.Имя);

	Элементы.ГруппаAPIКлюч.Отображается = ЕстьПраво;
	Элементы.ГруппаAPIКлюч.Доступен = ЕстьПраво;
	Элементы.СгенерироватьAPIКлюч.Доступен = ЕстьПраво;
	Элементы.УдалитьAPIКлюч.Доступен = ЕстьПраво;

КонецПроцедуры

&НаСервере
Процедура алсав_ПрочитатьAPIКлюч()

	Клиент = Объект.Ссылка;
	Если ЗначениеЗаполнено(Клиент) Тогда
		ТекущийКлюч = алсав_ПолучитьAPIКлюч(Клиент);
	Иначе
		ТекущийКлюч = "";
	КонецЕсли;

	APIKey = ТекущийКлюч;
	ЕстьAPIКлюч = НЕ ПустаяСтрока(ТекущийКлюч);
	Элементы.УдалитьAPIКлюч.Доступен = ЕстьAPIКлюч;

КонецПроцедуры

&НаСервере
Процедура алсав_СгенерироватьAPIКлючПосле(Команда)

	Клиент = Объект.Ссылка;
	Если НЕ ЗначениеЗаполнено(Клиент) Тогда
		ВызватьИсключение("Перед созданием API-ключа нужно записать клиента");
	КонецЕсли;

	СтарыйКлюч = алсав_ПолучитьAPIКлюч(Клиент);
	НовыйКлюч = алсав_СинхронизацияОстатков.СгенерироватьAPIКлюч();
	ClientId = Строка(Клиент.УникальныйИдентификатор());
	ДатаСоздания = ТекущаяУниверсальнаяДата();

	алсав_СинхронизацияОстатков.ЗаписатьAPIКлюч(НовыйКлюч, ClientId, ДатаСоздания);
	Если НЕ ПустаяСтрока(СтарыйКлюч) Тогда
		алсав_СинхронизацияОстатков.УдалитьAPIКлюч(СтарыйКлюч);
	КонецЕсли;

	алсав_ЗаписатьAPIКлючВРегистр(Клиент, НовыйКлюч, ClientId, ДатаСоздания);
	алсав_ПрочитатьAPIКлюч();

КонецПроцедуры

&НаСервере
Процедура алсав_УдалитьAPIКлючПосле(Команда)

	Клиент = Объект.Ссылка;
	ТекущийКлюч = алсав_ПолучитьAPIКлюч(Клиент);
	Если ПустаяСтрока(ТекущийКлюч) Тогда
		Возврат;
	КонецЕсли;

	алсав_СинхронизацияОстатков.УдалитьAPIКлюч(ТекущийКлюч);
	алсав_УдалитьAPIКлючИзРегистра(Клиент);
	алсав_ПрочитатьAPIКлюч();

КонецПроцедуры

&НаСервере
Функция алсав_ПолучитьAPIКлюч(Клиент)

	Отбор = Новый Структура;
	Отбор.Вставить("Клиент", Клиент);
	Выборка = РегистрыСведений.алсав_APIКлючиКлиентов.Выбрать(Неопределено, Неопределено, Отбор);
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Ключ);
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Процедура алсав_ЗаписатьAPIКлючВРегистр(Клиент, Ключ, ClientId, CreatedAt)

	Набор = РегистрыСведений.алсав_APIКлючиКлиентов.СоздатьНаборЗаписей();
	Набор.Отбор.Клиент.Установить(Клиент);
	Набор.Записать();

	Запись = Набор.Добавить();
	Запись.Клиент = Клиент;
	Запись.Ключ = Ключ;
	Запись.ClientId = ClientId;
	Запись.CreatedAt = CreatedAt;
	Набор.Записать();

КонецПроцедуры

&НаСервере
Процедура алсав_УдалитьAPIКлючИзРегистра(Клиент)

	Набор = РегистрыСведений.алсав_APIКлючиКлиентов.СоздатьНаборЗаписей();
	Набор.Отбор.Клиент.Установить(Клиент);
	Набор.Записать();

КонецПроцедуры
