КонецФУнкции

Функция ПолучитьТекстЗапросИмеетВариантКомплектации()
	ТекстЗапроса ="ВЫБРАТЬ
	              |	Номенклатура.Ссылка КАК Номенклатура,
	              |	МАКСИМУМ(НЕ Таблица.Ссылка ЕСТЬ NULL) КАК ИмеетВариантКомплектации
	              |ИЗ
	              |	Справочник.Номенклатура КАК Номенклатура
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРекв
	              |		ПО (ДопРекв.Ссылка = Номенклатура.Ссылка)
	              |			И (ДопРекв.Свойство.Заголовок = &имяДопРеквизитаИмеетВариантКомплектации)
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК Таблица
	              |		ПО (Таблица.Владелец = Номенклатура.Ссылка)
	              |			И (НЕ Таблица.Ссылка.ПометкаУдаления)
	              |			И (Таблица.ЭтоМатериалы = &ЭтоМатериалы)
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	Номенклатура.Ссылка,
	              |	Таблица.Ссылка,
	              |	ДопРекв.Значение
	              |
	              |ИМЕЮЩИЕ
	              |	((НЕ Таблица.Ссылка ЕСТЬ NULL) <> ЕСТЬNULL(ДопРекв.Значение, ЛОЖЬ)
	              |		ИЛИ ДопРекв.Значение ЕСТЬ NULL)";
	
	Возврат ТекстЗапроса
				   
КонецФУнкции

Функция ВесНетто(Номенклатура) Экспорт
	свойствоНаименование = "Вес (нетто), кг";
	
	весНетто = алсав_ДопРеквизиты.ПолучитьДопРеквизит(Номенклатура, свойствоНаименование);
	
	Если весНетто = неопределено Тогда
		возврат 0.0;
	Иначе
		возврат весНетто;
	КонецЕсли;
	
КонецФункции

Функция Вес(Номенклатура)Экспорт
	Возврат ?(Номенклатура.ВесЗнаменатель > 0 ,
		Номенклатура.ВесЧислитель / Номенклатура.ВесЗнаменатель,
		0);
КонецФункции

Функция Объем(Номенклатура)Экспорт
	Возврат ?(Номенклатура.ОбъемЗнаменатель > 0 ,
		Номенклатура.ОбъемЧислитель / Номенклатура.ОбъемЗнаменатель,
		0);
КонецФункции


Функция ЗаполнитьВесИОбъем(номенклатура = Неопределено) ЭКСПОРТ
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВариантыКомплектацииНоменклатуры.Владелец КАК Номенклатура,
				   |	ВариантыКомплектацииНоменклатуры.Владелец.ОбъемИспользовать КАК ОбъемИспользовать,
				   |	ВариантыКомплектацииНоменклатуры.Владелец.ВесИспользовать КАК ВесИспользовать,
	               |	МАКСИМУМ(ВариантыКомплектацииНоменклатуры.Ссылка) КАК Комплектация
	               |ИЗ
	               |	Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
	               |ГДЕ
	               |	ВариантыКомплектацииНоменклатуры.ПометкаУдаления = ЛОЖЬ
	               |	И ВариантыКомплектацииНоменклатуры.Основной = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВариантыКомплектацииНоменклатуры.Владелец";
	
	
	Если номенклатура <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"И ВариантыКомплектацииНоменклатуры.Основной = ИСТИНА",
			"И ВариантыКомплектацииНоменклатуры.Основной = ИСТИНА И ВариантыКомплектацииНоменклатуры.Владелец = &номенклатура"
		);
		
		Запрос.УстановитьПараметр("номенклатура",номенклатура);
			
	КонецЕсли;
	
	
	Рез = Запрос.Выполнить().Выбрать();
	
	Пока Рез.Следующий() Цикл
		
		Состав = АЛСАВ_Сборка.ПолучитьКомплектующиеНоменклатуры(Рез.Комплектация, неопределено, 1, истина);
		
		
		ВесЧисло = 0;
		ОбъёмЧисло = 0;
		ВесНеттоЧисло = 0;
		Для Каждого стр из Состав Цикл
			ВесЧисло = ВесЧисло + (алсав_ПечатьСчет.Вес(стр.Номенклатура, ИСТИНА) * (стр.Количество));
			ОбъёмЧисло = ОбъёмЧисло + (алсав_ПечатьСчет.Объем(стр.Номенклатура, ИСТИНА) * (стр.Количество));
			ВесНеттоЧисло = ВесНеттоЧисло + (Справочники.Номенклатура.ВесНетто(стр.Номенклатура) * (стр.Количество));
		КонецЦикла;
		
		
		Если ВесЧисло <> Справочники.Номенклатура.Вес(Рез.Номенклатура)
			ИЛИ ОбъёмЧисло <> Справочники.Номенклатура.Объем(Рез.Номенклатура)
			ИЛИ ВесНеттоЧисло <> Справочники.Номенклатура.ВесНетто(Рез.Номенклатура)
			ИЛИ (ВесЧисло = 0 И  Рез.ВесИспользовать ) 
			ИЛИ (ОбъёмЧисло = 0 И  Рез.ОбъемИспользовать )Тогда
			
			оНомен = Рез.Номенклатура.ПолучитьОбъект();
			Если Ложь Тогда оНомен = Справочники.Номенклатура.СоздатьЭлемент(); КонецЕсли;
			
			оНомен.ОбъемИспользовать = ОбъёмЧисло > 0;
			оНомен.ОбъемЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("кг");
			оНомен.ОбъемЧислитель = ОбъёмЧисло;
			оНомен.ОбъемЗнаменатель = 1;
			
			оНомен.ВесИспользовать = ВесЧисло > 0;
			оНомен.ВесЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("м3");
			оНомен.ВесЧислитель = ВесЧисло;
			оНомен.ВесЗнаменатель = 1;         
			
			алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(оНомен, "Вес (нетто), кг", ВесНеттоЧисло);
			
			оНомен.ОбменДанными.Загрузка = Истина;
			оНомен.Записать();
		КонецЕсли;
		
		
	КонецЦикла;	
КонецФункции

Функция ЗаполнитьГабаритыИКолвоУпаковок(номенклатура = Неопределено) ЭКСПОРТ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	алсав_СоставИзделий.ПродуктНоменклатура КАК ПродуктНоменклатура,
	               |	алсав_СоставИзделий.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	алсав_СоставИзделий.Глубина КАК Глубина,
	               |	алсав_СоставИзделий.Ширина КАК Ширина,
	               |	алсав_СоставИзделий.Высота КАК Высота
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		алсав_СоставИзделий.ПродуктНоменклатура КАК ПродуктНоменклатура,
	               |		алсав_СоставИзделий.ПродуктХарактеристика КАК ПродуктХарактеристика,
	               |		СУММА(алсав_СоставИзделий.Количество) КАК КоличествоУпаковок,
	               |		МАКСИМУМ(ВЫРАЗИТЬ(ДР_Глубина.Значение КАК ЧИСЛО)) КАК Глубина,
	               |		МАКСИМУМ(ВЫРАЗИТЬ(ДР_Ширина.Значение КАК ЧИСЛО)) КАК Ширина,
	               |		СУММА(ВЫРАЗИТЬ(ДР_Высота.Значение КАК ЧИСЛО) * алсав_СоставИзделий.Количество) КАК Высота
	               |	ИЗ
	               |		РегистрСведений.алсав_СоставИзделий КАК алсав_СоставИзделий
