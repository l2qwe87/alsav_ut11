Функция ПолучитьНовыйАртикул() ЭКСПОРТ
	началоНумератора = 555555;
	последнийАртикул = началоНумератора;
	маскаАртикула = "[0-9][0-9][0-9][0-9][0-9][0-9]";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(Номенклатура.Артикул) КАК Артикул
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Артикул ПОДОБНО &маскаАртикула";
	Запрос.УстановитьПараметр("маскаАртикула",маскаАртикула);
	
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		последнийАртикул = Число(рез.Артикул);
		Если последнийАртикул<началоНумератора Тогда
			последнийАртикул = началоНумератора;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Формат(последнийАртикул+1, "ЧГ=0");
КонецФункции

Функция ПолучитьНоменклатуруПоАртикулу(артикул)ЭКСПОРТ
	Запрос = Новый Запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Артикул = &Артикул
	               |	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("артикул",артикул);
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		Возврат рез.ССылка;
	КонецЕсли;
КонецФункции


Функция РасчитатьСреднемесячныйРасходЗа4Мес(Отбор = неопределено)ЭКСПОРТ
	имяДопРеквизитаСреднемесячныйРасход = "Среднемесячный расход за 4 мес.";
	
	количествоМесяцев = 4;
	началоПериода = ТекущаяДата() - (количествоМесяцев * 30 * 24 * 60 * 60);
	конецПериода = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаН", НачалоДня(началоПериода));
	Запрос.УстановитьПараметр("ДатаК", КонецДня(конецПериода));
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номен.Номенклатура КАК Номенклатура,
	               |	Номен.Характеристика КАК Характеристика,
	               |	ЕСТЬNULL(Списания.Количество, 0)+ЕСТЬNULL(Реализация.Количество, 0) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Номен.Ссылка КАК Номенклатура,
	               |		Хар.Ссылка КАК Характеристика
	               |	ИЗ
	               |		Справочник.Номенклатура КАК Номен
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК Хар
	               |			ПО (Хар.Владелец = Номен.Ссылка)) КАК Номен
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеНедостачТоваров.Товары КАК Списания
	               |		ПО Номен.Номенклатура = Списания.Номенклатура
	               |			И (Номен.Характеристика ЕСТЬ NULL)
	               |			И (Списания.Ссылка.Дата >= &ДатаН)
	               |			И (Списания.Ссылка.Дата <= &ДатаК)
	               |			И (Списания.Ссылка.Проведен = ИСТИНА)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК Реализация
	               |		ПО (Номен.Номенклатура = Списания.Номенклатура)
	               |			И (НЕ Номен.Характеристика ЕСТЬ NULL)
	               |			И (Номен.Характеристика = Списания.Характеристика)
	               |			И (Списания.Ссылка.Дата >= &ДатаН)
	               |			И (Списания.Ссылка.Дата <= &ДатаК)
	               |			И (Списания.Ссылка.Проведен = ИСТИНА)
	               |ИТОГИ
	               |	СУММА(Количество)
	               |ПО
	               |	Номенклатура,
	               |	Характеристика";
	
	выборкаНоменклатура = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока выборкаНоменклатура.Следующий() Цикл
				
		выборкаХарактеристика = выборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока выборкаХарактеристика.Следующий() Цикл
			Если ЗначениеЗаполнено(выборкаХарактеристика.Характеристика) Тогда
				среднемесячныйРасход = ?(количествоМесяцев = 0,0,выборкаХарактеристика.Количество / количествоМесяцев);
				Если алсав_ДопРеквизиты.ПолучитьДопРеквизит(выборкаХарактеристика.Характеристика, имяДопРеквизитаСреднемесячныйРасход) <> среднемесячныйРасход Тогда
					
					оХарактеристика = выборкаХарактеристика.Характеристика.ПолучитьОбъект();
					оХарактеристика.ОбменДанными.Загрузка = Истина;
					Попытка
						алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(оХарактеристика,имяДопРеквизитаСреднемесячныйРасход,среднемесячныйРасход);
						оХарактеристика.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли
			Иначе
				среднемесячныйРасход = ?(количествоМесяцев = 0,0,выборкаНоменклатура.Количество / количествоМесяцев);
		
				Если алсав_ДопРеквизиты.ПолучитьДопРеквизит(выборкаНоменклатура.Номенклатура, имяДопРеквизитаСреднемесячныйРасход) <> среднемесячныйРасход Тогда
					оНомен = выборкаНоменклатура.Номенклатура.ПолучитьОбъект(); 
					оНомен.ОбменДанными.Загрузка = Истина;
					Попытка
						алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(оНомен,имяДопРеквизитаСреднемесячныйРасход,среднемесячныйРасход);
						оНомен.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли; 
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецФункции


//Имеет вариант комплектации
Функция ОбновитьИмеетВариантКомплектации(номенклатура = неопределено) ЭКСПОРТ
	
	имяДопРеквизитаИмеетВариантКомплектации = "Имеет вариант комплектации";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросИмеетВариантКомплектации();
	Запрос.УстановитьПараметр("ЭтоМатериалы",ЛОЖЬ);
	Запрос.УстановитьПараметр("имяДопРеквизитаИмеетВариантКомплектации",имяДопРеквизитаИмеетВариантКомплектации);
	
	Если номенклатура <> неопределено Тогда
		Запрос.Текст = Запрос.Текст + " И Номенклатура.Ссылка = &номен";
		Запрос.УстановитьПараметр("номен",номенклатура);
	КонецЕсли;
	
	Рез = Запрос.Выполнить().Выбрать();
	Пока Рез.Следующий() Цикл
		Попытка
			Если алсав_ДопРеквизиты.ПолучитьДопРеквизит(Рез.Номенклатура, имяДопРеквизитаИмеетВариантКомплектации) <> рез.ИмеетВариантКомплектации Тогда
				оНоменклатура = Рез.Номенклатура.ПолучитьОбъект();
				алсав_ДопРеквизиты.УстановитьЗначениеДопРеквизита(оНоменклатура,имяДопРеквизитаИмеетВариантКомплектации,рез.ИмеетВариантКомплектации);
				оНоменклатура.ОбменДанными.Загрузка = Истина;
				оНоменклатура.Записать();
			КонецЕсли
		Исключение
		КонецПопытки;
	КонецЦикла
КонецФУнкции


