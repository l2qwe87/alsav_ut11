&НаСервере
Функция ВыполнитьПроверкуКорректностиДанных()
	Для Каждого Стр из Объект.Товары Цикл
		Стр.ОшибкаЕдИзм = (ЗначениеЗаполнено(Стр.Упаковка))И(Стр.Упаковка <> Стр.Номенклатура.ЕдиницаИзмерения);
		Если Стр.ОшибкаЕдИзм Тогда
			Сообщить("["+Стр.НомерСтроки+"] Есть несоотвествие ед.изм. со справочником номенклатуры");
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЕдИзм(наименование)
	Запрос = Новый Запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	               |ГДЕ
	               |	УпаковкиЕдиницыИзмерения.Наименование = &наименование
				   |	И УпаковкиЕдиницыИзмерения.Владелец = &Владелец
	               |	И НЕ УпаковкиЕдиницыИзмерения.ПометкаУдаления";
	Запрос.УстановитьПараметр("наименование",наименование);
	Запрос.УстановитьПараметр("Владелец",Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения);
	рез = Запрос.Выполнить().Выбрать();
	Если рез.Следующий() Тогда
		Возврат рез.ССылка;
	КонецЕсли;
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьНоменклатуруПоАртикулу(артикул)
	Возврат Справочники.Номенклатура.ПолучитьНоменклатуруПоАртикулу(артикул);
КонецФункции

&НаСервереБезКонтекста
Функция алсав_ЗагрузитьИзСметыВМассивСтруктур(Адрес, исходныйФайл)
	
	Возврат Справочники.ВариантыКомплектацииНоменклатуры.алсав_ЗагрузитьИзСметыВМассивСтруктур(Адрес, исходныйФайл);
	
КонецФункции


&НаСервере
Функция ДобавитьЛог(текст)
	ЭтаФорма.Лог = "["+ТекущаяДата()+"]"+текст+Символы.ПС+ЭтаФорма.Лог;
конецФункции

&НаСервере
Процедура алсав_ОбработкаПроверкиЗаполненияНаСервереПосле(Отказ, ПроверяемыеРеквизиты)
	// Вставить содержимое обработчика.
	ВыполнитьПроверкуКорректностиДанных();
	тест =Объект.Товары.НайтиСтроки(Новый Структура("ОшибкаЕдИзм",Истина));
	Если тест.Количество() > 0 Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
//&После("УстановитьУсловноеОформление")
Процедура алсав_УстановитьУсловноеОформление()
	ИмяПоляВводаЕдиницИзмерения = "ТоварыНоменклатураЕдиницаИзмерения";
	ПутьКПолюОтбора = "Объект.Товары.ОшибкаЕдИзм";
	ЭлементыФормы = ЭтаФорма.Элементы;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыФормы[ИмяПоляВводаЕдиницИзмерения].Имя);

	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ПравоеЗначение = истина;
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
КонецПроцедуры

