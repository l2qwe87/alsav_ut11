
&НаКлиенте
Процедура алсав_ФайлСметыНачалоВыбораПосле(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НастройкиДиалога = Новый Структура;
	НастройкиДиалога.Вставить("Заголовок", НСтр("ru=’Выберите файл сметы (Excel)'"));
	НастройкиДиалога.Вставить("Фильтр", НСтр("*.xls"));
	ОбменДаннымиКлиент.ОбработчикВыбораФайла(ЭтотОбъект, "ФайлСметы", СтандартнаяОбработка, НастройкиДиалога);    
КонецПроцедуры

&НаКлиенте
Процедура алсав_ФайлМоделиНачалоВыбораПосле(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	НастройкиДиалога = Новый Структура;
	НастройкиДиалога.Вставить("Заголовок", НСтр("ru=’Выберите файл модели)'"));
	ОбменДаннымиКлиент.ОбработчикВыбораФайла(ЭтотОбъект, "ФайлМодели", СтандартнаяОбработка, НастройкиДиалога);
КонецПроцедуры

&НаСервере
Процедура алсав_ПриЧтенииНаСервереПосле(ТекущийОбъект)
	// Вставить содержимое обработчика.
	Если ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		ЭтаФорма.ФайлСметы = алсав_ДопРеквизиты.ПолучитьДопСведение(ТекущийОбъект.Ссылка,"Файл сметы");
		ЭтаФорма.ФайлМодели = алсав_ДопРеквизиты.ПолучитьДопСведение(ТекущийОбъект.Ссылка,"Файл модели");
		ЭтаФорма.Описание = алсав_ДопРеквизиты.ПолучитьДопСведение(ТекущийОбъект.Ссылка,"Описание");
		
		ВыполнитьПроверкуКорректностиДанных();
	КонецЕсли;
	
	Элементы.Основной.ТолькоПросмотр = Объект.ЭтоМатериалы;
КонецПроцедуры

&НаСервере
Процедура алсав_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	// Вставить содержимое обработчика.
	алсав_ДопРеквизиты.УстановитьЗначениеДопСведения(ТекущийОбъект.Ссылка,"Файл сметы",ЭтаФорма.ФайлСметы);
	алсав_ДопРеквизиты.УстановитьЗначениеДопСведения(ТекущийОбъект.Ссылка,"Файл модели",ЭтаФорма.ФайлМодели);
	алсав_ДопРеквизиты.УстановитьЗначениеДопСведения(ТекущийОбъект.Ссылка,"Описание",ЭтаФорма.Описание);
	
	РегистрыСведений.алсав_ПроверкаВнешнихФайлов.ВыполнитьПроверки("ВариантыКомплектацииНоменклатуры", "Файл сметы", ЭтаФорма.Объект.Ссылка);
	РегистрыСведений.алсав_ПроверкаВнешнихФайлов.ВыполнитьПроверки("ВариантыКомплектацииНоменклатуры", "Файл модели", ЭтаФорма.Объект.Ссылка);
КонецПроцедуры

