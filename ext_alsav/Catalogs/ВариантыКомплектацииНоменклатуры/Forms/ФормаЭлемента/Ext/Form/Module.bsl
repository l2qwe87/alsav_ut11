&НаКлиенте
Процедура алсав_ЭтоМатериалыПриИзмененииПосле(Элемент)
	// Вставить содержимое обработчика.
	Элементы.Основной.ТолькоПросмотр = Объект.ЭтоМатериалы;
	Если Объект.ЭтоМатериалы Тогда
		Объект.Основной = ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура алсав_ТоварыВариантКомлектацииНачалоВыбораПосле(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	 
    Если ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.Номенклатура) Тогда

        СтандартнаяОбработка = ЛОЖЬ;
		ПараметрыФормыВыбора = Новый Структура("Отбор", Новый Структура("Владелец", Элементы.Товары.ТекущиеДанные.Номенклатура));
		ПараметрыФормыВыбора.Вставить("РежимВыбора",Истина);
		ОткрытьФОрму("Справочник.ВариантыКомплектацииНоменклатуры.ФормаВыбора", ПараметрыФормыВыбора, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли   
КонецПроцедуры
