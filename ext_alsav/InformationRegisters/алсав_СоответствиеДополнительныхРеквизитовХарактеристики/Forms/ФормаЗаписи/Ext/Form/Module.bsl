
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
	
	ЭтаФорма.ДополнительныйРеквизитДекор = алсав_ДопРеквизиты.НайтиДопРеквизит("Декор");
	ЭтаФорма.ДополнительныйРеквизитЦвет = алсав_ДопРеквизиты.НайтиДопРеквизит("Цвет");
