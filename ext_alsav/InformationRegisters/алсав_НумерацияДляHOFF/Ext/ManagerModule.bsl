Функция ПолучитьПотребностьДляНумерации(ПродуктНоменклатура, ПродуктХарактеристика) ЭКСПОРТ
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	0 КАК Х
	               |ПОМЕСТИТЬ Таб1
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	М.Х + 2 * С.Х КАК Х
	               |ПОМЕСТИТЬ Таб2
	               |ИЗ
	               |	Таб1 КАК М,
	               |	Таб1 КАК С
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	М.Х + 4 * С.Х КАК Х
	               |ПОМЕСТИТЬ Таб3
	               |ИЗ
	               |	Таб2 КАК М,
	               |	Таб2 КАК С
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	М.Х + 16 * С.Х КАК Х
	               |ПОМЕСТИТЬ Таб4
	               |ИЗ
	               |	Таб3 КАК М,
	               |	Таб3 КАК С
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	М.Х + 256 * С.Х КАК Х
	               |ПОМЕСТИТЬ РезТаб
	               |ИЗ
	               |	Таб4 КАК М,
	               |	Таб4 КАК С
	               |ГДЕ
	               |	М.Х + 256 * С.Х > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	алсав_СоставИзделий.ПродуктНоменклатура КАК ПродуктНоменклатура,
	               |	алсав_СоставИзделий.ПродуктХарактеристика КАК ПродуктХарактеристика,
	               |	алсав_СоставИзделий.Номенклатура КАК Номенклатура,
	               |	алсав_СоставИзделий.Характеристика КАК Характеристика,
	               |	алсав_СоставИзделий.ПутьВСборке КАК ПутьВСборке,
	               |	алсав_СоставИзделий.Количество КАК Количество,
	               |	Т.Количество КАК КоличествоВсего,
	               |	РезТаб.Х КАК Х
	               |ИЗ
	               |	РегистрСведений.алсав_СоставИзделий КАК алсав_СоставИзделий
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			алсав_СоставИзделий.ПродуктНоменклатура КАК ПродуктНоменклатура,
	               |			алсав_СоставИзделий.ПродуктХарактеристика КАК ПродуктХарактеристика,
	               |			СУММА(алсав_СоставИзделий.Количество) КАК Количество
	               |		ИЗ
	               |			РегистрСведений.алсав_СоставИзделий КАК алсав_СоставИзделий
	               |		ГДЕ
	               |			алсав_СоставИзделий.ЭтоМатериалы = ЛОЖЬ
	               |			И алсав_СоставИзделий.ЭтоПолуфабрикат = ЛОЖЬ
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			алсав_СоставИзделий.ПродуктНоменклатура,
	               |			алсав_СоставИзделий.ПродуктХарактеристика) КАК Т
	               |		ПО (Т.ПродуктНоменклатура = алсав_СоставИзделий.ПродуктНоменклатура)
	               |			И (Т.ПродуктХарактеристика = алсав_СоставИзделий.ПродуктХарактеристика)
	               |			И (Т.Количество >= алсав_СоставИзделий.Количество)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РезТаб КАК РезТаб
	               |		ПО (РезТаб.Х <= алсав_СоставИзделий.Количество)
	               |ГДЕ
	               |	алсав_СоставИзделий.ПродуктНоменклатура = &ПродуктНоменклатура
	               |	И алсав_СоставИзделий.ПродуктХарактеристика = &ПродуктХарактеристика
	               |	И алсав_СоставИзделий.ЭтоМатериалы = ЛОЖЬ
	               |	И алсав_СоставИзделий.ЭтоПолуфабрикат = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПутьВСборке,
	               |	РезТаб.Х";
	
	Запрос.УстановитьПараметр("ПродуктНоменклатура",ПродуктНоменклатура);
	Запрос.УстановитьПараметр("ПродуктХарактеристика",ПродуктХарактеристика); 
	
	резалт = Запрос.Выполнить().Выгрузить(); 
	
	// Создаём квалификаторы для строки: длина 10 символов
	КвалификаторыСтроки = Новый КвалификаторыСтроки(10);

	// Описываем тип данных: строка с заданными квалификаторами
	ОписаниеТипаСтрока10 = Новый ОписаниеТипов("Строка", , КвалификаторыСтроки);

	резалт.Колонки.Добавить("Позиция",ОписаниеТипаСтрока10);
	позиция = 0;
	Для Каждого стр из резалт Цикл  
		позиция = позиция + 1;
		стр.Позиция = ""+позиция + "/" + стр.КоличествоВсего
	КонецЦикла;	
	Возврат резалт;     
	
	//	Запрос.Текст = "ВЫБРАТЬ
