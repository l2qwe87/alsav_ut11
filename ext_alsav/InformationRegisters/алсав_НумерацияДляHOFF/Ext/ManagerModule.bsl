	//	               |	тчНумерация.ПродуктХарактеристика КАК ПродуктХарактеристика,
	//	               |	тчНумерация.Номенклатура КАК Номенклатура,
	//	               |	тчНумерация.Характеристика КАК Характеристика,
	//	               |	тчНумерация.ПутьВСборке КАК ПутьВСборке,
	//	               |	тчНумерация.Позиция КАК Позиция
	//	               |ПОМЕСТИТЬ ВнутренняяТаблицаАвтомобиле
	//	               |ИЗ
	//	               |	&тчНумерация КАК тчНумерация
	//	               |;
	//	               |
	//	               |////////////////////////////////////////////////////////////////////////////////
	//	               |ВЫБРАТЬ
	//	               |	т.ПутьВСборке КАК ПутьВСборке,
	//	               |	т.Позиция КАК Позиция
	//	               |ИЗ
	//	               |	тчНумерация КАК т
	//	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.алсав_НумерацияДляHOFF КАК ТХ
	//	               |		ПО т.ПродуктНоменклатура = ТХ.ПродуктНоменклатура
	//	               |			И т.ПродуктХарактеристика = ТХ.ПродуктХарактеристика
	//	               |			И т.Номенклатура = ТХ.Номенклатура
	//	               |			И т.Характеристика = ТХ.Характеристика
	//	               |			И т.ПутьВСборке = ТХ.ПутьВСборке
	//	               |			И т.Позиция = ТХ.Позиция_АЛСАВ
	//	               |ГДЕ
	//	               |	т.ПродуктНоменклатура = &ПродуктНоменклатура
	//	               |	И т.ПродуктХарактеристика = &ПродуктХарактеристика
	//	               |	И т.Номенклатура = &Номенклатура
	//	               |	И т.Характеристика = &Характеристика
	//	               |	И ТХ.ПутьВСборке ЕСТЬ NULL
	//	               |	И т.ЭтоМатериалы = ЛОЖЬ
	//	               |	И т.ЭтоПолуфабрикат = ЛОЖЬ
	//	               |
	//	               |УПОРЯДОЧИТЬ ПО
	//	               |	т.ПутьВСборке,
	//	               |	т.Позиция";
