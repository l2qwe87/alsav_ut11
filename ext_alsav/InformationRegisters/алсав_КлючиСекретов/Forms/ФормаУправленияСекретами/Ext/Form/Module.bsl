&НаКлиенте
Перем ЗначениеСекретаСкрыто;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеСекретаСкрыто = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначениеСекрета(Команда)
	
	Если ЗначениеСекретаСкрыто Тогда
		// Показываем значение секрета
		ТекущийКлюч = ЭтаФорма.ТекущийКлюч;
		Если ПустаяСтрока(ТекущийКлюч) Тогда
			ПоказатьПредупреждение(, "Сначала выберите секрет из списка");
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначениеСекретаНаСервере(ТекущийКлюч);
		ПоказатьОповещениеПользователя("Значение секрета", , "Значение секрета '" + ТекущийКлюч + "' загружено", БиблиотекаКартинок.Информация32);
	Иначе
		// Скрываем значение секрета
		ЗначениеСекрета = "******";
		ЗначениеСекретаСкрыто = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПоказатьЗначениеСекретаНаСервере(КлючСекрета) Экспорт
	
	ЗначениеСекрета = алсав_ВыгрузкаCsvJson.ПолучитьСекрет(КлючСекрета);
	ЗначениеСекретаСкрыто = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСекрет(Команда)
	
	ТекущийКлюч = ЭтаФорма.ТекущийКлюч;
	ТекущееЗначение = ЭтаФорма.ЗначениеСекрета;
	Используется = ЭтаФорма.Используется;
	
	Если ПустаяСтрока(ТекущийКлюч) Тогда
		ПоказатьПредупреждение(, "Необходимо указать ключ секрета!");
		Возврат;
	КонецЕсли;
	
	// Проверяем значение секрета на сервере
	ПроверитьЗначениеСекретаПередСохранением(ТекущееЗначение);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьСекретЗавершение", ЭтотОбъект);
	НачатьТранзакцию();
	СохранитьСекретНаСервере(ТекущийКлюч, ТекущееЗначение, Используется);
	ЗафиксироватьТранзакцию();
	ПоказатьОповещениеПользователя("Сохранение", , "Секрет '" + ТекущийКлюч + "' успешно сохранен!", БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьЗначениеСекретаПередСохранением(ТекущееЗначение) Экспорт
	
	// Если значение секрета не было показано, проверяем, что оно введено
	Если ЗначениеСекретаСкрыто И (ПустаяСтрока(ТекущееЗначение) Или ТекущееЗначение = "******") Тогда
		ВызватьИсключение "Необходимо указать значение секрета!";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСекретЗавершение(Результат, ДополнительныеПараметры) Экспорт
	// Обновляем список секретов после сохранения
	ЭтаФорма.ОбновитьСписок();
КонецПроцедуры

&НаСервере
Процедура СохранитьСекретНаСервере(Ключ, Значение, Используемый)
	
	алсав_ВыгрузкаCsvJson.СохранитьСекрет(Ключ, Значение, Используемый);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСекрет(Команда)
	
	ТекущийКлюч = ЭтаФорма.ТекущийКлюч;
	
	Если ПустаяСтрока(ТекущийКлюч) Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать секрет для удаления!");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Удалить секрет '" + ТекущийКлюч + "'?";
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьСекретПродолжение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСекретПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТекущийКлюч = ЭтаФорма.ТекущийКлюч;
		УдалитьСекретНаСервере(ТекущийКлюч);
		ПоказатьОповещениеПользователя("Удаление", , "Секрет '" + ТекущийКлюч + "' удален!", БиблиотекаКартинок.Информация32);
		
		// Очищаем поля формы
		ЭтаФорма.ТекущийКлюч = "";
		ЭтаФорма.ЗначениеСекрета = "";
		ЭтаФорма.Используется = Ложь;
		ЗначениеСекретаСкрыто = Истина;
		
		// Обновляем список
		ЭтаФорма.ОбновитьСписок();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСекретНаСервере(Ключ)
	
	алсав_ВыгрузкаCsvJson.УдалитьСекрет(Ключ);
	
КонецПроцедуры