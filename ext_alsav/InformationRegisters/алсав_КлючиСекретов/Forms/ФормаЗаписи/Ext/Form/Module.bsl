&НаКлиенте
Перем ЗначениеСекретаСкрыто;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеСекретаСкрыто = Истина;
	
	// Если открытие существующей записи, загружаем значение
	Если Не Запись.Пустая() Тогда
		ЗагрузитьЗначениеСекрета();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Устанавливаем начальное состояние поля значения секрета
	Если ЗначениеСекретаСкрыто Тогда
		ЗначениеСекрета = "******";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗначениеСекрета(Команда)
	
	Если ЗначениеСекретаСкрыто Тогда
		// Показываем значение секрета
		Попытка
			Если Не Запись.Пустая() И Не ПустаяСтрока(Запись.Ключ) Тогда
				ЗначениеСекрета = алсав_ВыгрузкаCsvJson.ПолучитьСекрет(Запись.Ключ);
				ЗначениеСекретаСкрыто = Ложь;
				ПоказатьОповещениеПользователя("Значение секрета", , "Значение секрета '" + Запись.Ключ + "' загружено", БиблиотекаКартинок.Информация32);
			Иначе
				ПоказатьПредупреждение(, "Сначала укажите ключ секрета");
			КонецЕсли;
		Исключение
			ПоказатьПредупреждение(, "Ошибка при получении секрета: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		// Скрываем значение секрета
		ЗначениеСекрета = "******";
		ЗначениеСекретаСкрыто = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Проверяем заполненность обязательных полей
	Если ПустаяСтрока(Запись.Ключ) Тогда
		ПоказатьПредупреждение(, "Необходимо указать ключ секрета!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Если значение секрета не было показано, проверяем, что оно введено
	Если ЗначениеСекретаСкрыто И (ПустаяСтрока(ЗначениеСекрета) Или ЗначениеСекрета = "******") Тогда
		ПоказатьПредупреждение(, "Необходимо указать значение секрета!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Устанавливаем значение в запись перед сохранением
	Если Не ЗначениеСекретаСкрыто Тогда
		Запись.Значение = ЗначениеСекрета;
	ИначеЕсли Не ПустаяСтрока(ЗначениеСекрета) И ЗначениеСекрета <> "******" Тогда
		Запись.Значение = ЗначениеСекрета;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПоказатьОповещениеПользователя("Сохранение", , "Секрет '" + Запись.Ключ + "' успешно сохранен!", БиблиотекаКартинок.Информация32);
	
	// После сохранения скрываем значение для безопасности
	ЗначениеСекрета = "******";
	ЗначениеСекретаСкрыто = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗначениеСекрета()
	
	Если Запись.Пустая() Или ПустаяСтрока(Запись.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗначениеСекрета = алсав_ВыгрузкаCsvJson.ПолучитьСекрет(Запись.Ключ);
	Исключение
		ЗначениеСекрета = "";
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючПриИзменении(Элемент)
	
	// При изменении ключа сбрасываем значение секрета
	ЗначениеСекрета = "******";
	ЗначениеСекретаСкрыто = Истина;
	
КонецПроцедуры